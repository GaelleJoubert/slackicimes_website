---
export type FactTileTone = "navy" | "sky" | "ice" | "coral" | "paper";

interface Props {
  value: string;
  label: string;
  tone: FactTileTone;
  class?: string;
}

const TONE_CLASSES: Record<FactTileTone, string> = {
  navy: "bg-slate text-snow",
  sky: "bg-lake text-slate",
  ice: "bg-moss text-slate",
  coral: "bg-coral text-slate",
  paper: "bg-snow text-slate",
};

const { value, label, tone, class: extraClasses } = Astro.props;
---

<div
  class:list={[
    "flex min-h-18 flex-col justify-between gap-1 rounded-2xl px-3 py-2.5 md:min-h-0 md:gap-1 md:rounded-card md:px-4.5 md:py-3",
    TONE_CLASSES[tone],
    extraClasses,
  ]}
>
  <dt class="order-last text-sm font-extrabold md:text-base">{label}</dt>
  <dd class="font-heading text-xl leading-tight md:text-2xl">{value}</dd>
</div>
