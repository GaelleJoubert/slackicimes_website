---
type TextFieldType = "text" | "email" | "multiline";

interface Props {
  name: string;
  label: string;
  type?: TextFieldType;
  required?: boolean;
  autocomplete?: string;
}

const MULTILINE_ROWS = 6;
const INPUT_CLASSES =
  "border-mist bg-white focus:border-teal focus:ring-teal mt-1 block w-full rounded-lg border px-3 py-2 focus:ring-2 focus:outline-none";

const {
  name,
  label,
  type = "text",
  required = false,
  autocomplete,
} = Astro.props;
const fieldId = `field-${name}`;
---

<div>
  <label for={fieldId} class="text-navy font-bold">
    {label}
    {required && <span aria-hidden="true">*</span>}
  </label>
  {type === "multiline" ? (
    <textarea
      id={fieldId}
      name={name}
      rows={MULTILINE_ROWS}
      required={required}
      class={INPUT_CLASSES}
    />
  ) : (
    <input
      id={fieldId}
      name={name}
      type={type}
      required={required}
      autocomplete={autocomplete}
      class={INPUT_CLASSES}
    />
  )}
</div>
