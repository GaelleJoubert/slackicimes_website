---
type TextFieldType = "text" | "email" | "multiline";

interface Props {
  name: string;
  label: string;
  type?: TextFieldType;
  required?: boolean;
  autocomplete?: string;
  maxLength: number;
}

const MULTILINE_ROWS = 6;
const INPUT_CLASSES =
  "border-stone bg-snow rounded-control border-thin block w-full px-3.5 font-normal md:px-4";
const SINGLE_LINE_CLASSES = "min-h-12 md:min-h-13";
const MULTILINE_CLASSES = "h-24 py-3 md:h-auto md:py-3.5";

const {
  name,
  label,
  type = "text",
  required = false,
  autocomplete,
  maxLength,
} = Astro.props;
const fieldId = `field-${name}`;
---

<div class="flex flex-col gap-1 md:gap-1.5">
  <label for={fieldId} class="text-slate font-semibold">
    {label}
    {required && <span aria-hidden="true">*</span>}
  </label>
  {type === "multiline" ? (
    <textarea
      id={fieldId}
      name={name}
      rows={MULTILINE_ROWS}
      required={required}
      maxlength={maxLength}
      class:list={[INPUT_CLASSES, MULTILINE_CLASSES]}
    />
  ) : (
    <input
      id={fieldId}
      name={name}
      type={type}
      required={required}
      autocomplete={autocomplete}
      maxlength={maxLength}
      class:list={[INPUT_CLASSES, SINGLE_LINE_CLASSES]}
    />
  )}
</div>
