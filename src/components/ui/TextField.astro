---
type TextFieldType = "text" | "email" | "multiline";

interface Props {
  name: string;
  label: string;
  type?: TextFieldType;
  required?: boolean;
  autocomplete?: string;
}

const MULTILINE_ROWS = 6;
const INPUT_CLASSES =
  "border-mist bg-paper focus:border-teal focus:ring-teal block w-full rounded-2xl border-3 px-3.5 font-normal focus:ring-2 focus:outline-none md:px-4";
const SINGLE_LINE_CLASSES = "min-h-12 md:min-h-13";
const MULTILINE_CLASSES = "py-3 md:py-3.5";

const {
  name,
  label,
  type = "text",
  required = false,
  autocomplete,
} = Astro.props;
const fieldId = `field-${name}`;
---

<div class="flex flex-col gap-1 md:gap-1.5">
  <label for={fieldId} class="text-navy font-extrabold">
    {label}
    {required && <span aria-hidden="true">*</span>}
  </label>
  {type === "multiline" ? (
    <textarea
      id={fieldId}
      name={name}
      rows={MULTILINE_ROWS}
      required={required}
      class:list={[INPUT_CLASSES, MULTILINE_CLASSES]}
    />
  ) : (
    <input
      id={fieldId}
      name={name}
      type={type}
      required={required}
      autocomplete={autocomplete}
      class:list={[INPUT_CLASSES, SINGLE_LINE_CLASSES]}
    />
  )}
</div>
