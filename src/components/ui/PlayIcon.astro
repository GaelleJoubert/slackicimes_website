---
type PlayIconSize = "small" | "large";

interface Props {
  size?: PlayIconSize;
  class?: string;
}

const SIZE_CLASSES: Record<PlayIconSize, string> = {
  small: "size-4.5",
  large: "size-8",
};

const { size = "small", class: extraClasses } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="currentColor"
  class:list={["shrink-0", SIZE_CLASSES[size], extraClasses]}
>
  <path d="M8 5v14l11-7z" />
</svg>
