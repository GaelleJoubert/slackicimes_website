---
import type { Locale } from "../../i18n/locales";
import { uiStrings } from "../../i18n/ui";
import {
  CONTACT_EMAIL,
  CONTACT_PEOPLE,
  POSTAL_ADDRESS_LINES,
} from "../../lib/site";

type ContactDetailsLayout = "row" | "stacked";

interface Props {
  locale: Locale;
  layout: ContactDetailsLayout;
}

const LAYOUT_CLASSES: Record<ContactDetailsLayout, string> = {
  row: "grid gap-8 sm:grid-cols-3",
  stacked: "space-y-6",
};

const { locale, layout } = Astro.props;
const strings = uiStrings(locale);
---

<div class={LAYOUT_CLASSES[layout]}>
  <div>
    <h3 class="subsection-title">{strings.contactBlock.phoneHeading}</h3>
    <ul class="mt-2 space-y-1">
      {CONTACT_PEOPLE.map((person) => (
        <li>
          {person.firstName}{" "}
          <a
            href={`tel:${person.internationalPhone}`}
            class="text-teal underline-offset-4 hover:underline"
          >
            {person.displayPhone}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div>
    <h3 class="subsection-title">{strings.contactBlock.emailHeading}</h3>
    <a
      href={`mailto:${CONTACT_EMAIL}`}
      class="text-teal mt-2 inline-block underline-offset-4 hover:underline"
    >
      {CONTACT_EMAIL}
    </a>
  </div>
  <div>
    <h3 class="subsection-title">{strings.contactBlock.addressHeading}</h3>
    <address class="mt-2 not-italic">
      {POSTAL_ADDRESS_LINES.map((line) => (
        <span class="block">{line}</span>
      ))}
    </address>
  </div>
</div>
