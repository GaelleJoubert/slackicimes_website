---
import { LOCALES, LOCALE_SETTINGS, type Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";

interface Props {
  locale: Locale;
  pageSlug: string;
}

const { locale, pageSlug } = Astro.props;
const strings = uiStrings(locale);
const otherLocales = LOCALES.filter((candidate) => candidate !== locale);
---

<nav aria-label={strings.languageSwitcher.label}>
  <ul class="flex gap-3">
    {otherLocales.map((targetLocale) => (
      <li>
        <a
          href={localizedPath(pageSlug, targetLocale)}
          hreflang={LOCALE_SETTINGS[targetLocale].htmlLang}
          lang={LOCALE_SETTINGS[targetLocale].htmlLang}
          class="text-teal text-sm font-bold underline-offset-4 hover:underline"
        >
          {LOCALE_SETTINGS[targetLocale].nativeName}
        </a>
      </li>
    ))}
  </ul>
</nav>
