---
import ToggleSign from "./ToggleSign.astro";

interface Props {
  summary: string;
  accessibleContext: string;
}

const { summary, accessibleContext } = Astro.props;
---

<details class="group">
  <summary class="text-teal hover:text-navy flex min-h-11 cursor-pointer items-center gap-3 font-extrabold">
    <ToggleSign />
    <span>
      {summary}
      <span class="sr-only">: {accessibleContext}</span>
    </span>
  </summary>
  <div class="mt-3 flex flex-col gap-5">
    <slot />
  </div>
</details>
