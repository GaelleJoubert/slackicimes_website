---
import Stat, { type StatTone } from "./Stat.astro";

interface KeyFact {
  value: string;
  label: string;
}

interface Props {
  facts: KeyFact[];
}

const FACT_TONE_CYCLE: StatTone[] = ["coral", "sky", "coral", "mist"];

const { facts } = Astro.props;
const toneAt = (factIndex: number): StatTone =>
  FACT_TONE_CYCLE[factIndex % FACT_TONE_CYCLE.length] ?? "coral";
---

<dl class="bg-navy text-paper rounded-card md:rounded-photo grid grid-cols-2 gap-x-3 gap-y-4.5 p-5.5 md:grid-cols-4 md:gap-6 md:px-10 md:py-8">
  {facts.map((fact, factIndex) => (
    <Stat value={fact.value} label={fact.label} tone={toneAt(factIndex)} />
  ))}
</dl>
