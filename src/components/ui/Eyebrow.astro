---
import LineGlyph from "./LineGlyph.astro";

export type EyebrowTone = "light" | "dark";

interface Props {
  tone?: EyebrowTone;
}

const TONE_CLASSES: Record<EyebrowTone, string> = {
  light: "text-forest",
  dark: "text-sage",
};

const { tone = "light" } = Astro.props;
---

<span
  class:list={[
    "eyebrow-text inline-flex items-center gap-3 self-start",
    TONE_CLASSES[tone],
  ]}
>
  <LineGlyph />
  <slot />
</span>
