---
export type EyebrowTone =
  "coral" | "coralOnDark" | "sky" | "mist" | "cloud" | "ice";

interface Props {
  tone: EyebrowTone;
}

const TONE_CLASSES: Record<EyebrowTone, string> = {
  coral: "text-coral-strong",
  coralOnDark: "text-coral",
  sky: "text-teal",
  mist: "text-navy",
  cloud: "text-navy",
  ice: "text-teal",
};

const { tone } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-2 self-start text-xs font-extrabold tracking-widest uppercase md:text-sm",
    TONE_CLASSES[tone],
  ]}
>
  <span
    aria-hidden="true"
    class="size-2 shrink-0 rounded-full bg-current"
  ></span>
  <slot />
</span>
