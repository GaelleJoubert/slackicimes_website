---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface GridPhoto {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  photos: GridPhoto[];
}

const PHOTO_WIDTHS = [300, 600];
const PHOTO_SIZES = "(min-width: 768px) 360px, 50vw";

const { photos } = Astro.props;
---

<ul class="grid grid-cols-2 gap-2 md:grid-cols-3 md:gap-3.5">
  {photos.map((photo) => (
    <li>
      <Picture
        src={photo.image}
        alt={photo.alt}
        widths={PHOTO_WIDTHS}
        sizes={PHOTO_SIZES}
        formats={["avif", "webp"]}
        class="md:rounded-card h-30 w-full rounded-2xl object-cover md:h-50"
      />
    </li>
  ))}
</ul>
