---
import PlayIcon from "./PlayIcon.astro";
import {
  actionBadgeClasses,
  type ActionBadgeSize,
  type ActionBadgeTone,
} from "./action-badge";

export type ActionBadgeIcon = "play" | "phone" | "external";

interface Props {
  icon: ActionBadgeIcon;
  size?: ActionBadgeSize;
  tone?: ActionBadgeTone;
  class?: string;
}

const STROKE_ICON_PATHS: Record<"phone" | "external", string> = {
  phone:
    "M5 3.5h3l1.5 4-2 1.3a9 9 0 0 0 3.7 3.7l1.3-2 4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A13.5 13.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5z",
  external: "M8 4h8v8M16 4L5 15",
};

const {
  icon,
  size = "default",
  tone = "coral",
  class: extraClasses,
} = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[actionBadgeClasses(size, tone), extraClasses]}
>
  {icon === "play" && <PlayIcon size={size === "large" ? "large" : "small"} />}
  {icon !== "play" && (
    <svg
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4.5 md:size-5"
    >
      <path d={STROKE_ICON_PATHS[icon]} />
    </svg>
  )}
</span>
