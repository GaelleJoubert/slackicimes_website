---
interface Props {
  items: string[];
  label: string;
}

const { items, label } = Astro.props;
---

<ul
  aria-label={label}
  class="text-graphite flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm"
>
  {items.map((item, itemIndex) => (
    <li class="flex items-center gap-2.5">
      {itemIndex > 0 && <span aria-hidden="true">·</span>}
      {item}
    </li>
  ))}
</ul>
