---
interface Props {
  items: string[];
  label: string;
}

const { items, label } = Astro.props;
---

<ul
  aria-label={label}
  class="text-navy flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm font-bold"
>
  {items.map((item, itemIndex) => (
    <li class="flex items-center gap-2.5">
      {itemIndex > 0 && (
        <span aria-hidden="true" class="bg-coral size-1.5 rounded-full"></span>
      )}
      {item}
    </li>
  ))}
</ul>
