---
interface Props {
  items: string[];
  label: string;
}

const { items, label } = Astro.props;
---

<ul aria-label={label} class="flex flex-wrap gap-1.5 md:gap-2">
  {items.map((item) => (
    <li class="bg-cloud text-navy rounded-full px-2.5 py-1 text-xs font-bold md:px-3 md:text-sm">
      {item}
    </li>
  ))}
</ul>
