---
interface Fact {
  value: string;
  label: string;
}

type FactsTone = "light" | "dark";
type FactsColumns = "two" | "three" | "threeFittedToValues";

interface Props {
  facts: Fact[];
  label: string;
  tone?: FactsTone;
  columns?: FactsColumns;
  class?: string;
}

const TONE_CLASSES: Record<FactsTone, { list: string; term: string }> = {
  light: { list: "border-slate", term: "text-graphite" },
  dark: { list: "border-snow/40", term: "text-sage" },
};

const COLUMN_CLASSES: Record<FactsColumns, { list: string; value: string }> = {
  two: { list: "grid grid-cols-2", value: "" },
  three: { list: "grid grid-cols-3", value: "" },
  threeFittedToValues: {
    list: "flex justify-between md:grid md:grid-cols-3",
    value: "whitespace-nowrap",
  },
};

const {
  facts,
  label,
  tone = "light",
  columns = "two",
  class: extraClasses,
} = Astro.props;
const toneClasses = TONE_CLASSES[tone];
const columnClasses = COLUMN_CLASSES[columns];
---

<dl
  aria-label={label}
  class:list={["border-y", columnClasses.list, toneClasses.list, extraClasses]}
>
  {facts.map((fact) => (
    <div class="flex flex-col justify-between gap-1.5 py-5 pr-4">
      <dt class:list={["label-text", toneClasses.term]}>{fact.label}</dt>
      <dd
        class:list={[
          "font-heading text-xl leading-none font-voice md:text-3xl",
          columnClasses.value,
        ]}
      >
        {fact.value}
      </dd>
    </div>
  ))}
</dl>
