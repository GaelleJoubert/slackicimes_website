---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { PRESSABLE_CARD_CLASSES } from "./card-styles";

interface Props {
  href: string;
  name: string;
  duration: string;
  price: string;
  image: ImageMetadata;
  imageFocusClass: string;
}

const PHOTO_WIDTHS = [400, 800];
const PHOTO_SIZES = "100vw";

const { href, name, duration, price, image, imageFocusClass } = Astro.props;
---

<a
  href={href}
  class:list={[
    "bg-paper rounded-card flex h-full flex-col overflow-hidden",
    PRESSABLE_CARD_CLASSES,
  ]}
>
  <Picture
    src={image}
    alt=""
    widths={PHOTO_WIDTHS}
    sizes={PHOTO_SIZES}
    formats={["avif", "webp"]}
    class:list={["h-36 w-full object-cover", imageFocusClass]}
  />
  <span class="flex flex-1 flex-col justify-between gap-2 px-3.5 pt-2.5 pb-3">
    <span class="card-title text-xl">{name}</span>
    <span class="flex items-baseline justify-between gap-2">
      <span class="text-slate text-sm">{duration}</span>
      <span class="font-heading text-coral-strong text-2xl leading-none">
        {price}
      </span>
    </span>
  </span>
</a>
