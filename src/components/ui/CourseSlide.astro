---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import ArrowSquare from "./ArrowSquare.astro";
import { CLICKABLE_CARD_CLASSES } from "./card-styles";

interface Props {
  href: string;
  name: string;
  duration: string;
  price: string;
  image: ImageMetadata;
  imageFocusClass: string;
}

const PHOTO_WIDTHS = [400, 800];
const PHOTO_SIZES = "100vw";

const { href, name, duration, price, image, imageFocusClass } = Astro.props;
---

<a
  href={href}
  class:list={[
    "bg-snow rounded-card flex h-full flex-col overflow-hidden",
    CLICKABLE_CARD_CLASSES,
  ]}
>
  <Picture
    src={image}
    alt=""
    widths={PHOTO_WIDTHS}
    sizes={PHOTO_SIZES}
    formats={["avif", "webp"]}
    class:list={["h-60 w-full object-cover", imageFocusClass]}
  />
  <span class="flex flex-1 items-end justify-between gap-3 p-4">
    <span class="flex flex-col gap-1">
      <span class="card-title text-xl">{name}</span>
      <span class="text-graphite text-sm">
        {duration} · <span class="text-slate font-semibold">{price}</span>
      </span>
    </span>
    <ArrowSquare />
  </span>
</a>
