---
import type { ImageMetadata } from "astro";
import FramedPicture from "./FramedPicture.astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  loading?: "eager" | "lazy";
}

const PHOTO_WIDTHS = [400, 800];
const PHOTO_SIZES = "304px";

const { image, alt, caption, loading = "lazy" } = Astro.props;
---

<figure class="flex flex-col gap-2">
  <FramedPicture
    image={image}
    alt={alt}
    widths={PHOTO_WIDTHS}
    sizes={PHOTO_SIZES}
    frame="bordered"
    loading={loading}
    class="h-56"
  />
  {caption && (
    <figcaption class="text-mist text-center text-sm font-bold">
      {caption}
    </figcaption>
  )}
</figure>
