---
interface Props {
  title: string;
  paragraphs: string[];
}

const { title, paragraphs } = Astro.props;
---

<div class="bg-navy text-paper rounded-card md:rounded-photo gap-stack p-card md:gap-block grid md:grid-cols-3 md:items-center">
  <div class="gap-stack flex flex-col md:col-span-2">
    <h2 class="timeline-title text-paper md:text-title-sm">{title}</h2>
    {paragraphs.map((paragraph) => (
      <p class="text-cloud">{paragraph}</p>
    ))}
  </div>
  <slot />
</div>
