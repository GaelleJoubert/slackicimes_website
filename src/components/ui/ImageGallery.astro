---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface GalleryImage {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
}

const GALLERY_IMAGE_WIDTHS = [400, 800];
const GALLERY_IMAGE_SIZES = "(min-width: 768px) 320px, 80vw";

const { images } = Astro.props;
---

<ul class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 md:mx-0 md:px-0">
  {images.map(({ image, alt, caption }) => (
    <li class="w-4/5 shrink-0 snap-start md:w-80">
      <figure>
        <Picture
          src={image}
          alt={alt}
          widths={GALLERY_IMAGE_WIDTHS}
          sizes={GALLERY_IMAGE_SIZES}
          formats={["avif", "webp"]}
          class="aspect-4/3 w-full rounded-lg object-cover"
        />
        {caption && <figcaption class="caption mt-2">{caption}</figcaption>}
      </figure>
    </li>
  ))}
</ul>
