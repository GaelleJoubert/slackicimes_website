---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  eyebrow?: string;
  meta?: string;
  href: string;
  linkLabel: string;
  headingLevel?: HeadingLevel;
}

type HeadingLevel = 2 | 3;

const HEADING_TAGS: Record<HeadingLevel, "h2" | "h3"> = { 2: "h2", 3: "h3" };

const CARD_IMAGE_WIDTHS = [480, 960];
const CARD_IMAGE_SIZES =
  "(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw";

const {
  image,
  imageAlt,
  title,
  eyebrow,
  meta,
  href,
  linkLabel,
  headingLevel = 3,
} = Astro.props;
const Heading = HEADING_TAGS[headingLevel];
---

<article class="bg-paper flex h-full flex-col overflow-hidden rounded-lg shadow-sm">
  <Picture
    src={image}
    alt={imageAlt}
    widths={CARD_IMAGE_WIDTHS}
    sizes={CARD_IMAGE_SIZES}
    formats={["avif", "webp"]}
    class="aspect-4/3 w-full object-cover"
  />
  <div class="flex flex-1 flex-col gap-2 p-5">
    {eyebrow && (
      <p class="text-teal text-sm font-bold tracking-wide uppercase">
        {eyebrow}
      </p>
    )}
    <Heading class="font-heading text-navy text-xl font-bold">{title}</Heading>
    {meta && <p class="caption">{meta}</p>}
    <div class="flex-1">
      <slot />
    </div>
    <a
      href={href}
      class="text-teal font-bold underline-offset-4 hover:underline"
    >
      {linkLabel}
      <span class="sr-only">: {title}</span>
    </a>
  </div>
</article>
