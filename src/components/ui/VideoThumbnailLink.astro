---
import type { ImageMetadata } from "astro";
import FramedPicture from "./FramedPicture.astro";
import ActionBadge from "./ActionBadge.astro";
import { PRESSABLE_CARD_CLASSES } from "./card-styles";

interface Props {
  href: string;
  thumbnail: ImageMetadata;
  label: string;
  class?: string;
}

const THUMBNAIL_WIDTHS = [400, 800];
const THUMBNAIL_SIZES = "100vw";

const { href, thumbnail, label, class: extraClasses } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class:list={[
    "rounded-card md:rounded-photo relative block shadow-ink",
    PRESSABLE_CARD_CLASSES,
    extraClasses,
  ]}
>
  <FramedPicture
    image={thumbnail}
    alt=""
    widths={THUMBNAIL_WIDTHS}
    sizes={THUMBNAIL_SIZES}
    frame="plain"
    class="aspect-video"
  />
  <ActionBadge icon="play" size="large" class="absolute inset-0 m-auto" />
  <span class="sr-only">{label}</span>
</a>
