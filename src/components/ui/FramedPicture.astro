---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  image: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: "eager" | "lazy";
  isEdgeToEdgeOnMobile?: boolean;
  class?: string;
}

const {
  image,
  alt,
  widths,
  sizes,
  loading = "lazy",
  isEdgeToEdgeOnMobile = false,
  class: sizeClasses,
} = Astro.props;
---

<Picture
  src={image}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={["avif", "webp"]}
  loading={loading}
  class:list={[
    "block w-full object-cover",
    isEdgeToEdgeOnMobile ? "md:rounded-card" : "rounded-card",
    sizeClasses,
  ]}
/>
