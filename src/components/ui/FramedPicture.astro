---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

export type PictureFrame =
  | "plain"
  | "bordered"
  | "offsetMist"
  | "offsetCoral"
  | "offsetSky"
  | "offsetNavy";

interface Props {
  image: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  frame?: PictureFrame;
  loading?: "eager" | "lazy";
  class?: string;
}

const FRAME_CLASSES: Record<PictureFrame, string> = {
  plain: "rounded-card md:rounded-photo",
  bordered: "rounded-card border-paper border-5 md:border-6",
  offsetMist:
    "rounded-card md:rounded-photo shadow-offset md:shadow-offset-lg shadow-mist",
  offsetCoral:
    "rounded-card md:rounded-photo shadow-offset md:shadow-offset-lg shadow-coral",
  offsetSky:
    "rounded-card md:rounded-photo shadow-offset md:shadow-offset-lg shadow-sky",
  offsetNavy:
    "rounded-card md:rounded-photo shadow-offset md:shadow-offset-lg shadow-navy",
};

const {
  image,
  alt,
  widths,
  sizes,
  frame = "plain",
  loading = "lazy",
  class: sizeClasses,
} = Astro.props;
---

<Picture
  src={image}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={["avif", "webp"]}
  loading={loading}
  class:list={["block w-full object-cover", FRAME_CLASSES[frame], sizeClasses]}
/>
