---
import type { HeaderTone } from "../sections/header-tone";

interface Props {
  href: string;
  isCurrentPage: boolean;
  tone: HeaderTone;
}

const TONE_CLASSES: Record<HeaderTone, { current: string; other: string }> = {
  light: {
    current: "bg-moss text-slate",
    other: "text-slate hover:text-forest",
  },
  dark: {
    current: "bg-lake text-slate",
    other: "text-snow hover:text-coral",
  },
};

const { href, isCurrentPage, tone } = Astro.props;
const toneClasses = TONE_CLASSES[tone];
---

<a
  href={href}
  aria-current={isCurrentPage ? "page" : undefined}
  class:list={[
    "block rounded-xl px-3.5 py-2.5 font-extrabold transition-colors",
    isCurrentPage ? toneClasses.current : toneClasses.other,
  ]}
>
  <slot />
</a>
