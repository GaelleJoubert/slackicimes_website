---
interface Props {
  href: string;
  isCurrentPage: boolean;
  class?: string;
}

const { href, isCurrentPage, class: extraClasses } = Astro.props;
---

<a
  href={href}
  aria-current={isCurrentPage ? "page" : undefined}
  class:list={[
    "font-heading hover:text-teal block py-2 font-bold",
    isCurrentPage ? "text-teal" : "text-navy",
    extraClasses,
  ]}
>
  <slot />
</a>
