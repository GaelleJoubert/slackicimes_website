---
export type StatTone = "coral" | "sky" | "mist" | "navy" | "coralStrong";

interface Props {
  value: string;
  label: string;
  tone: StatTone;
}

const VALUE_TONE_CLASSES: Record<StatTone, string> = {
  coral: "text-coral",
  sky: "text-sky",
  mist: "text-mist",
  navy: "text-navy",
  coralStrong: "text-coral-strong",
};

const { value, label, tone } = Astro.props;
---

<div class="flex flex-col gap-1">
  <dt class="order-last text-sm leading-snug font-bold md:text-base">
    {label}
  </dt>
  <dd class:list={["stat-value", VALUE_TONE_CLASSES[tone]]}>{value}</dd>
</div>
