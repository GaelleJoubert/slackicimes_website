---
interface Props {
  class?: string;
}

const { class: extraClasses } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[
    "rounded-control bg-slate text-snow group-hover:bg-coral flex size-11 shrink-0 items-center justify-center transition",
    extraClasses,
  ]}
>
  <svg
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    class="size-4.5"
  >
    <path d="M3 8h10M9 4l4 4-4 4"></path>
  </svg>
</span>
