---
interface Props {
  author: string;
  context: string;
}

const { author, context } = Astro.props;
---

<figure class="bg-paper border-sky rounded-lg border-l-4 p-6 shadow-sm">
  <blockquote class="rich-text italic">
    <slot />
  </blockquote>
  <figcaption class="caption mt-4">
    <span class="text-navy font-bold not-italic">{author}</span>, {context}
  </figcaption>
</figure>
