---
import { splitAfterSemicolons } from "../../lib/format";

interface Props {
  lines: string[];
}

const { lines } = Astro.props;
---

{lines.map((line) => (
  <span class="block">
    {splitAfterSemicolons(line).map((group, groupIndex) => (
      <>
        {groupIndex > 0 && " "}
        <span class="whitespace-nowrap">{group}</span>
      </>
    ))}
  </span>
))}
