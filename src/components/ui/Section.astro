---
import Container from "./Container.astro";

type SectionTone = "paper" | "mist";
type SectionSpacing = "default" | "flushBottom";

interface Props {
  id?: string;
  tone?: SectionTone;
  spacing?: SectionSpacing;
}

const TONE_CLASSES: Record<SectionTone, string> = {
  paper: "bg-paper",
  mist: "bg-mist/30",
};

const SPACING_CLASSES: Record<SectionSpacing, string> = {
  default: "py-10 md:py-16",
  flushBottom: "pt-10 md:pt-16",
};

const { id, tone = "paper", spacing = "default" } = Astro.props;
---

<section
  id={id}
  class:list={["scroll-mt-4", SPACING_CLASSES[spacing], TONE_CLASSES[tone]]}
>
  <Container>
    <slot />
  </Container>
</section>
