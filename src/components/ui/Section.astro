---
import Container from "./Container.astro";

type SectionTone = "paper" | "mist";

interface Props {
  id?: string;
  tone?: SectionTone;
}

const TONE_CLASSES: Record<SectionTone, string> = {
  paper: "bg-paper",
  mist: "bg-mist/30",
};

const { id, tone = "paper" } = Astro.props;
---

<section
  id={id}
  class:list={["scroll-mt-4 py-10 md:py-16", TONE_CLASSES[tone]]}
>
  <Container>
    <slot />
  </Container>
</section>
