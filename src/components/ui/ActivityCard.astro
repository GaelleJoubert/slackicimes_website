---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import ArrowSquare from "./ArrowSquare.astro";
import { CLICKABLE_CARD_CLASSES } from "./card-styles";

interface Props {
  title: string;
  text: string;
  image: ImageMetadata;
  imageAlt: string;
  href?: string;
}

const IMAGE_WIDTHS = [320, 640];
const IMAGE_SIZES = "(min-width: 768px) 400px, 50vw";

const { title, text, image, imageAlt, href } = Astro.props;
const CardTag = href ? "a" : "div";
---

<CardTag
  href={href}
  class:list={[
    "bg-moss rounded-card text-slate relative flex h-full flex-col overflow-hidden",
    href && CLICKABLE_CARD_CLASSES,
  ]}
>
  <Picture
    src={image}
    alt={imageAlt}
    widths={IMAGE_WIDTHS}
    sizes={IMAGE_SIZES}
    formats={["avif", "webp"]}
    class="h-22 w-full object-cover md:h-60"
  />
  <div class="flex flex-1 flex-col gap-2 p-3 md:gap-3 md:p-6">
    <h3 class="card-title decoration-coral underline-offset-5 group-hover:underline">
      {title}
    </h3>
    <p class="text-graphite hidden flex-1 md:block md:text-base">{text}</p>
    {href && <ArrowSquare class="hidden self-end md:flex" />}
  </div>
</CardTag>
