---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

export type ActivityCardTone = "cloud" | "ice" | "blush";

interface Props {
  title: string;
  text: string;
  image: ImageMetadata;
  imageAlt: string;
  tone: ActivityCardTone;
  href?: string;
}

const IMAGE_WIDTHS = [320, 640];
const IMAGE_SIZES = "(min-width: 768px) 400px, 50vw";

const TONE_CLASSES: Record<ActivityCardTone, string> = {
  cloud: "bg-cloud",
  ice: "bg-ice",
  blush: "bg-blush",
};

const { title, text, image, imageAlt, tone, href } = Astro.props;
const CardTag = href ? "a" : "div";
---

<CardTag
  href={href}
  class:list={[
    "rounded-card text-ink flex h-full flex-col overflow-hidden md:rounded-3xl",
    href && "transition md:hover:-translate-y-1",
    TONE_CLASSES[tone],
  ]}
>
  <Picture
    src={image}
    alt={imageAlt}
    widths={IMAGE_WIDTHS}
    sizes={IMAGE_SIZES}
    formats={["avif", "webp"]}
    class="h-22 w-full object-cover md:h-55"
  />
  <div class="flex flex-col gap-1 p-3 pb-3.5 md:gap-1.5 md:px-5.5 md:pt-5 md:pb-6">
    <h3 class="card-title text-lg md:text-3xl">{title}</h3>
    <p class="hidden md:block md:text-base">{text}</p>
  </div>
</CardTag>
