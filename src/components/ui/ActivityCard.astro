---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import ArrowSquare from "./ArrowSquare.astro";
import { CLICKABLE_CARD_CLASSES } from "./card-styles";

interface Props {
  title: string;
  text: string;
  image: ImageMetadata;
  imageAlt: string;
  href?: string;
}

const IMAGE_WIDTHS = [240, 480, 800];
const IMAGE_SIZES = "(min-width: 768px) 400px, 96px";

const { title, text, image, imageAlt, href } = Astro.props;
const isClickable = Boolean(href);
const CardTag = isClickable ? "a" : "div";
---

<CardTag
  href={href}
  class:list={[
    "bg-moss rounded-card text-slate flex h-full items-center overflow-hidden md:flex-col md:items-stretch",
    isClickable && CLICKABLE_CARD_CLASSES,
  ]}
>
  <div class="w-24 shrink-0 self-stretch md:h-60 md:w-full">
    <Picture
      src={image}
      alt={imageAlt}
      widths={IMAGE_WIDTHS}
      sizes={IMAGE_SIZES}
      formats={["avif", "webp"]}
      class="size-full object-cover"
    />
  </div>
  <div class="flex flex-1 items-center gap-3 p-4 md:flex-col md:items-stretch md:p-6">
    <div class="flex flex-1 flex-col gap-1.5 md:gap-3">
      <h3 class="card-title decoration-coral text-xl underline-offset-5 group-hover:underline md:text-card">
        {title}
      </h3>
      <p
        class:list={[
          "text-graphite text-sm md:block md:text-base",
          isClickable && "hidden",
        ]}
      >
        {text}
      </p>
    </div>
    {isClickable && <ArrowSquare class="md:self-end" />}
  </div>
</CardTag>
