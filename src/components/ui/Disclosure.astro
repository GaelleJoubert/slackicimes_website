---
import ToggleSign from "./ToggleSign.astro";

interface Props {
  summary: string;
  groupName?: string;
  isOpen?: boolean;
}

const { summary, groupName, isOpen = false } = Astro.props;
---

<details
  data-animated-details
  name={groupName}
  open={isOpen}
  class="group border-rule border-b"
>
  <summary class="font-heading text-slate flex min-h-16 cursor-pointer items-center justify-between gap-4 py-4 text-lg leading-snug font-voice md:min-h-18 md:text-2xl">
    <h3>{summary}</h3>
    <ToggleSign />
  </summary>
  <div data-expand-panel>
    <div class="rich-text pr-12 pb-6 text-base md:pr-14">
      <slot />
    </div>
  </div>
</details>

<script>
  import { enhanceAnimatedDetails } from "./expand-animation";

  enhanceAnimatedDetails();
</script>
