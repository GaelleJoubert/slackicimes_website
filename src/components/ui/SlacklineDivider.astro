---
type DividerTone = "paper" | "navy" | "blush" | "cloud";

interface Props {
  backgroundTone?: DividerTone;
  fillTone?: DividerTone;
  hasAnchors?: boolean;
}

const BACKGROUND_CLASSES: Record<DividerTone, string> = {
  paper: "bg-paper",
  navy: "bg-navy",
  blush: "bg-blush",
  cloud: "bg-cloud",
};

const FILL_CLASSES: Record<DividerTone, string> = {
  paper: "fill-paper",
  navy: "fill-navy",
  blush: "fill-blush",
  cloud: "fill-cloud",
};

const ANCHOR_CLASSES =
  "bg-navy absolute top-0 size-3 rounded-full md:top-1 md:size-4";

const { backgroundTone = "paper", fillTone, hasAnchors = false } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={["relative h-10 md:h-16", BACKGROUND_CLASSES[backgroundTone]]}
>
  <svg
    viewBox="0 0 100 10"
    preserveAspectRatio="none"
    class="absolute inset-0 size-full"
  >
    {fillTone && (
      <path
        d="M0 0 Q 50 20 100 0 L100 10 L0 10 Z"
        class={FILL_CLASSES[fillTone]}
      />
    )}
    <path
      d="M0 1.7 Q 50 11 100 1.7"
      fill="none"
      vector-effect="non-scaling-stroke"
      class="stroke-coral stroke-4 md:stroke-5"
      stroke-linecap="round"
    />
  </svg>
  {hasAnchors && (
    <>
      <span class:list={[ANCHOR_CLASSES, "left-0"]} />
      <span class:list={[ANCHOR_CLASSES, "right-0"]} />
    </>
  )}
</div>
