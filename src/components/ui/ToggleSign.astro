---
type ToggleSignVariant = "details" | "courseTab";

interface Props {
  variant?: ToggleSignVariant;
  class?: string;
}

interface VariantClasses {
  circle: string;
  plus: string;
  minus: string;
  selectedCheck?: string;
}

const VARIANT_CLASSES: Record<ToggleSignVariant, VariantClasses> = {
  details: {
    circle: "",
    plus: "group-open:hidden",
    minus: "hidden group-open:inline",
  },
  courseTab: {
    circle: "md:group-aria-expanded:bg-navy md:group-aria-expanded:text-paper",
    plus: "group-aria-expanded:hidden",
    minus: "hidden group-aria-expanded:inline md:group-aria-expanded:hidden",
    selectedCheck: "hidden size-4 md:group-aria-expanded:block",
  },
};

const { variant = "details", class: extraClasses } = Astro.props;
const variantClasses = VARIANT_CLASSES[variant];
---

<span
  aria-hidden="true"
  class:list={[
    "bg-coral text-ink font-heading shadow-pressable flex size-8 shrink-0 items-center justify-center rounded-full text-xl transition group-hover:translate-x-0.5 group-hover:translate-y-0.5 group-hover:shadow-none md:size-9",
    variantClasses.circle,
    extraClasses,
  ]}
>
  <span class={variantClasses.plus}>+</span>
  <span class={variantClasses.minus}>–</span>
  {variantClasses.selectedCheck && (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={variantClasses.selectedCheck}
    >
      <path d="M5 12.5l4.5 4.5L19 7.5" />
    </svg>
  )}
</span>
