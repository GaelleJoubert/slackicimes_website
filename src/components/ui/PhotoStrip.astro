---
import type { ImageMetadata } from "astro";
import FramedPicture from "./FramedPicture.astro";

interface StripPhoto {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  photos: StripPhoto[];
  loading?: "eager" | "lazy";
}

const PHOTO_WIDTHS = [400, 800];
const PHOTO_SIZES = "400px";

const { photos, loading = "lazy" } = Astro.props;
---

<ul class="grid grid-cols-3 gap-6">
  {photos.map((photo) => (
    <li>
      <FramedPicture
        image={photo.image}
        alt={photo.alt}
        widths={PHOTO_WIDTHS}
        sizes={PHOTO_SIZES}
        frame="bordered"
        loading={loading}
        class="h-75"
      />
    </li>
  ))}
</ul>
