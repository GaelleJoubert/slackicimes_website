---
import { Picture } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import { entrySlug } from "../../../i18n/content";
import type { Locale } from "../../../i18n/locales";
import { uiStrings } from "../../../i18n/ui";
import DotList from "../../ui/DotList.astro";
import ReadMore from "../../ui/ReadMore.astro";
import TagList from "../../ui/TagList.astro";

export type TeamCardShadow = "coral" | "sky" | "mist";

interface Props {
  member: CollectionEntry<"team">;
  shadow: TeamCardShadow;
  locale: Locale;
}

const PHOTO_WIDTHS = [600, 1200];
const PHOTO_SIZES = "(min-width: 768px) 560px, 100vw";

const PHOTO_FOCUS_CLASSES: Record<
  CollectionEntry<"team">["data"]["photoFocus"],
  string
> = {
  center: "object-center",
  top: "object-top",
};

const SHADOW_CLASSES: Record<TeamCardShadow, string> = {
  coral: "shadow-coral",
  sky: "shadow-sky",
  mist: "shadow-mist",
};

const { member, shadow, locale } = Astro.props;
const strings = uiStrings(locale).team;
const {
  name,
  role,
  photo,
  photoAlt,
  photoFocus,
  highlineSince,
  diplomaShortNames,
  excerpt,
  facts,
} = member.data;
const { Content: Biography } = await render(member);
---

<article
  id={entrySlug(member.id)}
  class:list={[
    "border-navy rounded-card shadow-offset-sm md:rounded-photo md:shadow-offset row-span-4 grid scroll-mt-4 grid-rows-subgrid gap-0 overflow-hidden border-3",
    SHADOW_CLASSES[shadow],
  ]}
>
  <Picture
    src={photo}
    alt={photoAlt}
    widths={PHOTO_WIDTHS}
    sizes={PHOTO_SIZES}
    formats={["avif", "webp"]}
    class:list={[
      "h-52 w-full object-cover md:h-72",
      PHOTO_FOCUS_CLASSES[photoFocus],
    ]}
  />
  <header class="flex flex-col gap-1 px-5 pt-5 md:px-7 md:pt-6">
    <div class="flex items-end justify-between gap-4">
      <h3 class="card-title text-3xl md:text-4xl">{name}</h3>
      <p class="flex flex-col items-end">
        <span class="caption">{strings.highlineSince}</span>
        <span class="card-title text-teal">{highlineSince}</span>
      </p>
    </div>
    <p class="caption font-bold">{role}</p>
  </header>
  <blockquote class="mx-5 mt-4 text-sm md:mx-7 md:text-base">
    {excerpt}
  </blockquote>
  <footer class="mx-5 mt-3 flex flex-col gap-3 pb-4 md:mx-7 md:pb-5">
    <ReadMore summary={strings.readFullStory} accessibleContext={name}>
      <div class="rich-text text-sm md:text-base">
        <Biography />
      </div>
      <dl class="flex flex-col gap-4">
        {facts.map((fact) => (
          <div class="flex flex-col gap-1.5">
            <dt class="subsection-title">{fact.label}</dt>
            <dd>
              <DotList items={fact.items} class="text-sm md:text-base" />
            </dd>
          </div>
        ))}
      </dl>
    </ReadMore>
    <div class="border-cloud border-t-2 pt-3">
      <TagList items={diplomaShortNames} label={strings.diplomasLabel} />
    </div>
  </footer>
</article>
