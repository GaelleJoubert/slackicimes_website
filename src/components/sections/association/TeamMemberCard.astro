---
import { Picture } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import { entrySlug } from "../../../i18n/content";
import type { Locale } from "../../../i18n/locales";
import { uiStrings } from "../../../i18n/ui";
import DotList from "../../ui/DotList.astro";
import ReadMore from "../../ui/ReadMore.astro";
import TagList from "../../ui/TagList.astro";

export type TeamCardShadow = "coral" | "sky" | "mist";

interface Props {
  member: CollectionEntry<"team">;
  shadow: TeamCardShadow;
  locale: Locale;
}

const PHOTO_WIDTHS = [320, 600, 1200];
const PHOTO_SIZES = "(min-width: 768px) 560px, 160px";

const PHOTO_FOCUS_CLASSES: Record<
  CollectionEntry<"team">["data"]["photoFocus"],
  string
> = {
  center: "object-center",
  top: "object-top",
};

const SHADOW_CLASSES: Record<TeamCardShadow, string> = {
  coral: "shadow-coral",
  sky: "shadow-sky",
  mist: "shadow-mist",
};

const { member, shadow, locale } = Astro.props;
const strings = uiStrings(locale).team;
const {
  name,
  role,
  photo,
  photoAlt,
  photoFocus,
  highlineSince,
  diplomaShortNames,
  excerpt,
  facts,
} = member.data;
const { Content: Biography } = await render(member);
---

<article
  id={entrySlug(member.id)}
  class:list={[
    "border-navy rounded-card md:rounded-photo shadow-raised media-start-grid row-span-4 grid h-full scroll-mt-4 grid-rows-subgrid content-start gap-0 md:content-normal overflow-hidden border-3 md:h-auto md:grid-cols-1",
    SHADOW_CLASSES[shadow],
  ]}
>
  <Picture
    src={photo}
    alt={photoAlt}
    widths={PHOTO_WIDTHS}
    sizes={PHOTO_SIZES}
    formats={["avif", "webp"]}
    class:list={[
      "mt-4 ml-4 block size-40 rounded-2xl object-cover md:m-0 md:h-72 md:w-full md:rounded-none",
      PHOTO_FOCUS_CLASSES[photoFocus],
    ]}
  />
  <header class="flex flex-col gap-1.5 px-4 pt-4 md:grid md:gap-1 md:grid-cols-2 md:items-end md:gap-x-4 md:px-7 md:pt-6 md:pb-0">
    <h3 class="card-title text-3xl md:text-4xl">{name}</h3>
    <p class="caption font-bold md:order-last md:col-span-2">{role}</p>
    <p class="hidden md:flex md:flex-col md:items-end md:justify-self-end">
      <span class="caption">{strings.highlineSince}</span>
      <span class="card-title text-teal">{highlineSince}</span>
    </p>
  </header>
  <blockquote class="col-span-2 mx-4 mt-4 text-sm md:col-span-1 md:mx-7 md:mt-4 md:text-base">
    {excerpt}
  </blockquote>
  <footer class="col-span-2 mx-4 mt-2 flex flex-col gap-2 pb-3 md:col-span-1 md:mx-7 md:mt-3 md:gap-3 md:pb-5">
    <ReadMore summary={strings.readFullStory} accessibleContext={name}>
      <div class="rich-text text-sm md:text-base">
        <Biography />
      </div>
      <dl class="flex flex-col gap-4">
        {facts.map((fact) => (
          <div class="flex flex-col gap-1.5">
            <dt class="subsection-title">{fact.label}</dt>
            <dd>
              <DotList items={fact.items} class="text-sm md:text-base" />
            </dd>
          </div>
        ))}
      </dl>
    </ReadMore>
    <div class="border-cloud border-t-2 pt-2 md:pt-3">
      <TagList items={diplomaShortNames} label={strings.diplomasLabel} />
    </div>
  </footer>
</article>
