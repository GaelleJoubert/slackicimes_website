---
import type { CollectionEntry } from "astro:content";
import Container from "../../ui/Container.astro";

interface Props {
  firstStages: CollectionEntry<"association">["data"]["firstStages"];
}

const { firstStages } = Astro.props;
const [leadParagraph, ...followingParagraphs] = firstStages.paragraphs;
---

<section class="pt-10 md:pt-18">
  <Container>
    <div class="bg-coral text-ink rounded-card shadow-drop md:rounded-photo md:shadow-drop-lg grid gap-2.5 p-5.5 md:grid-cols-3 md:items-center md:gap-10 md:px-14 md:py-12">
      <h2 class="section-title text-ink md:text-title-sm">
        {firstStages.title}
      </h2>
      <div class="flex flex-col gap-2.5 md:col-span-2 md:gap-3">
        <p class="font-bold">{leadParagraph}</p>
        {followingParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </Container>
</section>
