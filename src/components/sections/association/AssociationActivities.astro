---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../../i18n/locales";
import { localizedPath } from "../../../i18n/routes";
import ActivityCard, {
  type ActivityCardTone,
} from "../../ui/ActivityCard.astro";
import Container from "../../ui/Container.astro";
import SectionIntro from "../../ui/SectionIntro.astro";

interface Props {
  activities: CollectionEntry<"association">["data"]["activities"];
  locale: Locale;
}

const CARD_TONES: ActivityCardTone[] = ["cloud", "ice", "blush"];

const { activities, locale } = Astro.props;
---

<section class="py-section">
  <Container class="flex flex-col gap-block">
    <div class="max-w-190">
      <SectionIntro title={activities.title}>
        <p class="text-slate">{activities.intro}</p>
      </SectionIntro>
    </div>
    <ul class="gap-grid grid grid-cols-2 md:grid-cols-3">
      {activities.items.map((activity, activityIndex) => (
        <li>
          <ActivityCard
            title={activity.title}
            text={activity.text}
            image={activity.illustration.image}
            imageAlt={activity.illustration.alt}
            tone={CARD_TONES[activityIndex % CARD_TONES.length]}
            href={activity.pageSlug && localizedPath(activity.pageSlug, locale)}
          />
        </li>
      ))}
    </ul>
  </Container>
</section>
