---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../../i18n/locales";
import { localizedPath } from "../../../i18n/routes";
import ActivityCard from "../../ui/ActivityCard.astro";
import Container from "../../ui/Container.astro";
import SectionIntro from "../../ui/SectionIntro.astro";

interface Props {
  activities: CollectionEntry<"association">["data"]["activities"];
  locale: Locale;
}

type Activity = Props["activities"]["items"][number];

const { activities, locale } = Astro.props;

const activityHref = (activity: Activity) =>
  activity.externalUrl ??
  (activity.pageSlug && localizedPath(activity.pageSlug, locale));
---

<section class="py-section">
  <Container class="flex flex-col gap-block">
    <div class="max-w-190">
      <SectionIntro title={activities.title}>
        <p class="text-graphite">{activities.intro}</p>
      </SectionIntro>
    </div>
    <ul class="gap-grid grid md:grid-cols-3">
      {activities.items.map((activity) => (
        <li>
          <ActivityCard
            title={activity.title}
            text={activity.text}
            image={activity.illustration.image}
            imageAlt={activity.illustration.alt}
            href={activityHref(activity)}
            isExternal={Boolean(activity.externalUrl)}
          />
        </li>
      ))}
    </ul>
  </Container>
</section>
