---
import type { CollectionEntry } from "astro:content";
import Container from "../../ui/Container.astro";
import FramedPicture from "../../ui/FramedPicture.astro";
import SlacklineDivider from "../../ui/SlacklineDivider.astro";

interface Props {
  heading: string;
  origin: CollectionEntry<"association">["data"]["origin"];
}

const PHOTO_WIDTHS = [600, 1200];
const PHOTO_SIZES = "(min-width: 768px) 600px, 100vw";

const { heading, origin } = Astro.props;
const [leadParagraph, ...closingParagraphs] = origin.paragraphs;
---

<section class="bg-slate text-snow pt-page-top pb-section">
  <Container class="split-centered-grid gap-stack md:gap-x-block grid md:grid-cols-2">
    <h1 class="page-title text-snow md:row-start-2">{heading}</h1>
    <div class="pr-2 pb-2 md:col-start-2 md:row-span-4 md:row-start-1 md:p-0">
      <FramedPicture
        image={origin.illustration.image}
        alt={origin.illustration.alt}
        widths={PHOTO_WIDTHS}
        sizes={PHOTO_SIZES}
        loading="eager"
        class="h-57.5 md:h-115"
      />
    </div>
    <div class="gap-stack flex flex-col md:row-start-3">
      <p class="text-moss">{leadParagraph}</p>
      {closingParagraphs.map((paragraph) => (
        <p class="text-snow font-bold">{paragraph}</p>
      ))}
    </div>
  </Container>
</section>

<SlacklineDivider backgroundTone="navy" fillTone="paper" />
