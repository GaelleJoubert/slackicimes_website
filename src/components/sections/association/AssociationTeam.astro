---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../../i18n/locales";
import Container from "../../ui/Container.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import TeamMemberCard, { type TeamCardShadow } from "./TeamMemberCard.astro";

interface Props {
  team: CollectionEntry<"association">["data"]["team"];
  members: CollectionEntry<"team">[];
  locale: Locale;
}

const CARD_SHADOWS: TeamCardShadow[] = ["coral", "sky", "mist"];

const { team, members, locale } = Astro.props;
---

<section class="py-14 md:pt-26 md:pb-28">
  <Container class="flex flex-col gap-4 md:gap-9">
    <div class="max-w-190">
      <SectionIntro title={team.title}>
        {team.paragraphs.map((paragraph) => (
          <p class="text-slate">{paragraph}</p>
        ))}
      </SectionIntro>
    </div>
    <ul class="grid gap-5 md:grid-cols-2 md:gap-6">
      {members.map((member, memberIndex) => (
        <li class="row-span-4 grid grid-rows-subgrid gap-0">
          <TeamMemberCard
            member={member}
            shadow={CARD_SHADOWS[memberIndex % CARD_SHADOWS.length]}
            locale={locale}
          />
        </li>
      ))}
    </ul>
  </Container>
</section>
