---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../../i18n/locales";
import { uiStrings } from "../../../i18n/ui";
import Carousel from "../../ui/Carousel.astro";
import CarouselSlide from "../../ui/CarouselSlide.astro";
import Container from "../../ui/Container.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import TeamMemberCard, { type TeamCardShadow } from "./TeamMemberCard.astro";

interface Props {
  team: CollectionEntry<"association">["data"]["team"];
  members: CollectionEntry<"team">[];
  locale: Locale;
}

const CARD_SHADOWS: TeamCardShadow[] = ["coral", "sky", "mist"];

const { team, members, locale } = Astro.props;
const strings = uiStrings(locale);
---

<section class="pt-8 pb-6 md:pt-26 md:pb-28">
  <Container class="flex flex-col gap-3 md:gap-9">
    <div class="max-w-190">
      <SectionIntro title={team.title}>
        {team.paragraphs.map((paragraph) => (
          <p class="text-slate">{paragraph}</p>
        ))}
      </SectionIntro>
    </div>
    <Carousel
      label={team.title}
      roleDescription={strings.common.carouselRoleDescription}
      previousLabel={strings.team.previousMemberButton}
      nextLabel={strings.team.nextMemberButton}
      slideCount={members.length}
      width="full"
      desktopGrid
    >
      {members.map((member, memberIndex) => (
        <CarouselSlide class="pr-1.5 pb-1.5 md:row-span-4 md:grid md:grid-rows-subgrid md:gap-0 md:p-0">
          <TeamMemberCard
            member={member}
            shadow={CARD_SHADOWS[memberIndex % CARD_SHADOWS.length]}
            locale={locale}
          />
        </CarouselSlide>
      ))}
    </Carousel>
  </Container>
</section>
