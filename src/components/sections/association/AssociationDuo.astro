---
import type { CollectionEntry } from "astro:content";
import { entrySlug } from "../../../i18n/content";
import type { Locale } from "../../../i18n/locales";
import { uiStrings } from "../../../i18n/ui";
import Container from "../../ui/Container.astro";
import FramedPicture from "../../ui/FramedPicture.astro";
import SectionIntro from "../../ui/SectionIntro.astro";

interface Props {
  duo: CollectionEntry<"association">["data"]["duo"];
  members: CollectionEntry<"team">[];
  locale: Locale;
}

const PORTRAIT_WIDTHS = [300, 600];
const PORTRAIT_SIZES = "(min-width: 768px) 300px, 50vw";

const { duo, members, locale } = Astro.props;
const strings = uiStrings(locale).team;

function portraitOf(member: CollectionEntry<"team">) {
  const { portrait, portraitAlt, name } = member.data;
  if (!portrait || !portraitAlt) {
    throw new Error(
      `Team member "${member.id}" belongs to the duo: add "portrait" and "portraitAlt" for ${name}.`,
    );
  }
  return { image: portrait, alt: portraitAlt };
}
---

<section class="bg-navy text-paper py-10 md:py-26">
  <Container class="grid gap-6 md:grid-cols-2 md:items-center md:gap-16">
    <SectionIntro title={duo.title} theme="dark">
      <div class="intro-text intro-text-on-dark">
        {duo.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <p class="card-title text-coral border-coral hidden border-l-4 pl-4 md:block md:text-3xl">
        {duo.tagline}
      </p>
    </SectionIntro>
    <ul class="grid grid-cols-2 gap-3 md:gap-5">
      {members.map((member, memberIndex) => {
        const portrait = portraitOf(member);
        return (
          <li class:list={[memberIndex % 2 === 1 && "mt-4 md:mt-10"]}>
            <a
              href={`#${entrySlug(member.id)}`}
              class="group text-paper flex flex-col items-center gap-1.5 text-center md:gap-2.5"
            >
              <FramedPicture
                image={portrait.image}
                alt={portrait.alt}
                widths={PORTRAIT_WIDTHS}
                sizes={PORTRAIT_SIZES}
                frame="bordered"
                class="h-44 md:h-85"
              />
              <span class="card-title group-hover:text-coral text-current md:text-3xl">
                {member.data.name}
              </span>
              <span class="text-mist text-sm font-bold md:text-base">
                {strings.highlineSince} {member.data.highlineSince}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </Container>
</section>
