---
import type { CollectionEntry } from "astro:content";
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import FramedPicture from "../ui/FramedPicture.astro";
import HighlightedText from "../ui/HighlightedText.astro";
import KeyFactsRow from "../ui/KeyFactsRow.astro";
import Skyline, { type SkylineEdgeFill } from "../ui/Skyline.astro";

type PageData = CollectionEntry<"pages">["data"];

interface Props {
  page: PageData;
  keyFacts?: PageData["keyFacts"];
  keyFactsLabel?: string;
  edgeFill?: SkylineEdgeFill;
  photoShape?: PhotoShape;
}

type PhotoShape = "portrait" | "landscape";

interface ShapeLayout {
  section: string;
  grid: string;
  text: string;
  photo: string;
  image: string;
}

const SHAPE_LAYOUTS: Record<PhotoShape, ShapeLayout> = {
  portrait: {
    section: "md:pb-44",
    grid: "",
    text: "md:col-span-7",
    photo: "md:col-span-5",
    image: "object-upper h-170",
  },
  landscape: {
    section: "md:pb-32",
    grid: "md:items-center",
    text: "md:col-span-6",
    photo: "md:col-span-6",
    image: "aspect-photo",
  },
};

const PHOTO_WIDTHS = [600, 1000];
const PHOTO_SIZES = "(min-width: 768px) 600px, 100vw";

const {
  page,
  keyFacts,
  keyFactsLabel,
  edgeFill = "snow",
  photoShape = "portrait",
} = Astro.props;
const layout = SHAPE_LAYOUTS[photoShape];
---

<section
  aria-labelledby="page-title"
  class:list={["bg-lichen pt-page-top relative pb-20", layout.section]}
>
  <Container class:list={["gap-block grid md:grid-cols-12", layout.grid]}>
    <div
      class:list={[
        "gap-block flex flex-col",
        layout.text,
        keyFacts && "justify-between md:pb-20",
      ]}
    >
      <div class="gap-stack flex flex-col">
        {page.eyebrow && <Eyebrow>{page.eyebrow}</Eyebrow>}
        <h1 id="page-title" class="page-title">
          <HighlightedText
            text={page.heading}
            highlight={page.headingAccent ?? ""}
            highlightClass="text-forest italic"
          />
        </h1>
        <div class="lead max-w-140">
          <slot />
        </div>
      </div>
      <div class="gap-stack flex flex-col">
        {keyFacts && (
          <KeyFactsRow facts={keyFacts} label={keyFactsLabel ?? ""} />
        )}
        <div class="gap-inline flex flex-wrap">
          <slot name="actions" />
        </div>
      </div>
    </div>
    {page.illustration && (
      <div class:list={["hidden md:block", layout.photo]}>
        <FramedPicture
          image={page.illustration.image}
          alt={page.illustration.alt}
          widths={PHOTO_WIDTHS}
          sizes={PHOTO_SIZES}
          loading="eager"
          class={layout.image}
        />
      </div>
    )}
  </Container>
  <Skyline variant="edge" fill={edgeFill} />
</section>
