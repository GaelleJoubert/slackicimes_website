---
import type { CollectionEntry } from "astro:content";
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import FramedPicture from "../ui/FramedPicture.astro";
import HighlightedText from "../ui/HighlightedText.astro";
import KeyFactsRow from "../ui/KeyFactsRow.astro";
import Skyline, { type SkylineEdgeFill } from "../ui/Skyline.astro";

type PageData = CollectionEntry<"pages">["data"];

interface Props {
  page: PageData;
  keyFacts?: PageData["keyFacts"];
  keyFactsLabel?: string;
  edgeFill?: SkylineEdgeFill;
}

const PHOTO_WIDTHS = [600, 1000];
const PHOTO_SIZES = "(min-width: 768px) 500px, 100vw";

const { page, keyFacts, keyFactsLabel, edgeFill = "snow" } = Astro.props;
---

<section
  aria-labelledby="page-title"
  class="bg-lichen pt-page-top relative pb-20 md:pb-44"
>
  <Container class="gap-block grid md:grid-cols-12">
    <div
      class:list={[
        "gap-block flex flex-col md:col-span-7",
        keyFacts && "justify-between md:pb-20",
      ]}
    >
      <div class="gap-stack flex flex-col">
        {page.eyebrow && <Eyebrow>{page.eyebrow}</Eyebrow>}
        <h1 id="page-title" class="page-title">
          <HighlightedText
            text={page.heading}
            highlight={page.headingAccent ?? ""}
            highlightClass="text-forest italic"
          />
        </h1>
        <div class="lead max-w-140">
          <slot />
        </div>
      </div>
      <div class="gap-stack flex flex-col">
        {keyFacts && (
          <KeyFactsRow facts={keyFacts} label={keyFactsLabel ?? ""} />
        )}
        <div class="gap-inline flex flex-wrap">
          <slot name="actions" />
        </div>
      </div>
    </div>
    {page.illustration && (
      <div class="hidden md:col-span-5 md:block">
        <FramedPicture
          image={page.illustration.image}
          alt={page.illustration.alt}
          widths={PHOTO_WIDTHS}
          sizes={PHOTO_SIZES}
          loading="eager"
          class="object-upper h-170"
        />
      </div>
    )}
  </Container>
  <Skyline variant="edge" fill={edgeFill} />
</section>
