---
import { render, type CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import Container from "../ui/Container.astro";
import Disclosure from "../ui/Disclosure.astro";
import LinkButton from "../ui/LinkButton.astro";
import SectionIntro from "../ui/SectionIntro.astro";

interface Props {
  id: string;
  intro: string;
  questions: CollectionEntry<"faq">[];
  locale: Locale;
}

const DISCLOSURE_GROUP_NAME = "faq";

const { id, intro, questions, locale } = Astro.props;
const strings = uiStrings(locale);
const renderedQuestions = await Promise.all(
  questions.map(async (question) => ({
    question: question.data.question,
    Answer: (await render(question)).Content,
  })),
);
const contactPath = localizedPath("contact", locale);
---

<section id={id} class="bg-cloud scroll-mt-4 py-14 md:py-26">
  <Container class="grid items-start gap-6 md:grid-cols-3 md:gap-14">
    <SectionIntro
      title={strings.faq.title}
      eyebrow={strings.faq.eyebrow}
      eyebrowTone="sky"
    >
      <p class="text-slate">{intro}</p>
      <LinkButton
        href={contactPath}
        variant="secondary"
        class="hidden self-start md:inline-flex"
      >
        {strings.faq.otherQuestionButton}
      </LinkButton>
    </SectionIntro>
    <div class="flex flex-col gap-2.5 md:col-span-2 md:gap-3">
      {renderedQuestions.map(({ question, Answer }, questionIndex) => (
        <Disclosure
          summary={question}
          groupName={DISCLOSURE_GROUP_NAME}
          isOpen={questionIndex === 0}
        >
          <Answer />
        </Disclosure>
      ))}
    </div>
    <LinkButton href={contactPath} variant="secondary" class="md:hidden">
      {strings.faq.otherQuestionButton}
    </LinkButton>
  </Container>
</section>
