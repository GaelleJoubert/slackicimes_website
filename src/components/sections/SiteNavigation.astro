---
import type { Locale } from "../../i18n/locales";
import { MAIN_NAVIGATION } from "../../i18n/navigation";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import NavigationLink from "../ui/NavigationLink.astro";
import type { HeaderTone } from "./header-tone";

type NavigationLayout = "inline" | "stacked";

interface Props {
  locale: Locale;
  currentPageSlug: string;
  layout: NavigationLayout;
  tone: HeaderTone;
}

const LAYOUT_CLASSES: Record<
  NavigationLayout,
  { list: string; item: string; submenu: string }
> = {
  inline: {
    list: "flex items-center gap-1",
    item: "group relative",
    submenu:
      "absolute top-full left-0 hidden pt-2 group-focus-within:block group-hover:block",
  },
  stacked: {
    list: "flex flex-col gap-1",
    item: "",
    submenu: "border-coral ml-5 border-l-3 pl-2",
  },
};

const SUBMENU_LIST_CLASSES: Record<NavigationLayout, string> = {
  inline:
    "bg-paper border-navy shadow-raised flex min-w-60 flex-col rounded-card border-3 p-2",
  stacked: "flex flex-col",
};

const { locale, currentPageSlug, layout, tone } = Astro.props;
const strings = uiStrings(locale);
const layoutClasses = LAYOUT_CLASSES[layout];
---

<nav aria-label={strings.navigation.mainMenuLabel}>
  <ul class={layoutClasses.list}>
    {MAIN_NAVIGATION.map((item) => (
      <li class={layoutClasses.item}>
        <NavigationLink
          href={localizedPath(item.pageSlug, locale)}
          isCurrentPage={item.pageSlug === currentPageSlug}
          tone={tone}
        >
          {strings.navigation[item.labelKey]}
        </NavigationLink>
        {item.children && (
          <div class={layoutClasses.submenu}>
            <ul class={SUBMENU_LIST_CLASSES[layout]}>
              {item.children.map((child) => (
                <li>
                  <NavigationLink
                    href={localizedPath(child.pageSlug, locale)}
                    isCurrentPage={child.pageSlug === currentPageSlug}
                    tone="light"
                  >
                    {strings.navigation[child.labelKey]}
                  </NavigationLink>
                </li>
              ))}
            </ul>
          </div>
        )}
      </li>
    ))}
  </ul>
</nav>
