---
import type { Locale } from "../../i18n/locales";
import {
  MAIN_NAVIGATION,
  isCurrentNavigationItem,
  navigationHref,
} from "../../i18n/navigation";
import { uiStrings } from "../../i18n/ui";
import NavigationLink from "../ui/NavigationLink.astro";
import type { HeaderTone } from "./header-tone";

type NavigationLayout = "inline" | "stacked";

interface Props {
  locale: Locale;
  currentPageSlug: string;
  layout: NavigationLayout;
  tone: HeaderTone;
}

const LAYOUT_CLASSES: Record<
  NavigationLayout,
  { list: string; item: string; submenu: string }
> = {
  inline: {
    list: "flex items-center gap-3",
    item: "group relative",
    submenu:
      "absolute top-full left-0 hidden pt-2 group-focus-within:block group-hover:block",
  },
  stacked: {
    list: "flex flex-col gap-1",
    item: "",
    submenu: "border-rule ml-3 border-l pl-2",
  },
};

const SUBMENU_LIST_CLASSES: Record<NavigationLayout, string> = {
  inline:
    "bg-snow border-rule rounded-control flex min-w-60 flex-col border p-2",
  stacked: "flex flex-col",
};

const { locale, currentPageSlug, layout, tone } = Astro.props;
const strings = uiStrings(locale);
const layoutClasses = LAYOUT_CLASSES[layout];
---

<nav aria-label={strings.navigation.mainMenuLabel}>
  <ul class={layoutClasses.list}>
    {MAIN_NAVIGATION.map((item) => (
      <li class={layoutClasses.item}>
        <NavigationLink
          href={navigationHref(item, locale)}
          isCurrentPage={isCurrentNavigationItem(item, currentPageSlug)}
          tone={tone}
        >
          {strings.navigation[item.labelKey]}
        </NavigationLink>
        {item.children && (
          <div class={layoutClasses.submenu}>
            <ul class={SUBMENU_LIST_CLASSES[layout]}>
              {item.children.map((child) => (
                <li>
                  <NavigationLink
                    href={navigationHref(child, locale)}
                    isCurrentPage={isCurrentNavigationItem(
                      child,
                      currentPageSlug,
                    )}
                    tone="light"
                  >
                    {strings.navigation[child.labelKey]}
                  </NavigationLink>
                </li>
              ))}
            </ul>
          </div>
        )}
      </li>
    ))}
  </ul>
</nav>

<script>
  // A link to a section of the current page does not reload it, so the open menu would cover that section.
  document
    .querySelectorAll<HTMLAnchorElement>("header nav a[href*='#']")
    .forEach((sectionLink) => {
      sectionLink.addEventListener("click", () => {
        sectionLink.blur();
        sectionLink.closest("details")?.removeAttribute("open");
      });
    });
</script>
