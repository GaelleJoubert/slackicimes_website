---
import { render, type CollectionEntry } from "astro:content";
import { editionPeriodLabel } from "../../../lib/festival-edition";
import TimelineEntry, {
  type TimelineDotTone,
} from "../../ui/TimelineEntry.astro";
import EditionVideoLinks from "./EditionVideoLinks.astro";

interface Props {
  editions: CollectionEntry<"festivalEditions">[];
  dotTone: TimelineDotTone;
}

const { editions, dotTone } = Astro.props;
const renderedEditions = await Promise.all(
  editions.map(async (edition) => ({
    edition,
    Story: (await render(edition)).Content,
  })),
);
---

<TimelineEntry
  dotTone={dotTone}
  dotOffset="card"
  class="bg-moss rounded-card gap-block p-card grid md:grid-cols-2"
>
  {renderedEditions.map(({ edition, Story }) => (
    <article class="gap-stack flex flex-col">
      <h2 class="timeline-year text-slate">
        {editionPeriodLabel(edition.data.period, edition.data.editionNumber)}
      </h2>
      <div class="rich-text">
        <Story />
      </div>
      <EditionVideoLinks edition={edition} />
    </article>
  ))}
</TimelineEntry>
