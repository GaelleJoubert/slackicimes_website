---
import type { CollectionEntry } from "astro:content";
import { entrySlug } from "../../i18n/content";
import { LOCALE_SETTINGS, type Locale } from "../../i18n/locales";
import { uiStrings } from "../../i18n/ui";
import { formatPriceInEuros } from "../../lib/format";
import { STAGES_REGISTRATION_URL } from "../../lib/site";
import LinkButton from "../ui/LinkButton.astro";
import Section from "../ui/Section.astro";

interface Props {
  stage: CollectionEntry<"stages">;
  locale: Locale;
}

const { stage, locale } = Astro.props;
const strings = uiStrings(locale);
const { name, duration, level, description, program, prerequisites, dates } =
  stage.data;
const formattedPrice = formatPriceInEuros(
  stage.data.priceInEuros,
  LOCALE_SETTINGS[locale].htmlLang,
);
---

<Section id={entrySlug(stage.id)}>
  <div class="border-mist border-t pt-10">
    <h2 class="section-title">{name}</h2>
    <p class="caption mt-1">
      {duration} · {level}
    </p>

    <div class="mt-6 grid gap-8 md:grid-cols-3">
      <div class="space-y-6 md:col-span-2">
        <div class="space-y-3">
          <h3 class="subsection-title">{strings.stages.descriptionHeading}</h3>
          {description.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="space-y-3">
          <h3 class="subsection-title">{strings.stages.programHeading}</h3>
          {program.intro.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <ul class="list-disc space-y-1 pl-6">
            {program.items.map((item) => (
              <li>
                {item.label}
                {item.details.length > 0 && (
                  <ul class="text-slate list-disc pl-6">
                    {item.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="bg-mist/30 space-y-5 rounded-lg p-5">
        <div>
          <h3 class="subsection-title">
            {strings.stages.prerequisitesHeading}
          </h3>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            {prerequisites.map((prerequisite) => (
              <li>{prerequisite}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="subsection-title">{strings.stages.datesHeading}</h3>
          <p class="mt-2">{dates}</p>
        </div>
        <div>
          <h3 class="subsection-title">{strings.stages.priceHeading}</h3>
          <p class="font-heading text-coral-strong mt-2 text-2xl font-extrabold">
            {formattedPrice}
          </p>
          <p class="caption">{strings.stages.priceNote}</p>
        </div>
        <LinkButton href={STAGES_REGISTRATION_URL}>
          {strings.stages.registerButton}
          <span class="sr-only">: {name}</span>
        </LinkButton>
      </aside>
    </div>
  </div>
</Section>
