---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import LinkButton from "../ui/LinkButton.astro";
import Section from "../ui/Section.astro";

type ImageSide = "start" | "end";

interface Props {
  title: string;
  paragraphs: string[];
  illustration?: { image: ImageMetadata; alt: string };
  imageSide?: ImageSide;
  link?: { href: string; label: string };
  tone?: "paper" | "mist";
}

const FEATURE_IMAGE_WIDTHS = [480, 960];
const FEATURE_IMAGE_SIZES = "(min-width: 768px) 480px, 100vw";
const IMAGE_ORDER_CLASSES: Record<ImageSide, string> = {
  start: "md:order-first",
  end: "md:order-last",
};

const {
  title,
  paragraphs,
  illustration,
  imageSide = "start",
  link,
  tone,
} = Astro.props;
---

<Section tone={tone}>
  <div
    class:list={["grid items-center gap-8", illustration && "md:grid-cols-2"]}
  >
    {illustration && (
      <div class={IMAGE_ORDER_CLASSES[imageSide]}>
        <Picture
          src={illustration.image}
          alt={illustration.alt}
          widths={FEATURE_IMAGE_WIDTHS}
          sizes={FEATURE_IMAGE_SIZES}
          formats={["avif", "webp"]}
          class="aspect-4/3 w-full rounded-lg object-cover"
        />
      </div>
    )}
    <div>
      <h2 class="section-title">{title}</h2>
      <div class="rich-text mt-4">
        {paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      {link && (
        <div class="mt-6">
          <LinkButton href={link.href} variant="secondary">
            {link.label}
          </LinkButton>
        </div>
      )}
    </div>
  </div>
  <slot />
</Section>
