---
import { WORLD_CUP_SECTION_IDS } from "../../../lib/world-cup";
import CupSection from "../../ui/CupSection.astro";
import CupSectionIntro from "../../ui/CupSectionIntro.astro";
import type { WorldCupContent } from "./types";

interface Props {
  athletes: WorldCupContent["athletes"];
}

const { athletes } = Astro.props;
const placeholderSlots = Array.from({ length: athletes.slotsPerCategory });
---

<CupSection id={WORLD_CUP_SECTION_IDS.athletes} tone="surface">
  <div class="flex flex-col gap-9">
    <CupSectionIntro
      eyebrow={athletes.eyebrow}
      title={athletes.title}
      theme="light"
    >
      <p class="max-w-2xl">
        {athletes.intro} <strong>{athletes.announcement}</strong>
      </p>
    </CupSectionIntro>
    <div class="grid gap-6 lg:grid-cols-2">
      {athletes.categories.map((category) => (
        <div class="flex flex-col gap-4 rounded-2xl bg-white p-7">
          <h3 class="cup-card-title text-cup-navy">{category}</h3>
          <ul class="grid grid-cols-4 gap-3 sm:grid-cols-6">
            {placeholderSlots.map(() => (
              <li class="flex flex-col items-center gap-1.5">
                <span
                  aria-hidden="true"
                  class="bg-cup-placeholder text-cup-placeholder-text font-display flex aspect-square w-full items-center justify-center rounded-full text-xl font-semibold"
                >
                  ?
                </span>
                <span class="text-cup-muted text-xs">
                  {athletes.placeholderLabel}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</CupSection>
