---
import type { Locale } from "../../../i18n/locales";
import { WORLD_CUP_SECTION_IDS } from "../../../lib/world-cup";
import CupSection from "../../ui/CupSection.astro";
import CupSectionIntro from "../../ui/CupSectionIntro.astro";
import type { WorldCupContent } from "./types";
import WorldCupContestInfo from "./WorldCupContestInfo.astro";
import WorldCupWildCard from "./WorldCupWildCard.astro";

interface Props {
  athletes: WorldCupContent["athletes"];
  locale: Locale;
}

const { athletes, locale } = Astro.props;
---

<CupSection
  id={WORLD_CUP_SECTION_IDS.athletes}
  tone="navy"
  edgeFill="cupSurface"
  edgeProfile="crete"
>
  <div class="gap-block flex flex-col">
    <CupSectionIntro
      eyebrow={athletes.eyebrow}
      title={athletes.title}
      theme="dark"
    >
      <p class="text-cup-soft max-w-3xl text-lg md:text-xl">{athletes.intro}</p>
    </CupSectionIntro>
    <WorldCupContestInfo contest={athletes.contest} locale={locale} />
    <WorldCupWildCard wildCard={athletes.wildCard} />
  </div>
</CupSection>
