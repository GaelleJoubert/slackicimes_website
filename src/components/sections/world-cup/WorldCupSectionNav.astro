---
import Container from "../../ui/Container.astro";
import type { WorldCupContent } from "./types";

interface Props {
  sectionNav: WorldCupContent["sectionNav"];
}

const { sectionNav } = Astro.props;
---

<nav
  aria-label={sectionNav.label}
  class="bg-cup-ink border-cup-pink sticky top-18 z-10 border-b-4 lg:top-24"
>
  <Container>
    <ul class="flex gap-7 overflow-x-auto text-sm font-semibold whitespace-nowrap md:text-base">
      {sectionNav.links.map((link) => (
        <li>
          <a
            href={`#${link.target}`}
            class="hover:text-cup-sky block py-4 text-white"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </Container>
</nav>
