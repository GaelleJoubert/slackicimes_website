---
import ChevronIcon from "../../ui/ChevronIcon.astro";
import Container from "../../ui/Container.astro";
import { actionBadgeClasses } from "../../ui/action-badge";
import type { WorldCupContent } from "./types";

interface Props {
  sectionNav: WorldCupContent["sectionNav"];
}

const CURRENT_LINK_CLASSES = "data-current:text-cup-sky";

const { sectionNav } = Astro.props;
const [firstLink] = sectionNav.links;
const desktopLinks = sectionNav.links.filter((link) => !link.mobileOnly);
---

<nav
  data-section-nav
  aria-label={sectionNav.label}
  class="bg-cup-ink sticky top-18 z-10 lg:top-24"
>
  <Container class="relative">
    <details data-section-menu class="group md:hidden">
      <summary class="flex min-h-12 cursor-pointer items-center justify-between gap-4 font-semibold text-white">
        <span data-current-section-label>{firstLink.label}</span>
        <span class={actionBadgeClasses("default", "cupOutlineOnDark")}>
          <ChevronIcon
            direction="down"
            class="transition group-open:rotate-180"
          />
        </span>
      </summary>
      <ul class="bg-cup-ink absolute inset-x-0 top-full px-5 pb-2">
        {sectionNav.links.map((link) => (
          <li class="border-cup-line border-t">
            <a
              href={`#${link.target}`}
              class:list={[
                "block py-3 text-white data-current:font-bold",
                CURRENT_LINK_CLASSES,
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
    <ul class="hidden gap-7 overflow-x-auto text-base font-semibold whitespace-nowrap md:flex">
      {desktopLinks.map((link) => (
        <li>
          <a
            href={`#${link.target}`}
            class:list={[
              "hover:text-cup-sky block py-4 text-white",
              CURRENT_LINK_CLASSES,
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </Container>
</nav>

<script>
  import { setUpSectionNav } from "./section-nav";

  document
    .querySelectorAll<HTMLElement>("[data-section-nav]")
    .forEach(setUpSectionNav);
</script>
