---
import { WORLD_CUP_SECTION_IDS } from "../../../lib/world-cup";
import CupSection from "../../ui/CupSection.astro";
import type { WorldCupContent } from "./types";
import WorldCupBracket from "./WorldCupBracket.astro";

interface Props {
  format: WorldCupContent["format"];
}

const STORY_BLOCK_CLASSES = "p-tile flex flex-col gap-2 rounded-2xl bg-white";

const { format } = Astro.props;
---

<CupSection id={WORLD_CUP_SECTION_IDS.format} tone="surface">
  <div class="gap-stack flex flex-col">
    <h2 class="cup-title text-cup-navy">{format.title}</h2>
    <div class="gap-grid grid md:grid-cols-2">
      <article class={STORY_BLOCK_CLASSES}>
        <h3 class="cup-card-title text-cup-navy">{format.battle.title}</h3>
        <p class="text-base">{format.battle.text}</p>
      </article>
      <article class:list={[STORY_BLOCK_CLASSES, "order-last md:order-none"]}>
        <h3 class="cup-card-title text-cup-navy">{format.origin.title}</h3>
        <p class="text-base">{format.origin.text}</p>
      </article>
      <div class="md:col-span-2">
        <WorldCupBracket bracket={format.bracket} />
      </div>
    </div>
  </div>
</CupSection>
