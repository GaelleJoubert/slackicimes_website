---
import "@fontsource-variable/inter";
import { Picture } from "astro:assets";
import Container from "../../ui/Container.astro";
import LineGlyph from "../../ui/LineGlyph.astro";
import LinkButton from "../../ui/LinkButton.astro";
import Skyline, { type SkylineEdgeFill } from "../../ui/Skyline.astro";
import type { ButtonVariant } from "../../ui/button-styles";
import type { WorldCupContent } from "./types";

interface ShowcaseAction {
  href: string;
  label: string;
  variant: ButtonVariant;
}

interface Props {
  hero: WorldCupContent["hero"];
  headingLevel: "h1" | "h2";
  titleId: string;
  actions: ShowcaseAction[];
  edgeFill: SkylineEdgeFill;
}

const FULL_LOGO_WIDTHS = [640, 1280];
const FULL_LOGO_SIZES = "(min-width: 768px) 640px, 90vw";
const POSTER_WIDTHS = [400, 800];
const POSTER_SIZES = "(min-width: 768px) 460px, 100vw";

const { hero, headingLevel: Heading, titleId, actions, edgeFill } = Astro.props;
const isPageHeading = Heading === "h1";
const imageLoading = isPageHeading ? "eager" : "lazy";
---

<section
  aria-labelledby={titleId}
  class="bg-cup-navy font-cup pt-section relative pb-28 text-white md:pb-40"
>
  <Container class="gap-block grid items-center md:grid-cols-12">
    <div class="gap-block flex flex-col md:col-span-7">
      <div class="gap-stack flex flex-col">
        <span class="text-cup-sky cup-eyebrow flex items-center gap-3">
          <LineGlyph />
          {hero.badge}
        </span>
        <Heading id={titleId}>
          <Picture
            src={hero.fullLogo.image}
            alt={hero.fullLogo.alt}
            widths={FULL_LOGO_WIDTHS}
            sizes={FULL_LOGO_SIZES}
            formats={["avif", "webp"]}
            loading={imageLoading}
            class="h-auto w-full max-w-160"
          />
        </Heading>
        <p class="text-cup-soft max-w-150 text-lg md:text-xl">{hero.intro}</p>
      </div>
      <dl class="border-cup-line grid border-y sm:grid-cols-3">
        {hero.facts.map((fact) => (
          <div class="border-cup-line flex flex-col gap-1 py-4 not-last:border-b sm:pr-4 sm:not-last:border-b-0 md:py-5">
            <dt class="text-cup-slate-muted text-xs font-semibold tracking-widest uppercase">
              {fact.label}
            </dt>
            <dd class="font-display text-xl font-semibold md:text-2xl">
              {fact.value}
            </dd>
          </div>
        ))}
      </dl>
      <div class="gap-inline flex flex-col sm:flex-row sm:flex-wrap">
        {actions.map((action) => (
          <LinkButton href={action.href} variant={action.variant}>
            {action.label}
          </LinkButton>
        ))}
      </div>
    </div>
    <div class="hidden md:col-span-5 md:block">
      <Picture
        src={hero.poster.image}
        alt={hero.poster.alt}
        widths={POSTER_WIDTHS}
        sizes={POSTER_SIZES}
        formats={["avif", "webp"]}
        loading={imageLoading}
        class="rounded-card h-auto w-full"
      />
    </div>
  </Container>
  <Skyline variant="edge" fill={edgeFill} />
</section>
