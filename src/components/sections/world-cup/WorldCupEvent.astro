---
import { Picture } from "astro:assets";
import { WORLD_CUP_SECTION_IDS } from "../../../lib/world-cup";
import CupSection from "../../ui/CupSection.astro";
import CupSectionIntro from "../../ui/CupSectionIntro.astro";
import type { WorldCupContent, WorldCupVenue } from "./types";
import WorldCupVenuePhoto from "./WorldCupVenuePhoto.astro";

interface Props {
  event: WorldCupContent["event"];
  venue: WorldCupVenue;
}

const ILLUSTRATION_WIDTHS = [480, 960];
const ILLUSTRATION_SIZES = "(min-width: 1024px) 460px, 100vw";

const { event, venue } = Astro.props;
---

<CupSection id={WORLD_CUP_SECTION_IDS.event} tone="surface">
  <div class="gap-block flex flex-col">
    <div class="gap-stack flex flex-col">
      <CupSectionIntro
        eyebrow={event.eyebrow}
        title={event.title}
        theme="light"
      />
      <div class="gap-stack lg:gap-x-block grid items-center lg:grid-cols-5">
        <div class="gap-stack flex flex-col lg:col-span-3">
          {event.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        <div class="hidden lg:col-span-2 lg:block">
          <Picture
            src={event.illustration.image}
            alt={event.illustration.alt}
            widths={ILLUSTRATION_WIDTHS}
            sizes={ILLUSTRATION_SIZES}
            formats={["avif", "webp"]}
            class="aspect-photo w-full rounded-2xl object-cover"
          />
        </div>
      </div>
    </div>
    <ul class="bg-cup-navy gap-grid p-card grid grid-cols-2 rounded-2xl text-white lg:grid-cols-4">
      {event.stats.map((stat) => (
        <li class="lg:not-first:border-cup-line lg:not-first:pl-grid flex flex-col gap-1 lg:not-first:border-l">
          <p class="cup-stat-value text-cup-sky whitespace-nowrap">
            {stat.value}
          </p>
          <p class="font-semibold">{stat.label}</p>
          <p class="text-cup-soft hidden text-sm lg:block">{stat.detail}</p>
        </li>
      ))}
    </ul>
    <WorldCupVenuePhoto venue={venue} class="flex lg:hidden" />
  </div>
</CupSection>
