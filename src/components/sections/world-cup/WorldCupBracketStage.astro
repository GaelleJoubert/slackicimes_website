---
import type { WorldCupContent } from "./types";

type BracketStage = WorldCupContent["format"]["bracket"]["grandFinal"];
type StageTone = "regular" | "final";

interface Props {
  stage: BracketStage;
  tone: StageTone;
}

const CARD_TONE_CLASSES: Record<StageTone, string> = {
  regular: "border-cup-line",
  final: "border-cup-pink",
};

const { stage, tone } = Astro.props;
---

<div
  class:list={[
    "p-tile flex flex-col justify-center gap-2 rounded-2xl border-2",
    CARD_TONE_CLASSES[tone],
  ]}
>
  <h4 class="cup-card-title lg:text-xl">{stage.title}</h4>
  <p class="text-cup-soft text-sm">{stage.text}</p>
  <slot />
</div>
