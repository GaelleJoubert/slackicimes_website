---
import { LOCALE_SETTINGS, type Locale } from "../../../i18n/locales";
import { formatPriceInEuros } from "../../../lib/format";
import DotList from "../../ui/DotList.astro";
import type { WorldCupContent } from "./types";

interface Props {
  contest: WorldCupContent["athletes"]["contest"];
  locale: Locale;
}

const COLUMN_CLASSES = "gap-stack flex flex-col border-t-2 pt-5";

const { contest, locale } = Astro.props;
const { setup, prize, rulebook } = contest;
const languageTag = LOCALE_SETTINGS[locale].htmlLang;
---

<div class="gap-stack flex flex-col">
  <h3 class="cup-subsection-title">{contest.title}</h3>
  <div class="gap-grid grid lg:grid-cols-3">
    <div class:list={[COLUMN_CLASSES, "border-cup-line"]}>
      <h4 class="cup-card-title text-xl">{setup.title}</h4>
      <DotList
        items={setup.items}
        size="small"
        bulletTone="cupPink"
        class="text-cup-soft"
      />
    </div>
    <div class:list={[COLUMN_CLASSES, "border-cup-line"]}>
      <h4 class="cup-card-title text-xl">{prize.title}</h4>
      <p class="text-cup-soft text-sm">{prize.note}</p>
      <dl class="divide-cup-line flex flex-col divide-y">
        {prize.places.map((place) => (
          <div class="flex items-baseline justify-between gap-3 py-3">
            <dt class="text-sm">{place.label}</dt>
            <dd class="font-display text-cup-sky text-2xl font-semibold">
              {formatPriceInEuros(place.amountInEuros, languageTag)}
            </dd>
          </div>
        ))}
      </dl>
    </div>
    <div class:list={[COLUMN_CLASSES, "border-cup-line border-dashed"]}>
      <h4 class="cup-card-title text-xl">{rulebook.title}</h4>
      <p class="text-cup-slate-muted text-sm">{rulebook.text}</p>
    </div>
  </div>
</div>
