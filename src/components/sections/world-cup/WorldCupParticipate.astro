---
import { WORLD_CUP_SECTION_IDS } from "../../../lib/world-cup";
import CupSection from "../../ui/CupSection.astro";
import CupSectionIntro from "../../ui/CupSectionIntro.astro";
import LinkButton from "../../ui/LinkButton.astro";
import WorldCupCompetitionFacts from "./WorldCupCompetitionFacts.astro";
import type { WorldCupContent } from "./types";
import type { Locale } from "../../../i18n/locales";

interface Props {
  participate: WorldCupContent["participate"];
  locale: Locale;
}

type TimelineEmphasis =
  WorldCupContent["participate"]["timeline"][number]["emphasis"];

const TIMELINE_BORDER_CLASSES: Record<TimelineEmphasis, string> = {
  regular: "border-cup-sky",
  highlight: "border-cup-pink",
  reserve: "border-cup-line",
};

const TIMELINE_DATE_CLASSES: Record<TimelineEmphasis, string> = {
  regular: "text-cup-sky",
  highlight: "text-cup-pink-soft",
  reserve: "text-cup-soft",
};

const { participate, locale } = Astro.props;
const { videoFormat, rules, judging, submission } = participate;
---

<CupSection id={WORLD_CUP_SECTION_IDS.participate} tone="ink">
  <div class="gap-block flex flex-col">
    <CupSectionIntro
      eyebrow={participate.eyebrow}
      title={participate.title}
      theme="dark"
    >
      <p class="text-cup-slate-text max-w-3xl">{participate.intro}</p>
    </CupSectionIntro>
    <ol class="gap-grid grid sm:grid-cols-3">
      {participate.timeline.map((milestone) => (
        <li
          class:list={[
            "border-t-4 pt-3.5",
            TIMELINE_BORDER_CLASSES[milestone.emphasis],
          ]}
        >
          <span
            class:list={[
              "text-sm font-bold uppercase",
              TIMELINE_DATE_CLASSES[milestone.emphasis],
            ]}
          >
            {milestone.date}
          </span>
          <p class="mt-1 font-semibold">{milestone.label}</p>
        </li>
      ))}
    </ol>
    <div class="gap-grid grid lg:grid-cols-2">
      <div class="bg-cup-navy gap-stack p-card flex flex-col rounded-2xl">
        <h3 class="font-display text-xl font-semibold uppercase">
          {videoFormat.title}
        </h3>
        <ul class="text-cup-pale flex list-disc flex-col gap-2 pl-5">
          {videoFormat.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <h3 class="font-display mt-2 text-xl font-semibold uppercase">
          {rules.title}
        </h3>
        <ul class="text-cup-pale flex list-disc flex-col gap-2 pl-5">
          {rules.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div class="gap-grid flex flex-col">
        <div class="bg-cup-navy gap-stack p-card flex flex-col rounded-2xl">
          <h3 class="font-display text-xl font-semibold uppercase">
            {judging.title}
          </h3>
          <dl class="divide-cup-line flex flex-col divide-y">
            {judging.criteria.map((criterion) => (
              <div class="flex justify-between gap-3 py-2.5">
                <dt>{criterion.label}</dt>
                <dd class="text-cup-sky font-bold whitespace-nowrap">
                  {criterion.points}
                </dd>
              </div>
            ))}
          </dl>
          <p class="text-cup-soft text-sm">{judging.note}</p>
        </div>
        <div class="border-cup-pink bg-cup-navy gap-stack p-card flex flex-col items-start rounded-2xl border-2">
          <p class="font-semibold">{submission.text}</p>
          <LinkButton href={submission.url} variant="cupPrimary">
            {submission.label}
          </LinkButton>
        </div>
      </div>
    </div>
    <WorldCupCompetitionFacts participate={participate} locale={locale} />
  </div>
</CupSection>
