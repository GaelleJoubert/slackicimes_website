---
import { LOCALE_SETTINGS, type Locale } from "../../../i18n/locales";
import { formatPriceInEuros } from "../../../lib/format";
import type { WorldCupContent } from "./types";

interface Props {
  participate: WorldCupContent["participate"];
  locale: Locale;
}

const { participate, locale } = Astro.props;
const { prize, setup, rulebook } = participate;
const languageTag = LOCALE_SETTINGS[locale].htmlLang;
---

<div class="grid gap-5 lg:grid-cols-3">
  <div class="border-cup-line flex flex-col gap-3.5 rounded-2xl border-2 p-7">
    <h3 class="font-display text-xl font-semibold uppercase">{prize.title}</h3>
    <p class="text-cup-soft text-sm">{prize.note}</p>
    <dl class="grid grid-cols-2 gap-2.5 text-center sm:grid-cols-4 lg:grid-cols-2">
      {prize.places.map((place) => (
        <div class="bg-cup-navy rounded-xl px-1.5 py-3.5">
          <dt class="text-cup-soft text-sm">{place.label}</dt>
          <dd class="font-display text-cup-sky text-2xl font-bold">
            {formatPriceInEuros(place.amountInEuros, languageTag)}
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="bg-cup-navy flex flex-col gap-3 rounded-2xl p-7">
    <h3 class="font-display text-xl font-semibold uppercase">{setup.title}</h3>
    <ul class="text-cup-pale flex list-disc flex-col gap-1.5 pl-5">
      {setup.items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
  <div class="border-cup-line flex flex-col justify-center gap-2.5 rounded-2xl border-2 border-dashed p-7">
    <h3 class="font-display text-xl font-semibold uppercase">
      {rulebook.title}
    </h3>
    <p class="text-cup-soft">{rulebook.text}</p>
  </div>
</div>
