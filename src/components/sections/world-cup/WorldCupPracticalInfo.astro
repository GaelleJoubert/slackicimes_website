---
import { WORLD_CUP_SECTION_IDS } from "../../../lib/world-cup";
import CupSection from "../../ui/CupSection.astro";
import CupSectionIntro from "../../ui/CupSectionIntro.astro";
import type { WorldCupContent } from "./types";
import WorldCupVenuePhoto from "./WorldCupVenuePhoto.astro";

interface Props {
  infos: WorldCupContent["infos"];
}

const { infos } = Astro.props;
const lastStepIndex = infos.steps.length - 1;
---

<CupSection id={WORLD_CUP_SECTION_IDS.practicalInfo} tone="white">
  <div class="gap-stack flex flex-col">
    <CupSectionIntro
      eyebrow={infos.eyebrow}
      title={infos.title}
      theme="light"
    />
    <div class="gap-block grid lg:grid-cols-3">
      <div class="gap-stack flex flex-col lg:col-span-2">
        <ol class="gap-stack flex flex-col">
          {infos.steps.map((step, stepIndex) => (
            <li class="flex items-start gap-4">
              <span
                aria-hidden="true"
                class:list={[
                  "font-display w-8 flex-none text-4xl leading-none font-bold",
                  stepIndex === lastStepIndex
                    ? "text-cup-magenta"
                    : "text-cup-navy",
                ]}
              >
                {stepIndex + 1}
              </span>
              <div>
                <h3 class="text-cup-navy text-lg font-bold">{step.title}</h3>
                <p class="mt-1">
                  {step.text}{" "}
                  {step.link && (
                    <a
                      href={step.link.url}
                      class="text-cup-magenta hover:text-cup-ink decoration-cup-pink font-bold underline decoration-2 underline-offset-4"
                    >
                      {step.link.label}
                    </a>
                  )}
                </p>
              </div>
            </li>
          ))}
        </ol>
        <ul class="gap-grid grid sm:grid-cols-3">
          {infos.facts.map((fact) => (
            <li class="bg-cup-surface p-tile rounded-2xl">
              <h3 class="text-cup-navy font-bold">{fact.title}</h3>
              <p class="mt-1 text-sm">{fact.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <WorldCupVenuePhoto venue={infos} class="hidden lg:flex" />
    </div>
  </div>
</CupSection>
