---
import { WORLD_CUP_SECTION_IDS } from "../../../lib/world-cup";
import CupSection from "../../ui/CupSection.astro";
import CupSectionIntro from "../../ui/CupSectionIntro.astro";
import type { WorldCupContent } from "./types";
import WorldCupVenuePhoto from "./WorldCupVenuePhoto.astro";

interface Props {
  infos: WorldCupContent["infos"];
}

const { infos } = Astro.props;
---

<CupSection id={WORLD_CUP_SECTION_IDS.practicalInfo} tone="white">
  <div class="gap-block grid lg:grid-cols-12">
    <div class="gap-block flex flex-col lg:col-span-7">
      <CupSectionIntro
        eyebrow={infos.eyebrow}
        title={infos.title}
        theme="light"
      />
      <ol class="flex flex-col">
        {infos.steps.map((step, stepIndex) => (
          <li class="border-cup-border flex items-start gap-5 border-t py-5 last:border-b md:gap-6 md:py-6">
            <span
              aria-hidden="true"
              class="font-display text-cup-navy w-8 flex-none text-4xl leading-none font-bold"
            >
              {stepIndex + 1}
            </span>
            <div class="flex flex-col gap-1.5">
              <h3 class="cup-card-title text-cup-ink text-xl">{step.title}</h3>
              <p class="text-cup-muted">
                {step.text}{" "}
                {step.link && (
                  <a href={step.link.url} class="cup-text-link">
                    {step.link.label}
                  </a>
                )}
              </p>
            </div>
          </li>
        ))}
      </ol>
      <ul class="gap-grid grid sm:grid-cols-3">
        {infos.facts.map((fact) => (
          <li class="border-cup-ink flex flex-col gap-2 border-t-2 pt-4">
            <h3 class="cup-card-title text-cup-ink text-lg">{fact.title}</h3>
            <p class="text-cup-muted text-sm">{fact.text}</p>
          </li>
        ))}
      </ul>
    </div>
    <WorldCupVenuePhoto venue={infos} class="hidden lg:col-span-5 lg:flex" />
  </div>
</CupSection>
