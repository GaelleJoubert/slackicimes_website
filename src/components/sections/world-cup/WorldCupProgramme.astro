---
import { WORLD_CUP_SECTION_IDS } from "../../../lib/world-cup";
import CupSection from "../../ui/CupSection.astro";
import CupSectionIntro from "../../ui/CupSectionIntro.astro";
import type { WorldCupContent } from "./types";

interface Props {
  programme: WorldCupContent["programme"];
}

type DayEmphasis = WorldCupContent["programme"]["days"][number]["emphasis"];

const DAY_CARD_CLASSES: Record<DayEmphasis, string> = {
  regular: "border-cup-line border-2",
  highlight: "border-cup-pink border-2",
  reserve: "border-cup-line border-2 border-dashed",
};

const DAY_DATE_CLASSES: Record<DayEmphasis, string> = {
  regular: "text-cup-sky",
  highlight: "text-cup-pink-soft",
  reserve: "text-cup-sky",
};

const DAY_TEXT_CLASSES: Record<DayEmphasis, string> = {
  regular: "text-cup-soft",
  highlight: "text-white font-medium",
  reserve: "text-cup-soft",
};

const { programme } = Astro.props;
---

<CupSection id={WORLD_CUP_SECTION_IDS.programme} tone="navy">
  <div class="gap-block flex flex-col">
    <CupSectionIntro
      eyebrow={programme.eyebrow}
      title={programme.title}
      theme="dark"
    >
      <p class="text-cup-soft">{programme.note}</p>
    </CupSectionIntro>
    <ol class="gap-grid grid sm:grid-cols-2 lg:grid-cols-5">
      {programme.days.map((day) => (
        <li
          class:list={[
            "p-tile flex flex-col gap-2 rounded-2xl",
            DAY_CARD_CLASSES[day.emphasis],
          ]}
        >
          <span
            class:list={[
              "text-sm font-semibold tracking-wider uppercase",
              DAY_DATE_CLASSES[day.emphasis],
            ]}
          >
            {day.date}
          </span>
          <h3 class="cup-card-title lg:text-xl">{day.title}</h3>
          <p class:list={["text-sm", DAY_TEXT_CLASSES[day.emphasis]]}>
            {day.text}
          </p>
        </li>
      ))}
    </ol>
  </div>
</CupSection>
