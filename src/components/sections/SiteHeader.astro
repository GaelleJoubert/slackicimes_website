---
import { Image } from "astro:assets";
import logo from "../../assets/images/logo-slackicimes.png";
import type { Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import Container from "../ui/Container.astro";
import LanguageSwitcher from "../ui/LanguageSwitcher.astro";
import SiteNavigation from "./SiteNavigation.astro";

interface Props {
  locale: Locale;
  pageSlug: string;
}

const LOGO_LARGEST_HEIGHT_PX = 64;
const HOME_PAGE_SLUG = "";

const { locale, pageSlug } = Astro.props;
const strings = uiStrings(locale);
---

<header class="bg-paper border-mist relative border-b">
  <Container class="flex items-center justify-between gap-4 py-3">
    <a href={localizedPath(HOME_PAGE_SLUG, locale)} class="shrink-0">
      <Image
        src={logo}
        alt={strings.navigation.homeLinkLabel}
        height={LOGO_LARGEST_HEIGHT_PX}
        densities={[1, 2]}
        loading="eager"
        class="h-12 w-auto md:h-16"
      />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <SiteNavigation
        locale={locale}
        currentPageSlug={pageSlug}
        layout="inline"
      />
      <LanguageSwitcher locale={locale} pageSlug={pageSlug} />
    </div>

    <details class="md:hidden">
      <summary class="font-heading text-navy border-navy cursor-pointer list-none rounded-full border-2 px-4 py-2 font-bold">
        {strings.navigation.menuToggle}
      </summary>
      <div class="bg-paper border-mist absolute inset-x-0 top-full z-10 border-b px-4 pt-2 pb-6 shadow-lg">
        <SiteNavigation
          locale={locale}
          currentPageSlug={pageSlug}
          layout="stacked"
        />
        <div class="border-mist mt-4 border-t pt-4">
          <LanguageSwitcher locale={locale} pageSlug={pageSlug} />
        </div>
      </div>
    </details>
  </Container>
</header>
