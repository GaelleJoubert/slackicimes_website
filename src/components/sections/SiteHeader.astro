---
import type { Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import { SITE_NAME } from "../../lib/site";
import Container from "../ui/Container.astro";
import LanguageSwitcher from "../ui/LanguageSwitcher.astro";
import type { HeaderTone } from "./header-tone";
import MobileMenu from "./MobileMenu.astro";
import SiteNavigation from "./SiteNavigation.astro";

interface Props {
  locale: Locale;
  pageSlug: string;
  tone: HeaderTone;
}

const HOME_PAGE_SLUG = "";

const TONE_CLASSES: Record<HeaderTone, { header: string; wordmark: string }> = {
  light: { header: "bg-snow border-rule border-b", wordmark: "text-slate" },
  dark: { header: "bg-slate", wordmark: "text-snow" },
};

const { locale, pageSlug, tone } = Astro.props;
const strings = uiStrings(locale);
const toneClasses = TONE_CLASSES[tone];
---

<header class:list={["sticky top-0 z-30", toneClasses.header]}>
  <Container class="flex items-center justify-between gap-4 py-3 lg:py-4">
    <a
      href={localizedPath(HOME_PAGE_SLUG, locale)}
      aria-label={strings.navigation.homeLinkLabel}
      class:list={[
        "card-title flex h-12 shrink-0 items-center lg:h-16",
        toneClasses.wordmark,
      ]}
    >
      {SITE_NAME}
    </a>

    <div class="hidden items-center gap-2 lg:flex">
      <SiteNavigation
        locale={locale}
        currentPageSlug={pageSlug}
        layout="inline"
        tone={tone}
      />
      <LanguageSwitcher locale={locale} pageSlug={pageSlug} tone={tone} />
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <LanguageSwitcher locale={locale} pageSlug={pageSlug} tone={tone} />
      <MobileMenu locale={locale} pageSlug={pageSlug} tone={tone} />
    </div>
  </Container>
</header>
