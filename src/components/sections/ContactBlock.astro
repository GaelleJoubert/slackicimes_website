---
import type { Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import ContactDetails from "../ui/ContactDetails.astro";
import Container from "../ui/Container.astro";
import LinkButton from "../ui/LinkButton.astro";

interface Props {
  text: string;
  locale: Locale;
}

const { text, locale } = Astro.props;
const strings = uiStrings(locale);
---

<section class="pb-section">
  <Container>
    <div class="bg-paper border-mist rounded-card md:rounded-photo shadow-raised shadow-mist grid items-center gap-block border-3 p-card md:grid-cols-2">
      <div class="flex flex-col gap-stack">
        <h2 class="section-title">{strings.contactBlock.title}</h2>
        <p class="font-bold">{text}</p>
        <LinkButton
          href={localizedPath("contact", locale)}
          variant="primary"
          class="md:self-start"
        >
          {strings.contactBlock.writeUsButton}
        </LinkButton>
      </div>
      <div class="bg-cloud rounded-card p-tile md:rounded-3xl">
        <ContactDetails locale={locale} layout="grid" />
      </div>
    </div>
  </Container>
</section>
