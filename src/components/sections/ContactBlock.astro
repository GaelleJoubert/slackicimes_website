---
import type { Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import ContactDetails from "../ui/ContactDetails.astro";
import Container from "../ui/Container.astro";
import LinkButton from "../ui/LinkButton.astro";

interface Props {
  text: string;
  locale: Locale;
}

const { text, locale } = Astro.props;
const strings = uiStrings(locale);
---

<section class="pb-14 md:pb-28">
  <Container>
    <div class="bg-sky text-ink shadow-raised shadow-coral grid items-center gap-6 rounded-4xl p-6 md:grid-cols-2 md:gap-12 md:p-14">
      <div class="flex flex-col gap-4">
        <h2 class="section-title text-ink">{strings.contactBlock.title}</h2>
        <p class="font-bold">{text}</p>
        <LinkButton
          href={localizedPath("contact", locale)}
          variant="primary"
          class="md:self-start"
        >
          {strings.contactBlock.writeUsButton}
        </LinkButton>
      </div>
      <div class="bg-paper rounded-card p-5 md:rounded-3xl md:p-8">
        <ContactDetails locale={locale} layout="grid" />
      </div>
    </div>
  </Container>
</section>
