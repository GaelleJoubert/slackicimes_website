---
import type { Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import ContactDetails from "../ui/ContactDetails.astro";
import LinkButton from "../ui/LinkButton.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  locale: Locale;
}

const CONTACT_PAGE_SLUG = "contact";

const { locale } = Astro.props;
const strings = uiStrings(locale);
---

<Section tone="mist">
  <SectionHeading title={strings.contactBlock.title} />
  <ContactDetails locale={locale} layout="row" />
  <div class="mt-8">
    <LinkButton href={localizedPath(CONTACT_PAGE_SLUG, locale)}>
      {strings.contactBlock.writeUsButton}
    </LinkButton>
  </div>
</Section>
