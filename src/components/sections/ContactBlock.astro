---
import type { Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import {
  CONTACT_EMAIL,
  CONTACT_PEOPLE,
  POSTAL_ADDRESS_LINES,
} from "../../lib/site";
import LinkButton from "../ui/LinkButton.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  locale: Locale;
}

const CONTACT_PAGE_SLUG = "contact";

const { locale } = Astro.props;
const strings = uiStrings(locale);
---

<Section tone="mist">
  <SectionHeading title={strings.contactBlock.title} />
  <div class="grid gap-8 sm:grid-cols-3">
    <div>
      <h3 class="subsection-title">{strings.contactBlock.phoneHeading}</h3>
      <ul class="mt-2 space-y-1">
        {CONTACT_PEOPLE.map((person) => (
          <li>
            {person.firstName}{" "}
            <a
              href={`tel:${person.internationalPhone}`}
              class="text-teal underline-offset-4 hover:underline"
            >
              {person.displayPhone}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="subsection-title">{strings.contactBlock.emailHeading}</h3>
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="text-teal mt-2 inline-block underline-offset-4 hover:underline"
      >
        {CONTACT_EMAIL}
      </a>
    </div>
    <div>
      <h3 class="subsection-title">{strings.contactBlock.addressHeading}</h3>
      <address class="mt-2 not-italic">
        {POSTAL_ADDRESS_LINES.map((line) => (
          <span class="block">{line}</span>
        ))}
      </address>
    </div>
  </div>
  <div class="mt-8">
    <LinkButton href={localizedPath(CONTACT_PAGE_SLUG, locale)}>
      {strings.contactBlock.writeUsButton}
    </LinkButton>
  </div>
</Section>
