---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n/locales";
import { uiStrings } from "../../i18n/ui";
import Container from "../ui/Container.astro";
import SectionIntro from "../ui/SectionIntro.astro";
import TestimonialCarousel from "./TestimonialCarousel.astro";

interface Props {
  testimonials: CollectionEntry<"testimonials">[];
  locale: Locale;
}

const { testimonials, locale } = Astro.props;
const strings = uiStrings(locale);
---

<section class="py-section">
  <Container class="flex flex-col gap-block">
    <SectionIntro title={strings.testimonials.title} align="center">
      <p class="text-slate font-bold">{strings.testimonials.intro}</p>
    </SectionIntro>
    <TestimonialCarousel testimonials={testimonials} locale={locale} />
  </Container>
</section>
