---
import type { ImageMetadata } from "astro";
import type { Locale } from "../../../i18n/locales";
import { uiStrings } from "../../../i18n/ui";
import { ROUND_ICON_BUTTON_CLASSES } from "../../ui/button-styles";
import ChevronIcon from "../../ui/ChevronIcon.astro";
import CourseSlide from "../../ui/CourseSlide.astro";

interface CarouselCourse {
  href: string;
  name: string;
  duration: string;
  price: string;
  image: ImageMetadata;
  imageFocusClass: string;
}

interface Props {
  courses: CarouselCourse[];
  locale: Locale;
  class?: string;
}

const { courses, locale, class: extraClasses } = Astro.props;
const strings = uiStrings(locale);
---

<div
  data-course-carousel
  role="region"
  aria-roledescription={strings.common.carouselRoleDescription}
  aria-label={strings.home.courseCarouselLabel}
  class:list={["mx-auto flex w-full max-w-76 flex-col gap-3", extraClasses]}
>
  <ul
    data-course-track
    class="flex snap-x snap-mandatory gap-4 overflow-x-auto"
  >
    {courses.map((course) => (
      <li class="w-full shrink-0 snap-start">
        <CourseSlide {...course} />
      </li>
    ))}
  </ul>
  <div data-course-controls hidden>
    <div class="flex items-center justify-between gap-3">
      <button
        type="button"
        data-course-previous
        aria-label={strings.home.previousCourseButton}
        class={ROUND_ICON_BUTTON_CLASSES}
      >
        <ChevronIcon direction="left" />
      </button>
      <ol aria-hidden="true" class="flex items-center gap-2">
        {courses.map(() => (
          <li
            data-course-dot
            class="bg-mist data-active:bg-navy size-2.5 rounded-full transition-colors"
          />
        ))}
      </ol>
      <button
        type="button"
        data-course-next
        aria-label={strings.home.nextCourseButton}
        class={ROUND_ICON_BUTTON_CLASSES}
      >
        <ChevronIcon direction="right" />
      </button>
    </div>
  </div>
</div>

<script>
  import { wrapPageIndex } from "../../../lib/pagination";

  function requireElement<Found extends Element>(
    carousel: Element,
    selector: string,
  ): Found {
    const element = carousel.querySelector<Found>(selector);
    if (!element) {
      throw new Error(`Course carousel is missing "${selector}".`);
    }
    return element;
  }

  function setUpCourseCarousel(carousel: HTMLElement) {
    const track = requireElement<HTMLElement>(carousel, "[data-course-track]");
    const slides = [...track.children] as HTMLElement[];
    const dots = [
      ...carousel.querySelectorAll<HTMLElement>("[data-course-dot]"),
    ];

    const slideStep = () =>
      slides[0].offsetWidth + parseFloat(getComputedStyle(track).columnGap);
    const currentSlideIndex = () => Math.round(track.scrollLeft / slideStep());

    function showSlide(slideIndex: number) {
      const targetIndex = wrapPageIndex(slideIndex, slides.length);
      track.scrollTo({ left: targetIndex * slideStep(), behavior: "smooth" });
    }

    function highlightCurrentDot() {
      const activeIndex = currentSlideIndex();
      dots.forEach((dot, dotIndex) => {
        dot.toggleAttribute("data-active", dotIndex === activeIndex);
      });
    }

    requireElement(carousel, "[data-course-previous]").addEventListener(
      "click",
      () => showSlide(currentSlideIndex() - 1),
    );
    requireElement(carousel, "[data-course-next]").addEventListener(
      "click",
      () => showSlide(currentSlideIndex() + 1),
    );
    track.addEventListener("scroll", highlightCurrentDot, { passive: true });
    requireElement<HTMLElement>(carousel, "[data-course-controls]").hidden =
      false;
    highlightCurrentDot();
  }

  document
    .querySelectorAll<HTMLElement>("[data-course-carousel]")
    .forEach(setUpCourseCarousel);
</script>
