---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../../i18n/locales";
import { localizedPath } from "../../../i18n/routes";
import { uiStrings } from "../../../i18n/ui";
import Container from "../../ui/Container.astro";
import FramedPicture from "../../ui/FramedPicture.astro";
import SectionIntro from "../../ui/SectionIntro.astro";

interface Props {
  teaser: CollectionEntry<"home">["data"]["associationTeaser"];
  locale: Locale;
}

const PHOTO_WIDTHS = [600, 1200];
const PHOTO_SIZES = "(min-width: 768px) 700px, 100vw";

const { teaser, locale } = Astro.props;
const strings = uiStrings(locale);
---

<section class="py-section">
  <Container class="grid items-center gap-block md:grid-cols-12">
    <div class="md:col-span-5">
      <SectionIntro title={strings.navigation.association}>
        {teaser.paragraphs.map((paragraph) => (
          <p class="text-graphite">{paragraph}</p>
        ))}
        <a
          href={localizedPath("association", locale)}
          class="text-link self-start"
        >
          {strings.home.discoverTeamButton}
        </a>
      </SectionIntro>
    </div>
    <div class="md:col-span-7">
      <FramedPicture
        image={teaser.illustration.image}
        alt={teaser.illustration.alt}
        widths={PHOTO_WIDTHS}
        sizes={PHOTO_SIZES}
        class="h-60 md:h-120"
      />
    </div>
  </Container>
</section>
