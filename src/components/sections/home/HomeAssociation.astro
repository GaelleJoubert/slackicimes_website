---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../../i18n/locales";
import { localizedPath } from "../../../i18n/routes";
import { uiStrings } from "../../../i18n/ui";
import Container from "../../ui/Container.astro";
import FramedPicture from "../../ui/FramedPicture.astro";
import LinkButton from "../../ui/LinkButton.astro";
import SectionIntro from "../../ui/SectionIntro.astro";

interface Props {
  teaser: CollectionEntry<"home">["data"]["associationTeaser"];
  locale: Locale;
}

const PHOTO_WIDTHS = [600, 1200];
const PHOTO_SIZES = "(min-width: 768px) 600px, 100vw";

const { teaser, locale } = Astro.props;
const strings = uiStrings(locale);
---

<section class="py-14 md:py-28">
  <Container class="grid items-center gap-7 md:grid-cols-2 md:gap-18">
    <div class="pr-2.5 md:pr-0">
      <FramedPicture
        image={teaser.illustration.image}
        alt={teaser.illustration.alt}
        widths={PHOTO_WIDTHS}
        sizes={PHOTO_SIZES}
        frame="offsetMist"
        class="h-60 md:h-110"
      />
    </div>
    <SectionIntro title={strings.navigation.association}>
      {teaser.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <LinkButton
        href={localizedPath("association", locale)}
        variant="secondary"
        class="md:self-start"
      >
        {strings.home.discoverTeamButton}
      </LinkButton>
    </SectionIntro>
  </Container>
</section>
