---
import type { CollectionEntry } from "astro:content";
import { entrySlug } from "../../../i18n/content";
import { LOCALE_SETTINGS, type Locale } from "../../../i18n/locales";
import { localizedPath } from "../../../i18n/routes";
import { uiStrings } from "../../../i18n/ui";
import { formatPriceInEuros } from "../../../lib/format";
import Container from "../../ui/Container.astro";
import CourseCard from "../../ui/CourseCard.astro";
import FramedPicture from "../../ui/FramedPicture.astro";
import LinkButton from "../../ui/LinkButton.astro";

interface Props {
  teaser: CollectionEntry<"home">["data"]["stagesTeaser"];
  stages: CollectionEntry<"stages">[];
  locale: Locale;
}

const PHOTO_WIDTHS = [600, 1200];
const PHOTO_SIZES = "600px";
const THUMBNAIL_WIDTHS = [160, 320, 480];
const THUMBNAIL_SIZES = "160px";

const { teaser, stages, locale } = Astro.props;
const strings = uiStrings(locale);
const stagesPagePath = localizedPath("stages-highline", locale);
const languageTag = LOCALE_SETTINGS[locale].htmlLang;
const hasUnpairedLastStage = stages.length % 2 === 1;
const isUnpairedOnMobile = (stageIndex: number) =>
  hasUnpairedLastStage && stageIndex === stages.length - 1;
---

<section class="bg-blush py-8 md:py-26">
  <Container class="flex flex-col gap-4 md:gap-12">
    <div class="split-centered-grid title-thumbnail-grid grid items-center gap-x-4 gap-y-4 md:grid-cols-2 md:gap-x-18">
      <h2 class="section-title md:row-start-2">{teaser.title}</h2>
      <div class="pr-2 pb-2 md:hidden">
        <FramedPicture
          image={teaser.mobileThumbnail.image}
          alt={teaser.mobileThumbnail.alt}
          widths={THUMBNAIL_WIDTHS}
          sizes={THUMBNAIL_SIZES}
          frame="offsetCoral"
          class="h-24 w-40"
        />
      </div>
      <div class="hidden md:col-start-2 md:row-span-4 md:row-start-1 md:block">
        <FramedPicture
          image={teaser.illustration.image}
          alt={teaser.illustration.alt}
          widths={PHOTO_WIDTHS}
          sizes={PHOTO_SIZES}
          frame="offsetCoral"
          class="h-105"
        />
      </div>
      <div class="col-span-2 flex flex-col gap-4 md:col-span-1 md:row-start-3 md:gap-5">
        {teaser.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <div class="hidden flex-wrap gap-3.5 md:flex">
          <LinkButton href={stagesPagePath}>
            {strings.home.discoverStagesButton}
          </LinkButton>
        </div>
      </div>
    </div>
    <ul class="grid grid-cols-2 gap-2.5 md:grid-cols-5 md:gap-4">
      {stages.map((stage, stageIndex) => (
        <li
          class:list={[
            isUnpairedOnMobile(stageIndex) && "col-span-2 md:col-span-1",
          ]}
        >
          <CourseCard
            href={`${stagesPagePath}#${entrySlug(stage.id)}`}
            name={stage.data.name}
            duration={stage.data.duration}
            level={stage.data.level}
            price={formatPriceInEuros(stage.data.priceInEuros, languageTag)}
            mobileLayout={isUnpairedOnMobile(stageIndex) ? "row" : "tile"}
          />
        </li>
      ))}
    </ul>
    <p class="text-navy hidden text-center font-bold md:block">
      {teaser.datesNote}
    </p>
    <LinkButton href={stagesPagePath} class="md:hidden">
      {strings.home.discoverStagesButton}
    </LinkButton>
  </Container>
</section>
