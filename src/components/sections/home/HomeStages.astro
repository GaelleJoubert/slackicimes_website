---
import type { CollectionEntry } from "astro:content";
import { entrySlug } from "../../../i18n/content";
import { LOCALE_SETTINGS, type Locale } from "../../../i18n/locales";
import { localizedPath } from "../../../i18n/routes";
import { uiStrings } from "../../../i18n/ui";
import { formatPriceInEuros } from "../../../lib/format";
import Carousel from "../../ui/Carousel.astro";
import CarouselSlide from "../../ui/CarouselSlide.astro";
import Container from "../../ui/Container.astro";
import CourseCard from "../../ui/CourseCard.astro";
import CourseSlide from "../../ui/CourseSlide.astro";
import FramedPicture from "../../ui/FramedPicture.astro";
import LinkButton from "../../ui/LinkButton.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import { STAGE_IMAGE_FOCUS_CLASSES } from "../stages/stage-image-focus";

interface Props {
  teaser: CollectionEntry<"home">["data"]["stagesTeaser"];
  stages: CollectionEntry<"stages">[];
  locale: Locale;
}

const PHOTO_WIDTHS = [600, 1200];
const PHOTO_SIZES = "600px";

const { teaser, stages, locale } = Astro.props;
const strings = uiStrings(locale);
const stagesPagePath = localizedPath("stages-highline", locale);
const languageTag = LOCALE_SETTINGS[locale].htmlLang;
const courses = stages.map((stage) => ({
  stage,
  href: `${stagesPagePath}#${entrySlug(stage.id)}`,
  price: formatPriceInEuros(stage.data.priceInEuros, languageTag),
}));
---

<section class="bg-blush py-section">
  <Container class="flex flex-col gap-block">
    <div class="grid items-center gap-block md:grid-cols-2">
      <SectionIntro title={teaser.title}>
        {teaser.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <div class="gap-inline hidden flex-wrap md:flex">
          <LinkButton href={stagesPagePath}>
            {strings.home.discoverStagesButton}
          </LinkButton>
        </div>
      </SectionIntro>
      <div class="hidden md:block">
        <FramedPicture
          image={teaser.illustration.image}
          alt={teaser.illustration.alt}
          widths={PHOTO_WIDTHS}
          sizes={PHOTO_SIZES}
          frame="offsetCoral"
          class="h-105"
        />
      </div>
    </div>
    <Carousel
      label={strings.home.courseCarouselLabel}
      roleDescription={strings.common.carouselRoleDescription}
      previousLabel={strings.home.previousCourseButton}
      nextLabel={strings.home.nextCourseButton}
      class="md:hidden"
    >
      {courses.map(({ stage, href, price }) => (
        <CarouselSlide class="pr-card-shadow pb-card-shadow">
          <CourseSlide
            href={href}
            name={stage.data.name}
            duration={stage.data.duration}
            price={price}
            image={stage.data.image}
            imageFocusClass={STAGE_IMAGE_FOCUS_CLASSES[stage.data.imageFocus]}
          />
        </CarouselSlide>
      ))}
    </Carousel>
    <ul class="gap-grid hidden md:grid md:grid-cols-5">
      {courses.map(({ stage, href, price }) => (
        <li>
          <CourseCard
            href={href}
            name={stage.data.name}
            details={`${stage.data.duration} · ${stage.data.level}`}
            price={price}
          />
        </li>
      ))}
    </ul>
    <p class="text-navy hidden text-center font-bold md:block">
      {teaser.datesNote}
    </p>
    <LinkButton href={stagesPagePath} class="md:hidden">
      {strings.home.discoverStagesButton}
    </LinkButton>
  </Container>
</section>
