---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../../i18n/locales";
import { localizedPath } from "../../../i18n/routes";
import { uiStrings } from "../../../i18n/ui";
import Carousel from "../../ui/Carousel.astro";
import CarouselSlide from "../../ui/CarouselSlide.astro";
import Container from "../../ui/Container.astro";
import HighlightedText from "../../ui/HighlightedText.astro";
import LinkButton from "../../ui/LinkButton.astro";
import PhotoSlide from "../../ui/PhotoSlide.astro";
import PhotoStrip from "../../ui/PhotoStrip.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import { FESTIVAL_NAME_HIGHLIGHT } from "../../../lib/site";

interface Props {
  teaser: CollectionEntry<"home">["data"]["festivalTeaser"];
  gallery: CollectionEntry<"galleries">;
  locale: Locale;
}

const { teaser, gallery, locale } = Astro.props;
const strings = uiStrings(locale);
---

<section class="bg-navy text-paper py-14 md:py-26">
  <Container class="flex flex-col gap-6 md:gap-12">
    <div class="max-w-190">
      <SectionIntro title={strings.navigation.winterFestislack} theme="dark">
        <HighlightedText
          slot="title"
          text={strings.navigation.winterFestislack}
          highlight={FESTIVAL_NAME_HIGHLIGHT}
        />
        {teaser.paragraphs.map((paragraph) => (
          <p class="text-cloud">{paragraph}</p>
        ))}
        <div class="hidden md:block">
          <LinkButton href={localizedPath("winter-festislack", locale)}>
            {strings.common.learnMore}
          </LinkButton>
        </div>
      </SectionIntro>
    </div>
    <div class="hidden md:block">
      <PhotoStrip photos={gallery.data.photos} />
    </div>
    <Carousel
      label={strings.home.festivalCarouselLabel}
      roleDescription={strings.common.carouselRoleDescription}
      previousLabel={strings.common.previousPhotoButton}
      nextLabel={strings.common.nextPhotoButton}
      slideCount={gallery.data.photos.length}
      tone="dark"
      class="md:hidden"
    >
      {gallery.data.photos.map((photo) => (
        <CarouselSlide>
          <PhotoSlide {...photo} />
        </CarouselSlide>
      ))}
    </Carousel>
    <LinkButton
      href={localizedPath("winter-festislack", locale)}

      class="md:hidden"
    >
      {strings.common.learnMore}
    </LinkButton>
  </Container>
</section>
