---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../../i18n/locales";
import { localizedPath } from "../../../i18n/routes";
import { splitDisplayHeading } from "../../../lib/heading";
import { withSectionAnchor } from "../../../lib/url";
import ActionBadge from "../../ui/ActionBadge.astro";
import Container from "../../ui/Container.astro";
import Eyebrow from "../../ui/Eyebrow.astro";

type HomeContent = CollectionEntry<"home">["data"];
type HighlightTone = HomeContent["highlights"][number]["tone"];

interface Props {
  heading: string;
  hero: HomeContent["hero"];
  highlights: HomeContent["highlights"];
  locale: Locale;
}

type PhotoFraming = HomeContent["hero"]["photos"][number]["framing"];

const PHOTO_WIDTHS = [400, 800, 1200, 1600];
const PHOTO_SIZES = "(min-width: 768px) 400px, 100vw";
const ZOOMED_PHOTO_SIZES = "(min-width: 768px) 1200px, 150vw";

const FRAMING_CLASSES: Record<PhotoFraming, string> = {
  fill: "",
  zoomFromTop: "origin-top scale-150",
};

const HIGHLIGHT_TONE_CLASSES: Record<
  HighlightTone,
  { card: string; frame: string }
> = {
  coral: { card: "bg-blush", frame: "shadow-navy" },
  sky: { card: "bg-ice", frame: "shadow-sky" },
  mist: { card: "bg-cloud", frame: "shadow-mist" },
  cloud: { card: "bg-cloud", frame: "shadow-mist" },
  ice: { card: "bg-ice", frame: "shadow-sky" },
};

const { heading, hero, highlights, locale } = Astro.props;
const headingParts = splitDisplayHeading(heading);
const hasOnePhotoAndHighlightPerPart =
  headingParts.length === hero.photos.length &&
  headingParts.length === highlights.length;
if (!hasOnePhotoAndHighlightPerPart) {
  throw new Error(
    `The home hero needs one photo and one highlight per heading part: "${heading}" has ${headingParts.length} parts, hero.photos has ${hero.photos.length} images and highlights has ${highlights.length} entries.`,
  );
}
const highlightHref = (highlight: HomeContent["highlights"][number]) =>
  withSectionAnchor(
    localizedPath(highlight.pageSlug, locale),
    highlight.sectionId,
  );
const panels = headingParts.map((part, partIndex) => ({
  ...part,
  photo: hero.photos[partIndex],
  href: highlights[partIndex] && highlightHref(highlights[partIndex]),
  needsSpaceBefore: part.startsNewWord && partIndex > 0,
  isMobileCover: partIndex === 0,
  frameClass:
    highlights[partIndex] &&
    HIGHLIGHT_TONE_CLASSES[highlights[partIndex].tone].frame,
}));
---

<section class="pt-4 md:pt-8">
  <Container class="flex flex-col gap-4 md:gap-7">
    <h1 class="font-heading text-paper grid gap-3 uppercase md:grid-cols-3 md:gap-6">
      {panels.map((panel) => (
        <>
          {panel.needsSpaceBefore ? " " : ""}
          <span
            class:list={[
              "group rounded-card md:rounded-photo shadow-raised relative overflow-hidden md:block md:h-115",
              panel.frameClass,
              panel.isMobileCover ? "block h-88" : "hidden",
            ]}
          >
            {panel.photo && (
              <Picture
                src={panel.photo.image}
                alt=""
                widths={PHOTO_WIDTHS}
                sizes={
                  panel.photo.framing === "zoomFromTop"
                    ? ZOOMED_PHOTO_SIZES
                    : PHOTO_SIZES
                }
                formats={["avif", "webp"]}
                loading={panel.isMobileCover ? "eager" : "lazy"}
                class:list={[
                  "absolute inset-0 size-full object-cover transition duration-300 group-hover:brightness-110",
                  panel.isMobileCover && "object-upper md:object-center",
                  FRAMING_CLASSES[panel.photo.framing],
                ]}
              />
            )}
            {panel.isMobileCover && (
              <span class="text-cover-title text-shadow-raised absolute inset-x-0 top-6 px-4 text-center md:hidden">
                {heading}
              </span>
            )}
            <span class="text-shadow-raised absolute inset-x-0 top-7 hidden text-center text-5xl md:block">
              {panel.text}
            </span>
            {/* Duplicates the highlight link below, so it stays out of the tab order and the accessibility tree. */}
            {panel.href && (
              <a
                href={panel.href}
                aria-hidden="true"
                tabindex="-1"
                class="absolute inset-0 hidden md:block"
              />
            )}
            {panel.href && (
              <span class="absolute right-5 bottom-5 hidden md:block">
                <ActionBadge icon="chevron" />
              </span>
            )}
          </span>
        </>
      ))}
    </h1>
    <ul class="mt-2 grid gap-2.5 md:grid-cols-3 md:gap-6">
      {highlights.map((highlight) => {
        const toneClasses = HIGHLIGHT_TONE_CLASSES[highlight.tone];
        return (
          <li>
            <a
              href={highlightHref(highlight)}
              class:list={[
                "group border-navy rounded-card flex min-h-16 items-center justify-between gap-3 border-3 px-4 py-3 md:items-start md:border-0 md:bg-transparent md:p-2",
                toneClasses.card,
              ]}
            >
              <span class="flex flex-col gap-1.5">
                <Eyebrow tone={highlight.tone}>{highlight.eyebrow}</Eyebrow>
                <span class="card-title md:group-hover:text-teal md:text-3xl">
                  {highlight.title}
                </span>
                <span class="text-slate hidden text-base md:block">
                  {highlight.text}
                </span>
              </span>
              <ActionBadge icon="chevron" class="md:hidden" />
            </a>
          </li>
        );
      })}
    </ul>
  </Container>
</section>
