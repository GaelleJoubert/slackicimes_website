---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Container from "../../ui/Container.astro";
import Eyebrow from "../../ui/Eyebrow.astro";
import HighlightedText from "../../ui/HighlightedText.astro";
import Skyline from "../../ui/Skyline.astro";

interface Props {
  heading: string;
  hero: CollectionEntry<"home">["data"]["hero"];
}

const PHOTO_WIDTHS = [640, 1024, 1600, 2400];
const PHOTO_SIZES = "100vw";

const { heading, hero } = Astro.props;
---

<section
  aria-labelledby="hero-title"
  class="text-snow relative h-160 overflow-hidden md:h-215"
>
  <Picture
    src={hero.illustration.image}
    alt={hero.illustration.alt}
    widths={PHOTO_WIDTHS}
    sizes={PHOTO_SIZES}
    formats={["avif", "webp"]}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 size-full object-high object-cover"
  />
  <div
    aria-hidden="true"
    class="to-slate/55 absolute inset-0 bg-linear-to-b from-transparent from-60%"
  ></div>
  <Container class="relative flex h-full flex-col items-end justify-end gap-stack pb-24 text-right md:pb-36">
    <Eyebrow tone="photo" class="self-end">
      {hero.eyebrow}
    </Eyebrow>
    <h1
      id="hero-title"
      class="font-heading flex flex-col items-end text-2xl leading-none font-medium tracking-tight md:text-4xl"
    >
      <HighlightedText
        text={heading}
        highlight={hero.titleEmphasis}
        highlightClass="text-display-sm md:text-hero"
      />
    </h1>
  </Container>
  <Skyline variant="edge" fill="forest" hasInnerRidge />
</section>
