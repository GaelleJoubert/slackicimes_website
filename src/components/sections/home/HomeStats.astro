---
import type { CollectionEntry } from "astro:content";
import Container from "../../ui/Container.astro";
import KeyFactsBand from "../../ui/KeyFactsBand.astro";

interface Props {
  label: string;
  stats: CollectionEntry<"home">["data"]["stats"];
}

const { label, stats } = Astro.props;
---

<section aria-label={label} class="snap-align-none py-section">
  <Container>
    <KeyFactsBand facts={stats} />
  </Container>
</section>
