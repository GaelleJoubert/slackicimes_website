---
import "@fontsource-variable/inter";
import { Picture } from "astro:assets";
import type { Locale } from "../../../i18n/locales";
import { localizedPath } from "../../../i18n/routes";
import { uiStrings } from "../../../i18n/ui";
import { WORLD_CUP_SECTION_IDS } from "../../../lib/world-cup";
import Container from "../../ui/Container.astro";
import LinkButton from "../../ui/LinkButton.astro";
import type { WorldCupContent } from "../world-cup/types";

interface Props {
  heading: string;
  hero: WorldCupContent["hero"];
  locale: Locale;
}

const LOGO_HEIGHT_PX = 76;
const POSTER_WIDTHS = [400, 800];
const POSTER_SIZES = "(min-width: 768px) 400px, 82vw";
const TITLE_ID = "coupe-du-monde";

const { heading, hero, locale } = Astro.props;
const strings = uiStrings(locale);
const worldCupPath = localizedPath("coupe-du-monde", locale);
---

<section
  aria-labelledby={TITLE_ID}
  class="bg-cup-navy font-cup border-cup-pink border-b-5 py-12 text-white md:border-b-6 md:py-24"
>
  <Container class="grid items-center gap-5 md:grid-cols-5 md:gap-16">
    <div class="flex flex-col gap-5 md:col-span-3 md:gap-6.5">
      <div class="flex flex-col gap-5 md:flex-row md:flex-wrap md:items-center md:gap-4.5">
        <Picture
          src={hero.logo.image}
          alt={hero.logo.alt}
          height={LOGO_HEIGHT_PX}
          densities={[1, 2]}
          formats={["avif", "webp"]}
          class="h-15 w-auto self-start md:h-19"
        />
        <span class="text-cup-sky cup-eyebrow">{hero.badge}</span>
      </div>
      <div>
        <p class="font-display text-xl font-semibold tracking-widest uppercase md:text-2xl">
          {hero.kicker}
        </p>
        <h2 id={TITLE_ID} class="cup-title">
          {heading}
        </h2>
        <span class="bg-cup-pink font-display mt-3 inline-block rounded-xl px-4 py-2 text-xl leading-none font-bold uppercase md:rounded-2xl md:px-5 md:py-2.5 md:text-2xl">
          {hero.tag}
        </span>
      </div>
      <p class="text-cup-pale max-w-xl md:text-lg">{hero.intro}</p>
      <dl class="flex flex-wrap gap-x-7 gap-y-2.5 md:gap-x-10">
        {hero.facts.map((fact) => (
          <div class="flex flex-col">
            <dt class="text-cup-sky text-sm font-semibold tracking-wider uppercase">
              {fact.label}
            </dt>
            <dd class="font-display text-lg font-semibold md:text-2xl">
              {fact.value}
            </dd>
          </div>
        ))}
      </dl>
      <div class="hidden flex-wrap gap-3.5 md:flex">
        <LinkButton href={worldCupPath} variant="cupPrimary">
          {strings.common.discoverWorldCupButton}
        </LinkButton>
        <LinkButton
          href={`${worldCupPath}#${WORLD_CUP_SECTION_IDS.participate}`}
          variant="cupOutlineLight"
        >
          {hero.secondaryCta}
        </LinkButton>
      </div>
    </div>
    <div class="flex justify-center md:col-span-2">
      <Picture
        src={hero.poster.image}
        alt={hero.poster.alt}
        widths={POSTER_WIDTHS}
        sizes={POSTER_SIZES}
        formats={["avif", "webp"]}
        class="my-2 w-4/5 max-w-100 rotate-2 rounded-2xl shadow-2xl md:my-0 md:w-full"
      />
    </div>
    <div class="flex flex-col gap-3 md:hidden">
      <LinkButton href={worldCupPath} variant="cupPrimary">
        {strings.common.discoverWorldCupButton}
      </LinkButton>
      <LinkButton
        href={`${worldCupPath}#${WORLD_CUP_SECTION_IDS.participate}`}
        variant="cupOutlineLight"
      >
        {hero.secondaryCta}
      </LinkButton>
    </div>
  </Container>
</section>
