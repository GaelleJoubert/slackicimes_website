---
import type { Locale } from "../../i18n/locales";
import { uiStrings } from "../../i18n/ui";
import type { HeaderTone } from "./header-tone";
import SiteNavigation from "./SiteNavigation.astro";
import { roundIconButtonClasses } from "../ui/button-styles";

interface Props {
  locale: Locale;
  pageSlug: string;
  tone: HeaderTone;
}

const { locale, pageSlug, tone } = Astro.props;
const strings = uiStrings(locale);
---

<details data-animated-details class="group">
  <summary
    aria-label={strings.navigation.menuToggle}
    class:list={["size-11 list-none", roundIconButtonClasses(tone)]}
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      class="size-5 group-open:hidden"
    >
      <path d="M3 5h14M3 10h14M3 15h14" />
    </svg>
    <svg
      aria-hidden="true"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      class="hidden size-5 group-open:block"
    >
      <path d="M5 5l10 10M15 5L5 15" />
    </svg>
  </summary>
  <div data-expand-panel class="absolute inset-x-0 top-full z-20">
    <div class="bg-paper border-navy border-b-3 px-4 pt-2 pb-6">
      <SiteNavigation
        locale={locale}
        currentPageSlug={pageSlug}
        layout="stacked"
        tone="light"
      />
    </div>
  </div>
</details>

<script>
  import { enhanceAnimatedDetails } from "../ui/expand-animation";

  enhanceAnimatedDetails();
</script>
