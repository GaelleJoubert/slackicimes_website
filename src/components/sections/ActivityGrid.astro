---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import ImageCard from "../ui/ImageCard.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  activities: CollectionEntry<"association">["data"]["activities"];
  locale: Locale;
}

const { activities, locale } = Astro.props;
const strings = uiStrings(locale);

function activityLink(pageSlug: string | undefined) {
  if (!pageSlug) {
    return undefined;
  }
  return {
    href: localizedPath(pageSlug, locale),
    label: strings.common.learnMore,
  };
}
---

<Section>
  <SectionHeading title={activities.title} intro={activities.intro} />
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {activities.items.map((activity) => (
      <li>
        <ImageCard
          image={activity.illustration.image}
          imageAlt={activity.illustration.alt}
          title={activity.title}
          link={activityLink(activity.pageSlug)}
        >
          <p>{activity.text}</p>
        </ImageCard>
      </li>
    ))}
  </ul>
</Section>
