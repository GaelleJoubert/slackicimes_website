---
import { render, type CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import Container from "../ui/Container.astro";
import QuoteCard from "../ui/QuoteCard.astro";

interface Props {
  testimonial: CollectionEntry<"testimonials">;
  locale: Locale;
}

const { testimonial, locale } = Astro.props;
const strings = uiStrings(locale);
const { Content } = await render(testimonial);
---

<section class="py-14 md:py-26">
  <Container>
    <div class="mx-auto flex max-w-240 flex-col items-center gap-6">
      <QuoteCard
        author={testimonial.data.author}
        context={testimonial.data.stageName}
        tone="coral"
        class="shadow-drop md:shadow-drop-lg w-full"
      >
        <Content />
      </QuoteCard>
      <a
        href={localizedPath("livre-d-or", locale)}
        class="text-teal font-extrabold underline underline-offset-4"
      >
        {strings.testimonials.readAllLink}
      </a>
    </div>
  </Container>
</section>
