---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../../i18n/locales";
import { uiStrings } from "../../../i18n/ui";
import Carousel from "../../ui/Carousel.astro";
import CarouselSlide from "../../ui/CarouselSlide.astro";
import Container from "../../ui/Container.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import YouthDayCard, { type DayTone } from "./YouthDayCard.astro";

type ProgramItem =
  CollectionEntry<"stages">["data"]["program"]["items"][number];

interface Props {
  title: string;
  intro: string;
  days: ProgramItem[];
  locale: Locale;
}

const DEFAULT_DAY_TONE: DayTone = {
  card: "bg-blush",
  label: "coral",
  title: "text-navy",
};

const DAY_TONE_CYCLE: DayTone[] = [
  DEFAULT_DAY_TONE,
  { card: "bg-ice", label: "sky", title: "text-navy" },
  { card: "bg-cloud", label: "mist", title: "text-navy" },
  { card: "bg-navy text-paper", label: "coralOnDark", title: "text-paper" },
];

const { title, intro, days, locale } = Astro.props;
const strings = uiStrings(locale);
const toneAt = (dayIndex: number): DayTone =>
  DAY_TONE_CYCLE[dayIndex % DAY_TONE_CYCLE.length] ?? DEFAULT_DAY_TONE;
---

<section class="py-10 md:py-26">
  <Container class="flex flex-col gap-4 md:gap-9">
    <div class="max-w-190">
      <SectionIntro title={title}>
        <p class="text-slate">{intro}</p>
      </SectionIntro>
    </div>
    <Carousel
      label={title}
      roleDescription={strings.common.carouselRoleDescription}
      previousLabel={strings.youthStages.previousDayButton}
      nextLabel={strings.youthStages.nextDayButton}
      width="full"
      class="md:hidden"
    >
      {days.map((day, dayIndex) => (
        <CarouselSlide>
          <YouthDayCard day={day} tone={toneAt(dayIndex)} />
        </CarouselSlide>
      ))}
    </Carousel>
    <ul class="hidden gap-4 md:grid md:grid-cols-2 lg:grid-cols-4">
      {days.map((day, dayIndex) => (
        <li>
          <YouthDayCard day={day} tone={toneAt(dayIndex)} />
        </li>
      ))}
    </ul>
  </Container>
</section>
