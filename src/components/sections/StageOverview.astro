---
import type { CollectionEntry } from "astro:content";
import { entrySlug } from "../../i18n/content";
import type { Locale } from "../../i18n/locales";
import { uiStrings } from "../../i18n/ui";
import ImageCard from "../ui/ImageCard.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  stages: CollectionEntry<"stages">[];
  locale: Locale;
}

const { stages, locale } = Astro.props;
const strings = uiStrings(locale);
---

<Section tone="mist">
  <SectionHeading
    title={strings.stages.formulasTitle}
    intro={strings.stages.formulasIntro}
  />
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {stages.map((stage) => (
      <li>
        <ImageCard
          image={stage.data.image}
          imageAlt={stage.data.imageAlt}
          title={stage.data.name}
          meta={`${stage.data.duration} · ${stage.data.level}`}
          link={{
            href: `#${entrySlug(stage.id)}`,
            label: strings.common.learnMore,
          }}
        >
          <p>{stage.data.summary}</p>
        </ImageCard>
      </li>
    ))}
  </ul>
</Section>
