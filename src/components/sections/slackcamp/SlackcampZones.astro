---
import type { CollectionEntry } from "astro:content";
import Container from "../../ui/Container.astro";
import Skyline from "../../ui/Skyline.astro";
import SlackcampZoneCard from "./SlackcampZoneCard.astro";

interface Props {
  zones: CollectionEntry<"slackcamp">["data"]["zones"];
}

const DIVIDER_PROFILES = ["pourri", "casse"] as const;

const { zones } = Astro.props;
const lastZoneIndex = zones.items.length - 1;
---

<section class="pb-section" aria-label={zones.title}>
  <Container>
    <ul class="gap-grid flex flex-col md:grid md:grid-cols-3">
      {zones.items.map((zone, zoneIndex) => (
        <li>
          <SlackcampZoneCard zone={zone} audienceLabel={zones.audienceLabel} />
          {zoneIndex < lastZoneIndex && (
            <Skyline
              variant="divider"
              profile={DIVIDER_PROFILES[zoneIndex % DIVIDER_PROFILES.length]}
              isThin
              class="mt-grid md:hidden"
            />
          )}
        </li>
      ))}
    </ul>
  </Container>
</section>
