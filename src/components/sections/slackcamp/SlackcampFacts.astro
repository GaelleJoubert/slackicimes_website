---
import type { CollectionEntry } from "astro:content";
import Container from "../../ui/Container.astro";
import Stat from "../../ui/Stat.astro";

interface Props {
  label: string;
  facts: NonNullable<CollectionEntry<"pages">["data"]["keyFacts"]>;
}

const { label, facts } = Astro.props;
---

<section aria-label={label} class="bg-forest text-snow py-6">
  <Container>
    <dl class="gap-grid grid grid-cols-2 md:grid-cols-3 md:text-center">
      {facts.map((fact) => (
        <Stat value={fact.value} label={fact.label} />
      ))}
    </dl>
  </Container>
</section>
