---
import { render, type CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n/locales";
import { uiStrings } from "../../i18n/ui";
import {
  estimatedTextHeight,
  largestFittingTextSize,
  pairMatchingItems,
  testimonialParagraphs,
  type TextBox,
  type TextSizeCandidate,
} from "../../lib/testimonial";
import { ROUND_ICON_BUTTON_CLASSES } from "../ui/button-styles";
import ChevronIcon from "../ui/ChevronIcon.astro";
import QuoteCard, {
  type QuoteTextSize,
  type QuoteTone,
} from "../ui/QuoteCard.astro";

interface Props {
  testimonials: CollectionEntry<"testimonials">[];
  locale: Locale;
}

const QUOTE_TONES: QuoteTone[] = ["coral", "ice"];
// Text boxes of the 375px wide mobile cards: min-h-104 minus padding, quote mark and a two line author row.
const REGULAR_TEXT_BOX: TextBox = { heightPx: 256, paragraphGapPx: 12 };
const COMPACT_TEXT_BOX: TextBox = { heightPx: 94, paragraphGapPx: 12 };
const HUGE: TextSizeCandidate<QuoteTextSize> = {
  name: "huge",
  charactersPerLine: 21,
  lineHeightPx: 32,
};
const EXTRA_LARGE: TextSizeCandidate<QuoteTextSize> = {
  name: "extraLarge",
  charactersPerLine: 27,
  lineHeightPx: 28,
};
const LARGE: TextSizeCandidate<QuoteTextSize> = {
  name: "large",
  charactersPerLine: 31,
  lineHeightPx: 28,
};
const BASE: TextSizeCandidate<QuoteTextSize> = {
  name: "base",
  charactersPerLine: 34,
  lineHeightPx: 24,
};
const SMALL: TextSizeCandidate<QuoteTextSize> = {
  name: "small",
  charactersPerLine: 41,
  lineHeightPx: 20,
};
const REGULAR_TEXT_SIZES = [HUGE, EXTRA_LARGE, LARGE, BASE, SMALL];
const COMPACT_TEXT_SIZES = [LARGE, BASE, SMALL];

const { testimonials, locale } = Astro.props;
const allStrings = uiStrings(locale);
const strings = allStrings.testimonials;
const cards = await Promise.all(
  testimonials.map(async (testimonial) => {
    const paragraphs = testimonialParagraphs(testimonial.body ?? "");
    return {
      testimonial,
      paragraphs,
      fitsCompactCard:
        estimatedTextHeight(
          paragraphs,
          SMALL,
          COMPACT_TEXT_BOX.paragraphGapPx,
        ) <= COMPACT_TEXT_BOX.heightPx,
      Content: (await render(testimonial)).Content,
    };
  }),
);

type Card = (typeof cards)[number];

function sharedTextSize(
  group: Card[],
  candidatesFromLargest: TextSizeCandidate<QuoteTextSize>[],
  box: TextBox,
): QuoteTextSize {
  const fittingIndexes = group.map((card) => {
    const fittingSize = largestFittingTextSize(
      card.paragraphs,
      candidatesFromLargest,
      box,
    );
    return candidatesFromLargest.findIndex(
      (candidate) => candidate.name === fittingSize,
    );
  });
  return candidatesFromLargest[Math.max(...fittingIndexes)].name;
}

function withAlternatingTones<Item>(groups: Item[][]) {
  let cardIndex = 0;
  return groups.map((group) =>
    group.map((item) => ({
      ...item,
      tone: QUOTE_TONES[cardIndex++ % QUOTE_TONES.length],
    })),
  );
}

const sizedGroups = pairMatchingItems(
  cards,
  (card) => card.fitsCompactCard,
).map((group) => {
  const isPair = group.length > 1;
  const textSize = isPair
    ? sharedTextSize(group, COMPACT_TEXT_SIZES, COMPACT_TEXT_BOX)
    : sharedTextSize(group, REGULAR_TEXT_SIZES, REGULAR_TEXT_BOX);
  const density = isPair ? ("compact" as const) : ("regular" as const);
  return group.map((card) => ({ ...card, density, textSize }));
});
const slides = withAlternatingTones(sizedGroups);
---

<div
  data-testimonial-carousel
  role="region"
  aria-roledescription={allStrings.common.carouselRoleDescription}
  aria-label={strings.carouselLabel}
  class="flex flex-col gap-5.5 md:gap-9"
>
  <ul
    aria-live="polite"
    class="grid min-h-104 gap-5 md:min-h-120 md:grid-cols-2 md:gap-10"
  >
    {slides.map((slideCards) => (
      <li data-carousel-slide class="flex flex-col gap-3 md:gap-5">
        {slideCards.map(({ testimonial, tone, density, textSize, Content }) => (
          <QuoteCard
            author={testimonial.data.author}
            context={testimonial.data.stageName}
            tone={tone}
            density={density}
            textSize={textSize}
            class="shadow-drop md:shadow-drop-lg flex-1"
          >
            <Content />
          </QuoteCard>
        ))}
      </li>
    ))}
  </ul>
  <div data-carousel-controls hidden>
    <div class="flex items-center gap-3.5 md:gap-6">
      <button
        type="button"
        data-carousel-previous
        aria-label={strings.previousButton}
        class={ROUND_ICON_BUTTON_CLASSES}
      >
        <ChevronIcon direction="left" />
      </button>
      <div class="flex flex-1 flex-col items-center gap-1.5 md:flex-row md:gap-6">
        <div aria-hidden="true" class="relative h-3 w-full md:h-4 md:flex-1">
          <span class="bg-mist absolute inset-x-1.5 top-1 h-1 rounded-full md:inset-x-2 md:top-1.5" />
          <span
            data-carousel-progress
            class="bg-coral absolute inset-x-1.5 top-1 h-1 origin-left scale-x-0 rounded-full transition-transform md:inset-x-2 md:top-1.5"
          />
          <span class="bg-navy absolute top-0 left-0 size-3 rounded-full md:size-4" />
          <span class="bg-navy absolute top-0 right-0 size-3 rounded-full md:size-4" />
        </div>
        <p
          data-carousel-page-label
          class="text-navy text-sm font-extrabold tabular-nums md:text-base"
        />
      </div>
      <button
        type="button"
        data-carousel-next
        aria-label={strings.nextButton}
        class={ROUND_ICON_BUTTON_CLASSES}
      >
        <ChevronIcon direction="right" />
      </button>
    </div>
  </div>
</div>

<script>
  import {
    isOnPage,
    pageCount,
    pageLabel,
    wrapPageIndex,
  } from "../../lib/pagination";

  const DESKTOP_MEDIA_QUERY = "(min-width: 48rem)";
  const SLIDES_PER_PAGE_ON_MOBILE = 1;
  const SLIDES_PER_PAGE_ON_DESKTOP = 2;

  function requireElement<Found extends Element>(
    carousel: Element,
    selector: string,
  ): Found {
    const element = carousel.querySelector<Found>(selector);
    if (!element) {
      throw new Error(`Testimonial carousel is missing "${selector}".`);
    }
    return element;
  }

  function setUpCarousel(carousel: HTMLElement) {
    const slides = [
      ...carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"),
    ];
    const controls = requireElement<HTMLElement>(
      carousel,
      "[data-carousel-controls]",
    );
    const progress = requireElement<HTMLElement>(
      carousel,
      "[data-carousel-progress]",
    );
    const label = requireElement<HTMLElement>(
      carousel,
      "[data-carousel-page-label]",
    );
    const desktopQuery = window.matchMedia(DESKTOP_MEDIA_QUERY);
    let currentPageIndex = 0;

    const slidesPerPage = () =>
      desktopQuery.matches
        ? SLIDES_PER_PAGE_ON_DESKTOP
        : SLIDES_PER_PAGE_ON_MOBILE;

    function showPage(pageIndex: number) {
      const perPage = slidesPerPage();
      const totalPages = pageCount(slides.length, perPage);
      currentPageIndex = wrapPageIndex(pageIndex, totalPages);
      slides.forEach((slide, slideIndex) => {
        slide.hidden = !isOnPage(slideIndex, currentPageIndex, perPage);
      });
      label.textContent = pageLabel(currentPageIndex, totalPages);
      progress.style.scale = `${(currentPageIndex + 1) / totalPages} 1`;
    }

    requireElement(carousel, "[data-carousel-previous]").addEventListener(
      "click",
      () => showPage(currentPageIndex - 1),
    );
    requireElement(carousel, "[data-carousel-next]").addEventListener(
      "click",
      () => showPage(currentPageIndex + 1),
    );
    desktopQuery.addEventListener("change", () => showPage(0));
    controls.hidden = false;
    showPage(0);
  }

  document
    .querySelectorAll<HTMLElement>("[data-testimonial-carousel]")
    .forEach(setUpCarousel);
</script>
