---
import type { Locale } from "../../i18n/locales";
import {
  FOOTER_CONTACT_LINKS,
  FOOTER_SITE_LINKS,
  type NavigationItem,
} from "../../i18n/navigation";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import { CONTACT_EMAIL, SITE_NAME, SOCIAL_PROFILES } from "../../lib/site";
import Container from "../ui/Container.astro";
import Skyline from "../ui/Skyline.astro";

interface Props {
  locale: Locale;
}

interface FooterLink {
  href: string;
  label: string;
}

const { locale } = Astro.props;
const strings = uiStrings(locale);
const currentYear = new Date().getFullYear();

const toFooterLink = (item: NavigationItem): FooterLink => ({
  href: localizedPath(item.pageSlug, locale),
  label: strings.navigation[item.labelKey],
});

const linkColumns = [
  {
    spansFullWidthOnPhones: false,
    heading: strings.footer.siteHeading,
    links: FOOTER_SITE_LINKS.map(toFooterLink),
  },
  {
    spansFullWidthOnPhones: true,
    heading: strings.footer.contactHeading,
    links: [
      { href: `mailto:${CONTACT_EMAIL}`, label: CONTACT_EMAIL },
      ...FOOTER_CONTACT_LINKS.map(toFooterLink),
    ],
  },
  {
    spansFullWidthOnPhones: false,
    heading: strings.footer.followUsHeading,
    links: SOCIAL_PROFILES.map((profile) => ({
      href: profile.url,
      label: profile.name,
    })),
  },
];
---

<footer class="bg-slate text-snow relative isolate mt-auto overflow-hidden">
  <Skyline variant="background" profiles={["crete"]} tone="dark" isMirrored />
  <Container class="gap-block grid pt-18 pb-10 md:grid-cols-4">
    <div class="flex flex-col gap-3">
      <p class="font-heading text-3xl font-voice md:text-4xl">{SITE_NAME}</p>
      <p class="text-sage text-sm md:text-base">{strings.footer.tagline}</p>
    </div>
    <div class="grid grid-cols-2 gap-6 md:col-span-3 md:grid-cols-3 md:gap-8">
      {linkColumns.map((column) => (
        <div
          class:list={[
            column.spansFullWidthOnPhones &&
              "order-last col-span-2 md:order-none md:col-span-1",
          ]}
        >
          <h2 class="label-text text-sage">{column.heading}</h2>
          <ul class="mt-3 flex flex-col gap-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sage transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Container>
  <Container>
    <p class="text-sage py-6 text-sm">
      © {currentYear} {SITE_NAME}
    </p>
  </Container>
</footer>
