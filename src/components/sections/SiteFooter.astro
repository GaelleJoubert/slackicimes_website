---
import type { Locale } from "../../i18n/locales";
import {
  FOOTER_CONTACT_LINKS,
  FOOTER_SITE_LINKS,
  type NavigationItem,
} from "../../i18n/navigation";
import { localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import { CONTACT_EMAIL, SITE_NAME, SOCIAL_PROFILES } from "../../lib/site";
import Container from "../ui/Container.astro";

interface Props {
  locale: Locale;
}

interface FooterLink {
  href: string;
  label: string;
}

const { locale } = Astro.props;
const strings = uiStrings(locale);
const currentYear = new Date().getFullYear();

const toFooterLink = (item: NavigationItem): FooterLink => ({
  href: localizedPath(item.pageSlug, locale),
  label: strings.navigation[item.labelKey],
});

const linkColumns = [
  {
    spansFullWidthOnPhones: false,
    heading: strings.footer.siteHeading,
    links: FOOTER_SITE_LINKS.map(toFooterLink),
  },
  {
    spansFullWidthOnPhones: true,
    heading: strings.footer.contactHeading,
    links: [
      { href: `mailto:${CONTACT_EMAIL}`, label: CONTACT_EMAIL },
      ...FOOTER_CONTACT_LINKS.map(toFooterLink),
    ],
  },
  {
    spansFullWidthOnPhones: false,
    heading: strings.footer.followUsHeading,
    links: SOCIAL_PROFILES.map((profile) => ({
      href: profile.url,
      label: profile.name,
    })),
  },
];
---

<footer class="bg-ink text-paper relative mt-auto">
  <svg
    aria-hidden="true"
    viewBox="0 0 100 10"
    preserveAspectRatio="none"
    class="fill-ink absolute bottom-full left-0 h-9 w-full md:h-15"
  >
    <path d="M0 0 Q 50 20 100 0 L100 10 L0 10 Z" />
  </svg>
  <Container class="grid gap-8 py-8 md:grid-cols-4 md:pb-10">
    <div class="flex flex-col gap-1 md:gap-3">
      <p class="font-heading text-3xl md:text-4xl">{SITE_NAME}</p>
      <p class="text-mist text-sm md:text-base">{strings.footer.tagline}</p>
    </div>
    <div class="grid grid-cols-2 gap-6 md:col-span-3 md:grid-cols-3 md:gap-8">
      {linkColumns.map((column) => (
        <div
          class:list={[
            column.spansFullWidthOnPhones &&
              "order-last col-span-2 md:order-none md:col-span-1",
          ]}
        >
          <h2 class="text-coral font-extrabold">{column.heading}</h2>
          <ul class="mt-2 flex flex-col gap-2 font-bold">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-coral transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Container>
  <p class="border-navy text-mist border-t py-4 text-center text-sm">
    © {currentYear} {SITE_NAME}
  </p>
</footer>
