---
import { Picture } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import { getGallery } from "../../i18n/collections";
import type { Locale } from "../../i18n/locales";
import { uiStrings } from "../../i18n/ui";
import ImageGallery from "../ui/ImageGallery.astro";
import Section from "../ui/Section.astro";
import VideoEmbed from "../ui/VideoEmbed.astro";

interface Props {
  edition: CollectionEntry<"festivalEditions">;
  locale: Locale;
  tone: "paper" | "mist";
}

const POSTER_WIDTHS = [320, 640];
const POSTER_SIZES = "(min-width: 768px) 320px, 80vw";

const { edition, locale, tone } = Astro.props;
const {
  title,
  poster,
  posterAlt,
  gallery: gallerySlug,
  galleryTitle,
  videos,
} = edition.data;
const videoTitle = `${title} ${uiStrings(locale).video.videoSuffix}`;
const { Content: Story } = await render(edition);
const gallery = gallerySlug ? await getGallery(gallerySlug, locale) : undefined;
const hasPoster = poster !== undefined && posterAlt !== undefined;
---

<Section tone={tone}>
  <div class:list={["grid items-start gap-8", hasPoster && "md:grid-cols-3"]}>
    <div class="md:col-span-2">
      <h2 class="section-title">{title}</h2>
      <div class="rich-text mt-4">
        <Story />
      </div>
    </div>
    {hasPoster && (
      <Picture
        src={poster}
        alt={posterAlt}
        widths={POSTER_WIDTHS}
        sizes={POSTER_SIZES}
        formats={["avif", "webp"]}
        class="mx-auto w-full max-w-xs rounded-lg shadow-lg"
      />
    )}
  </div>
  {videos.length > 0 && (
    <div class="mt-8 grid items-start gap-6 md:grid-cols-2">
      {videos.map((videoUrl) => (
        <VideoEmbed videoUrl={videoUrl} title={videoTitle} locale={locale} />
      ))}
    </div>
  )}
  {gallery && (
    <div class="mt-10">
      {galleryTitle && <h3 class="subsection-title mb-4">{galleryTitle}</h3>}
      <ImageGallery images={gallery.data.photos} />
    </div>
  )}
</Section>
