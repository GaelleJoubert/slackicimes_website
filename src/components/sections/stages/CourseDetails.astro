---
import type { CollectionEntry } from "astro:content";
import { LOCALE_SETTINGS, type Locale } from "../../../i18n/locales";
import { uiStrings } from "../../../i18n/ui";
import { formatPriceInEuros, lowercaseFirstLetter } from "../../../lib/format";
import { STAGES_REGISTRATION_URL } from "../../../lib/site";
import DotList from "../../ui/DotList.astro";
import FactTile from "../../ui/FactTile.astro";
import LinkButton from "../../ui/LinkButton.astro";
import YouthDayCard, { type DayTone } from "../youth/YouthDayCard.astro";

interface Props {
  stage: CollectionEntry<"stages">;
  locale: Locale;
}

const DEFAULT_DAY_TONE: DayTone = {
  card: "bg-paper",
  label: "coral",
  title: "text-navy",
};

const DAY_TONE_CYCLE: DayTone[] = [
  DEFAULT_DAY_TONE,
  { card: "bg-ice", label: "sky", title: "text-navy" },
  { card: "bg-cloud", label: "mist", title: "text-navy" },
  { card: "bg-navy text-paper", label: "coralOnDark", title: "text-paper" },
];

const { stage, locale } = Astro.props;
const strings = uiStrings(locale);
const {
  name,
  duration,
  level,
  ageRange,
  description,
  program,
  prerequisites,
  dates,
} = stage.data;
const languageTag = LOCALE_SETTINGS[locale].htmlLang;
const formattedPrice = formatPriceInEuros(stage.data.priceInEuros, languageTag);
const isWeekByDay = program.items.some((item) => item.details.length > 0);
const programLines = program.items.map((item) =>
  item.place
    ? `${item.label}, ${lowercaseFirstLetter(item.place, languageTag)}`
    : item.label,
);
const dayToneAt = (dayIndex: number): DayTone =>
  DAY_TONE_CYCLE[dayIndex % DAY_TONE_CYCLE.length] ?? DEFAULT_DAY_TONE;
---

<div
  data-switch-content
  class="bg-blush gap-stack hidden md:flex md:flex-col md:rounded-4xl md:p-card"
>
  <dl class:list={["gap-grid grid", ageRange ? "grid-cols-5" : "grid-cols-4"]}>
    <FactTile
      value={duration}
      label={strings.stages.durationLabel}
      tone="navy"
    />
    <FactTile value={level} label={strings.stages.levelLabel} tone="sky" />
    {ageRange && (
      <FactTile value={ageRange} label={strings.stages.ageLabel} tone="ice" />
    )}
    <FactTile
      value={formattedPrice}
      label={strings.stages.priceHeading}
      tone="coral"
    />
    <FactTile value={dates} label={strings.stages.datesHeading} tone="paper" />
  </dl>
  <div class="gap-block grid grid-cols-2 items-start">
    <div class="gap-stack flex flex-col">
      <p
        aria-hidden="true"
        class="font-heading text-navy text-5xl leading-none"
      >
        {name}
      </p>
      {description.map((paragraph) => (
        <p class="text-justify hyphens-auto">{paragraph}</p>
      ))}
      {!isWeekByDay && (
        <LinkButton href={STAGES_REGISTRATION_URL} class="self-center">
          {strings.stages.registerButton}
          <span class="sr-only">: {name}</span>
        </LinkButton>
      )}
    </div>
    <div class="gap-stack flex flex-col">
      <div class="bg-paper border-mist rounded-card p-tile gap-stack flex flex-col border-3">
        <section class="flex flex-col gap-3">
          <h4 class="subsection-title md:text-3xl">
            {strings.stages.prerequisitesHeading}
          </h4>
          <DotList items={prerequisites} />
        </section>
        {!isWeekByDay && (
          <section class="flex flex-col gap-3">
            <h4 class="subsection-title md:text-3xl">
              {strings.stages.programHeading}
            </h4>
            {program.intro.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <DotList items={programLines} />
          </section>
        )}
      </div>
      {isWeekByDay && (
        <LinkButton href={STAGES_REGISTRATION_URL} class="self-center">
          {strings.stages.registerButton}
          <span class="sr-only">: {name}</span>
        </LinkButton>
      )}
    </div>
  </div>
  {isWeekByDay && (
    <section class="flex flex-col gap-3">
      <h4 class="subsection-title md:text-3xl">
        {strings.stages.typicalWeekHeading}
      </h4>
      {program.intro.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <ul class="gap-grid grid grid-cols-2 lg:grid-cols-4">
        {program.items.map((day, dayIndex) => (
          <li>
            <YouthDayCard
              day={day}
              tone={dayToneAt(dayIndex)}
              density="compact"
              headingTag="h5"
            />
          </li>
        ))}
      </ul>
    </section>
  )}
</div>
