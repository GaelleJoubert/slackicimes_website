---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../../i18n/locales";
import { uiStrings } from "../../../i18n/ui";
import { COURSE_FORMULAS_SECTION_ID } from "../../../lib/site";
import Container from "../../ui/Container.astro";
import Eyebrow from "../../ui/Eyebrow.astro";
import FramedPicture from "../../ui/FramedPicture.astro";
import HighlightedText from "../../ui/HighlightedText.astro";
import LinkButton from "../../ui/LinkButton.astro";
import Skyline from "../../ui/Skyline.astro";

interface Props {
  page: CollectionEntry<"pages">["data"];
  faqSectionId: string;
  locale: Locale;
}

const PHOTO_WIDTHS = [600, 1000];
const PHOTO_SIZES = "(min-width: 768px) 500px, 100vw";

const { page, faqSectionId, locale } = Astro.props;
const strings = uiStrings(locale);
---

<section
  aria-labelledby="page-title"
  class="bg-lichen pt-page-top relative pb-20 md:pb-44"
>
  <Container class="gap-block grid md:grid-cols-12">
    <div class="gap-block flex flex-col justify-between md:col-span-7 md:pb-20">
      <div class="gap-stack flex flex-col">
        {page.eyebrow && <Eyebrow>{page.eyebrow}</Eyebrow>}
        <h1 id="page-title" class="page-title">
          <HighlightedText
            text={page.heading}
            highlight={page.headingAccent ?? ""}
            highlightClass="text-forest italic"
          />
        </h1>
        <div class="lead max-w-140">
          <slot />
        </div>
      </div>
      <div class="gap-stack flex flex-col">
        {page.keyFacts && <Skyline variant="divider" profile="pourri" />}
        {page.keyFacts && (
          <dl
            aria-label={strings.stages.keyFactsLabel}
            class="grid grid-cols-3"
          >
            {page.keyFacts.map((fact) => (
              <div class="flex flex-col gap-1.5 pr-4 pb-2">
                <dt class="label-text text-graphite">{fact.label}</dt>
                <dd class="font-heading text-xl font-voice md:text-3xl">
                  {fact.value}
                </dd>
              </div>
            ))}
          </dl>
        )}
        <div class="gap-inline flex flex-wrap">
          <LinkButton href={`#${COURSE_FORMULAS_SECTION_ID}`}>
            {strings.stages.chooseCourseButton}
          </LinkButton>
          <LinkButton href={`#${faqSectionId}`} variant="secondary">
            {strings.stages.faqButton}
          </LinkButton>
        </div>
      </div>
    </div>
    {page.illustration && (
      <div class="hidden md:col-span-5 md:block">
        <FramedPicture
          image={page.illustration.image}
          alt={page.illustration.alt}
          widths={PHOTO_WIDTHS}
          sizes={PHOTO_SIZES}
          loading="eager"
          class="object-upper h-170"
        />
      </div>
    )}
  </Container>
  <Skyline variant="edge" fill="snow" />
</section>
