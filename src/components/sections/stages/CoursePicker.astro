---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { entrySlug } from "../../../i18n/content";
import { LOCALE_SETTINGS, type Locale } from "../../../i18n/locales";
import { formatPriceInEuros } from "../../../lib/format";
import CourseDetails from "./CourseDetails.astro";
import CourseDetailsCompact from "./CourseDetailsCompact.astro";
import Skyline from "../../ui/Skyline.astro";
import ToggleSign from "../../ui/ToggleSign.astro";
import { STAGE_IMAGE_FOCUS_CLASSES } from "./stage-image-focus";

interface Props {
  stages: CollectionEntry<"stages">[];
  locale: Locale;
}

const THUMBNAIL_WIDTHS = [120, 480];
const THUMBNAIL_SIZES = "(min-width: 768px) 240px, 56px";

const { stages, locale } = Astro.props;
const languageTag = LOCALE_SETTINGS[locale].htmlLang;
const courses = stages.map((stage) => {
  const slug = entrySlug(stage.id);
  return {
    stage,
    slug,
    panelId: `${slug}-details`,
    summary: `${stage.data.duration} · ${formatPriceInEuros(stage.data.priceInEuros, languageTag)}`,
  };
});
---

<div data-course-picker class="gap-grid grid md:relative md:grid-cols-5">
  {courses.map(({ stage, slug, panelId, summary }) => (
    <div
      id={slug}
      data-course
      class="bg-moss rounded-card scroll-mt-4 overflow-hidden md:contents"
    >
      <h3 class="md:row-start-1">
        <button
          type="button"
          aria-expanded="false"
          aria-controls={panelId}
          data-course-toggle
          class="group text-slate md:bg-moss md:rounded-control md:hover:bg-lichen md:aria-expanded:bg-slate md:aria-expanded:text-snow relative flex min-h-19 w-full cursor-pointer items-center gap-3 p-2.5 text-left md:h-full md:flex-col md:items-start md:justify-center md:gap-1 md:px-4.5 md:py-3.5 md:transition"
        >
          <Picture
            src={stage.data.image}
            alt=""
            widths={THUMBNAIL_WIDTHS}
            sizes={THUMBNAIL_SIZES}
            formats={["avif", "webp"]}
            class:list={[
              "rounded-control size-14 shrink-0 object-cover md:hidden",
              STAGE_IMAGE_FOCUS_CLASSES[stage.data.imageFocus],
            ]}
          />
          <span class="flex flex-1 flex-col">
            <span class="card-title group-aria-expanded:scale-110 md:group-aria-expanded:text-snow origin-left text-xl transition-transform duration-300 motion-reduce:transition-none md:group-aria-expanded:scale-100">
              {stage.data.name}
            </span>
            <span class="text-graphite group-aria-expanded:max-h-0 group-aria-expanded:opacity-0 md:group-aria-expanded:text-sage max-h-6 overflow-hidden text-sm transition-all duration-300 motion-reduce:transition-none md:max-h-none md:group-aria-expanded:max-h-none md:group-aria-expanded:opacity-100">
              {summary}
            </span>
          </span>
          <ToggleSign variant="courseTab" class="md:hidden" />
        </button>
      </h3>
      <div
        id={panelId}
        data-course-panel
        hidden="until-found"
        class="md:col-span-5 md:col-start-1 md:row-start-3"
      >
        <CourseDetails stage={stage} locale={locale} />
        <CourseDetailsCompact stage={stage} locale={locale} />
      </div>
    </div>
  ))}
  <div aria-hidden="true" class="hidden md:col-span-5 md:row-start-2 md:block">
    <Skyline variant="divider" />
  </div>
</div>

<script>
  import { collapsePanel, expandPanel } from "../../ui/expand-animation";
  import { crossfadePanels } from "../../ui/slide-animation";

  const DESKTOP_MEDIA_QUERY = "(min-width: 48rem)";

  interface Course {
    root: HTMLElement;
    toggle: HTMLButtonElement;
    panel: HTMLElement;
  }

  function findCourse(root: HTMLElement): Course {
    const toggle = root.querySelector<HTMLButtonElement>(
      "[data-course-toggle]",
    );
    const panel = root.querySelector<HTMLElement>("[data-course-panel]");
    if (!toggle || !panel) {
      throw new Error(`Course "${root.id}" needs a toggle and a panel.`);
    }
    return { root, toggle, panel };
  }

  function setOpen(course: Course, isOpen: boolean): void {
    course.root.toggleAttribute("data-open", isOpen);
    course.toggle.setAttribute("aria-expanded", String(isOpen));
    if (isOpen) {
      course.panel.removeAttribute("hidden");
    } else {
      course.panel.setAttribute("hidden", "until-found");
    }
  }

  const isExpanded = (course: Course) =>
    course.toggle.getAttribute("aria-expanded") === "true";

  async function collapseCourse(course: Course): Promise<void> {
    course.toggle.setAttribute("aria-expanded", "false");
    await collapsePanel(course.panel);
    if (isExpanded(course)) return;
    setOpen(course, false);
  }

  async function expandCourse(course: Course): Promise<void> {
    setOpen(course, true);
    await expandPanel(course.panel);
  }

  function initCoursePicker(picker: HTMLElement): void {
    const courses = [
      ...picker.querySelectorAll<HTMLElement>("[data-course]"),
    ].map(findCourse);
    const desktopQuery = window.matchMedia(DESKTOP_MEDIA_QUERY);
    const isDesktop = () => desktopQuery.matches;
    const openOnly = (target: Course) =>
      courses.forEach((course) => setOpen(course, course === target));
    const openCourse = () =>
      courses.find((course) => course.root.hasAttribute("data-open"));

    async function switchDesktopCourse(target: Course): Promise<void> {
      const current = openCourse();
      if (current === target) return;
      if (!current) {
        openOnly(target);
        return;
      }
      await crossfadePanels(current.panel, target.panel, () =>
        openOnly(target),
      );
    }

    courses.forEach((course) => {
      course.toggle.addEventListener("click", async () => {
        if (isDesktop()) {
          await switchDesktopCourse(course);
          return;
        }
        if (isExpanded(course)) {
          await collapseCourse(course);
          return;
        }
        courses
          .filter((other) => other !== course && isExpanded(other))
          .forEach((other) => void collapseCourse(other));
        await expandCourse(course);
        course.toggle.scrollIntoView({ block: "nearest", behavior: "smooth" });
      });
      course.panel.addEventListener("beforematch", () => {
        openOnly(course);
      });
    });

    const openFromHash = () => {
      const target = courses.find(
        (course) => `#${course.root.id}` === window.location.hash,
      );
      if (!target) return;
      openOnly(target);
      target.toggle.scrollIntoView({ block: "start" });
    };
    const openFirstOnDesktop = () => {
      const hasOpenCourse = courses.some((course) =>
        course.root.hasAttribute("data-open"),
      );
      if (isDesktop() && !hasOpenCourse) openOnly(courses[0]);
    };
    openFromHash();
    openFirstOnDesktop();
    window.addEventListener("hashchange", openFromHash);
    desktopQuery.addEventListener("change", openFirstOnDesktop);
  }

  document
    .querySelectorAll<HTMLElement>("[data-course-picker]")
    .forEach(initCoursePicker);
</script>
