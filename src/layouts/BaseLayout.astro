---
import { SITE_INDEXABLE } from "astro:env/server";
import CompactFooter from "../components/sections/CompactFooter.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";
import SiteHeader from "../components/sections/SiteHeader.astro";
import type { HeaderTone } from "../components/sections/header-tone";
import "../styles/global.css";
import { LOCALE_SETTINGS, type Locale } from "../i18n/locales";
import {
  buildAlternateLinks,
  isUnlistedPage,
  localizedPath,
} from "../i18n/routes";
import { uiStrings } from "../i18n/ui";
import { absoluteUrl, robotsDirective } from "../lib/seo";
import { SITE_NAME } from "../lib/site";
import {
  buildOrganizationSchema,
  buildWebSiteSchema,
} from "../lib/structured-data";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pageSlug: string;
  isErrorPage?: boolean;
  headerTone?: HeaderTone;
  footer?: FooterVariant;
}

type FooterVariant = "full" | "compact";

const {
  title,
  description,
  locale,
  pageSlug,
  isErrorPage = false,
  headerTone = "light",
  footer = "full",
} = Astro.props;
const localeSettings = LOCALE_SETTINGS[locale];
const canonicalUrl = absoluteUrl(localizedPath(pageSlug, locale));
const alternateLinks = isErrorPage ? [] : buildAlternateLinks(pageSlug);
const structuredData = [buildWebSiteSchema(), buildOrganizationSchema()];
const strings = uiStrings(locale);
const isIndexable = SITE_INDEXABLE && !isErrorPage && !isUnlistedPage(pageSlug);
---

<!doctype html>
<html lang={localeSettings.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsDirective(isIndexable)} />
    {!isErrorPage && <link rel="canonical" href={canonicalUrl} />}
    {alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={localeSettings.openGraphLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="bg-paper text-ink font-body flex min-h-screen flex-col text-base leading-relaxed antialiased md:text-lg">
    <a
      href="#main-content"
      class="bg-navy text-paper sr-only rounded-xl px-4 py-2 font-extrabold focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-30"
    >
      {strings.accessibility.skipToContent}
    </a>
    <SiteHeader locale={locale} pageSlug={pageSlug} tone={headerTone} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    {footer === "compact" ? <CompactFooter /> : <SiteFooter locale={locale} />}
  </body>
</html>
