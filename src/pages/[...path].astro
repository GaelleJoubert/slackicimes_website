---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  localizedPath,
  parseContentId,
  toRestRouteParam,
} from "../i18n/routes";

export const getStaticPaths = (async () => {
  const pages = await getCollection("pages");
  return pages.map((page) => {
    const { locale, pageSlug } = parseContentId(page.id);
    return {
      params: { path: toRestRouteParam(localizedPath(pageSlug, locale)) },
      props: { page, locale, pageSlug },
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, locale, pageSlug } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={pageSlug}
>
  <main class="mx-auto max-w-3xl px-4 py-8 md:py-12">
    <h1 class="text-3xl font-bold md:text-4xl">{page.data.heading}</h1>
    <Content />
  </main>
</BaseLayout>
