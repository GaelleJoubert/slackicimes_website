---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import ContactBlock from "../../components/sections/ContactBlock.astro";
import FeatureBlock from "../../components/sections/FeatureBlock.astro";
import FestivalGallery from "../../components/sections/FestivalGallery.astro";
import HomeHighlights from "../../components/sections/HomeHighlights.astro";
import TestimonialsSection from "../../components/sections/TestimonialsSection.astro";
import {
  getLocalizedCollection,
  getPageEntry,
  getSingleEntryContent,
} from "../../i18n/collections";
import { buildLocaleStaticPaths, localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const HOME_PAGE_SLUG = "";

const { locale } = Astro.props;
const strings = uiStrings(locale);
const page = await getPageEntry(HOME_PAGE_SLUG, locale);
const { highlights, stagesTeaser, festivalTeaser } = (
  await getSingleEntryContent("home", locale)
).data;
const { origin } = (await getSingleEntryContent("association", locale)).data;
const testimonials = await getLocalizedCollection("testimonials", locale);
const festivalPhotos = await getLocalizedCollection("festivalPhotos", locale);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={HOME_PAGE_SLUG}
>
  <HomeHighlights
    heading={page.data.heading}
    highlights={highlights}
    locale={locale}
  />

  <FeatureBlock
    title={strings.navigation.association}
    paragraphs={origin.paragraphs}
    illustration={origin.illustration}
    link={{
      href: localizedPath("association", locale),
      label: strings.common.learnMore,
    }}
    tone="mist"
  />

  <FeatureBlock
    title={stagesTeaser.title}
    paragraphs={stagesTeaser.paragraphs}
    illustration={stagesTeaser.illustration}
    imageSide="end"
    link={{
      href: localizedPath("stages-highline", locale),
      label: strings.common.learnMore,
    }}
  />

  <FeatureBlock
    title={festivalTeaser.title}
    paragraphs={festivalTeaser.paragraphs}
    link={{
      href: localizedPath("winter-festislack", locale),
      label: strings.common.learnMore,
    }}
    tone="mist"
  >
    <div class="mt-8">
      <FestivalGallery photos={festivalPhotos} />
    </div>
  </FeatureBlock>

  <TestimonialsSection testimonials={testimonials} locale={locale} />

  <ContactBlock locale={locale} />
</BaseLayout>
