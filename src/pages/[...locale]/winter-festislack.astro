---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import Container from "../../components/ui/Container.astro";
import FramedPicture from "../../components/ui/FramedPicture.astro";
import HighlightedText from "../../components/ui/HighlightedText.astro";
import LinkButton from "../../components/ui/LinkButton.astro";
import PhotoStrip from "../../components/ui/PhotoStrip.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import SlacklineDivider from "../../components/ui/SlacklineDivider.astro";
import {
  getGallery,
  getPageEntry,
  getSingleEntryContent,
} from "../../i18n/collections";
import { buildLocaleStaticPaths, localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FESTIVAL_NAME_HIGHLIGHT } from "../../lib/site";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const PAGE_SLUG = "winter-festislack";
const PAST_EDITIONS_PAGE_SLUG = "anciennes-editions-winter-festislack";
const POSTER_WIDTHS = [480, 960];
const POSTER_SIZES = "(min-width: 768px) 480px, 100vw";

const { locale } = Astro.props;
const strings = uiStrings(locale);
const page = await getPageEntry(PAGE_SLUG, locale);
const { Content: Intro } = await render(page);
const { announcement } = (await getSingleEntryContent("festival", locale)).data;
const festivalGallery = await getGallery("festival", locale);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={PAGE_SLUG}
  headerTone="dark"
>
  <section class="bg-navy text-paper pt-6 pb-12 md:pt-12 md:pb-24">
    <Container class="flex flex-col gap-4 md:gap-12">
      <div class="grid gap-4 md:grid-cols-2 md:items-end md:gap-16">
        <h1 class="page-title text-paper lg:text-hero">
          <HighlightedText
            text={page.data.heading}
            highlight={FESTIVAL_NAME_HIGHLIGHT}
          />
        </h1>
        <div class="intro-text intro-text-on-dark">
          <Intro />
        </div>
      </div>
      <PhotoStrip photos={festivalGallery.data.photos} loading="eager" />
    </Container>
  </section>

  <SlacklineDivider backgroundTone="navy" fillTone="paper" />

  <section class="bg-paper pt-10 pb-14 md:pt-18 md:pb-28">
    <Container class="grid items-center gap-4 md:grid-cols-5 md:gap-16">
      <div class="md:col-span-3">
        <SectionIntro title={announcement.title}>
          {announcement.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <div class="flex flex-col gap-3 md:flex-row md:flex-wrap md:gap-3.5">
            <LinkButton href={localizedPath("coupe-du-monde", locale)}>
              {strings.common.discoverWorldCupButton}
            </LinkButton>
            <LinkButton
              href={localizedPath(PAST_EDITIONS_PAGE_SLUG, locale)}
              variant="secondary"
            >
              {strings.festival.pastEditionsButton}
            </LinkButton>
          </div>
        </SectionIntro>
      </div>
      <div class="pr-2 md:col-span-2 md:pr-0">
        <FramedPicture
          image={announcement.poster.image}
          alt={announcement.poster.alt}
          widths={POSTER_WIDTHS}
          sizes={POSTER_SIZES}
          frame="offsetNavy"
          class="h-auto"
        />
      </div>
    </Container>
  </section>
</BaseLayout>
