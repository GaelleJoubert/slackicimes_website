---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import FeatureBlock from "../../components/sections/FeatureBlock.astro";
import PhotoGallery from "../../components/sections/PhotoGallery.astro";
import Section from "../../components/ui/Section.astro";
import {
  getGallery,
  getPageEntry,
  getSingleEntryContent,
} from "../../i18n/collections";
import { buildLocaleStaticPaths, localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const PAGE_SLUG = "winter-festislack";
const PAST_EDITIONS_PAGE_SLUG = "anciennes-editions-winter-festislack";

const { locale } = Astro.props;
const strings = uiStrings(locale);
const page = await getPageEntry(PAGE_SLUG, locale);
const { Content: Intro } = await render(page);
const { announcement } = (await getSingleEntryContent("festival", locale)).data;
const festivalGallery = await getGallery("festival", locale);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={PAGE_SLUG}
>
  <Section>
    <h1 class="page-title">{page.data.heading}</h1>
    <div class="rich-text mt-6 mb-8 max-w-2xl text-lg">
      <Intro />
    </div>
    <PhotoGallery gallery={festivalGallery} />
  </Section>

  <FeatureBlock
    title={announcement.title}
    paragraphs={announcement.paragraphs}
    illustration={announcement.poster}
    imageShape="portrait"
    imageSide="end"
    link={{
      href: localizedPath(PAST_EDITIONS_PAGE_SLUG, locale),
      label: strings.festival.pastEditionsButton,
    }}
    tone="mist"
  />
</BaseLayout>
