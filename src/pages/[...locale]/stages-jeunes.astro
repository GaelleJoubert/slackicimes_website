---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import YouthWeek from "../../components/sections/youth/YouthWeek.astro";
import Carousel from "../../components/ui/Carousel.astro";
import CarouselSlide from "../../components/ui/CarouselSlide.astro";
import Container from "../../components/ui/Container.astro";
import FramedPicture from "../../components/ui/FramedPicture.astro";
import KeyFactsBand from "../../components/ui/KeyFactsBand.astro";
import LinkButton from "../../components/ui/LinkButton.astro";
import PhotoMosaic from "../../components/ui/PhotoMosaic.astro";
import PhotoSlide from "../../components/ui/PhotoSlide.astro";
import {
  getGallery,
  getLocalizedCollection,
  getPageEntry,
} from "../../i18n/collections";
import { entrySlug } from "../../i18n/content";
import { LOCALE_SETTINGS } from "../../i18n/locales";
import { buildLocaleStaticPaths, localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPriceInEuros } from "../../lib/format";
import { STAGES_REGISTRATION_URL } from "../../lib/site";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const PAGE_SLUG = "stages-jeunes";
const YOUTH_STAGE_SLUG = "stage-jeunes";
const HERO_IMAGE_WIDTHS = [600, 1200];
const HERO_IMAGE_SIZES = "(min-width: 768px) 600px, 100vw";
const WEEK_INTRO_PARAGRAPH_INDEX = 1;

const { locale } = Astro.props;
const strings = uiStrings(locale);
const page = await getPageEntry(PAGE_SLUG, locale);
const { Content: Intro } = await render(page);
const stages = await getLocalizedCollection("stages", locale);
const youthStage = stages.find(
  (stage) => entrySlug(stage.id) === YOUTH_STAGE_SLUG,
);
if (!youthStage) {
  throw new Error(
    `Missing stage "${YOUTH_STAGE_SLUG}" in src/content/stages/${locale}/.`,
  );
}
const gallery = await getGallery(YOUTH_STAGE_SLUG, locale);
const { duration, dates, prerequisites, description, program } =
  youthStage.data;
const formattedPrice = formatPriceInEuros(
  youthStage.data.priceInEuros,
  LOCALE_SETTINGS[locale].htmlLang,
);
const weekIntro = description[WEEK_INTRO_PARAGRAPH_INDEX] ?? "";
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={PAGE_SLUG}
  snapSectionsOnMobile
>
  <section class="pt-page-top">
    <Container class="gap-block grid items-center md:grid-cols-2">
      <div class="gap-stack flex flex-col">
        <h1 class="page-title">{page.data.heading}</h1>
        <div class="rich-text md:text-xl">
          <Intro />
        </div>
      </div>
      <FramedPicture
        image={youthStage.data.image}
        alt={youthStage.data.imageAlt}
        widths={HERO_IMAGE_WIDTHS}
        sizes={HERO_IMAGE_SIZES}
        frame="offsetSky"
        loading="eager"
        class="h-48 md:h-110"
      />
    </Container>
  </section>

  <section aria-label={strings.youthStages.keyFactsLabel} class="pt-section">
    <Container class="gap-grid grid md:grid-cols-2">
      {page.data.keyFacts && (
        <div class="md:col-span-2">
          <KeyFactsBand facts={page.data.keyFacts} />
        </div>
      )}
      <LinkButton
        href={localizedPath("inscriptions", locale)}
        class="my-2 md:hidden"
      >
        {strings.stages.registrationsButton}
      </LinkButton>
      <div class="border-mist rounded-card p-card border-3 md:rounded-3xl">
        <h2 class="subsection-title md:text-3xl">
          {strings.stages.prerequisitesHeading}
        </h2>
        <ul class="mt-2.5 flex list-disc flex-col gap-1 pl-5">
          {prerequisites.map((prerequisite) => (
            <li>{prerequisite}</li>
          ))}
        </ul>
      </div>
      <div class="bg-blush rounded-card hidden gap-stack p-card flex-col justify-center md:flex md:rounded-3xl">
        <p class="font-heading text-ink text-2xl md:text-3xl">
          {formattedPrice} {strings.youthStages.pricePerDuration} {duration}
        </p>
        <p class="font-bold">
          {strings.stages.priceNote} {dates}.
        </p>
        <LinkButton href={STAGES_REGISTRATION_URL} class="md:self-start">
          {strings.stages.registerButton}
        </LinkButton>
      </div>
    </Container>
  </section>

  <YouthWeek
    title={strings.youthStages.weekTitle}
    intro={weekIntro}
    days={program.items}
    locale={locale}
  />

  <section class="pb-section">
    <Container class="gap-block flex flex-col">
      <h2 class="section-title">{strings.youthStages.galleryTitle}</h2>
      <div class="hidden md:block">
        <PhotoMosaic photos={gallery.data.photos} />
      </div>
      <Carousel
        label={strings.youthStages.galleryTitle}
        roleDescription={strings.common.carouselRoleDescription}
        previousLabel={strings.common.previousPhotoButton}
        nextLabel={strings.common.nextPhotoButton}
        class="md:hidden"
      >
        {gallery.data.photos.map((photo) => (
          <CarouselSlide>
            <PhotoSlide {...photo} />
          </CarouselSlide>
        ))}
      </Carousel>
    </Container>
  </section>
</BaseLayout>
