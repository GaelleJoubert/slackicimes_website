---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import CalloutCard from "../../components/ui/CalloutCard.astro";
import Container from "../../components/ui/Container.astro";
import FramedPicture from "../../components/ui/FramedPicture.astro";
import LinkButton from "../../components/ui/LinkButton.astro";
import StepList from "../../components/ui/StepList.astro";
import { getPageEntry } from "../../i18n/collections";
import { buildLocaleStaticPaths, localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  COURSE_FORMULAS_SECTION_ID,
  STAGES_REGISTRATION_URL,
} from "../../lib/site";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const PAGE_SLUG = "inscriptions";
const STAGES_PAGE_SLUG = "stages-highline";
const PHOTO_WIDTHS = [500, 1000];
const PHOTO_SIZES = "(min-width: 768px) 460px, 100vw";

const { locale } = Astro.props;
const strings = uiStrings(locale);
const page = await getPageEntry(PAGE_SLUG, locale);
const { Content: Instructions } = await render(page);
const { steps, feature } = page.data;
const stagesPagePath = localizedPath(STAGES_PAGE_SLUG, locale);
const formulasPath = `${stagesPagePath}#${COURSE_FORMULAS_SECTION_ID}`;
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={PAGE_SLUG}
  snapSectionsOnMobile
>
  <section class="pt-page-top pb-section">
    <Container class="registration-grid gap-stack md:gap-block grid md:grid-cols-5">
      <div class="gap-stack flex flex-col md:col-span-3">
        <h1 class="page-title">{page.data.heading}</h1>
        <div class="rich-text md:text-xl">
          <Instructions />
        </div>
        {steps && (
          <StepList
            steps={steps}
            label={strings.stages.registrationStepsLabel}
          />
        )}
      </div>
      <LinkButton
        href={STAGES_REGISTRATION_URL}
        size="large"
        class="md:col-span-3 md:place-self-center"
      >
        {strings.stages.ticketOfficeButton}
      </LinkButton>
      {feature && (
        <div class="mt-3 pr-2 pb-2 md:col-span-2 md:col-start-4 md:row-span-2 md:row-start-1 md:mt-0 md:p-0">
          <FramedPicture
            image={feature.illustration.image}
            alt={feature.illustration.alt}
            widths={PHOTO_WIDTHS}
            sizes={PHOTO_SIZES}
            frame="offsetCoral"
            loading="eager"
            class="object-upper h-52 md:h-130 md:object-center"
          />
        </div>
      )}
      {feature && (
        <div class="mt-6 snap-start md:col-span-5 md:mt-0 md:-mr-3">
          <CalloutCard title={feature.title} paragraphs={feature.paragraphs}>
            <LinkButton
              href={formulasPath}
              variant="secondaryOnDark"
              class="md:hidden"
            >
              {strings.stages.compareFormulasButton}
            </LinkButton>
            <div class="hidden md:block md:justify-self-end">
              <LinkButton href={stagesPagePath} variant="secondaryOnDark">
                {strings.common.learnMore}
              </LinkButton>
            </div>
          </CalloutCard>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>
