---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import PageHero from "../../components/sections/PageHero.astro";
import Container from "../../components/ui/Container.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import LinkButton from "../../components/ui/LinkButton.astro";
import LinkCard from "../../components/ui/LinkCard.astro";
import StepList from "../../components/ui/StepList.astro";
import { getPageEntry } from "../../i18n/collections";
import { buildLocaleStaticPaths, localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withSectionAnchor } from "../../lib/url";
import {
  COURSE_FORMULAS_SECTION_ID,
  STAGES_REGISTRATION_URL,
} from "../../lib/site";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const PAGE_SLUG = "inscriptions";
const STAGES_PAGE_SLUG = "stages-highline";

const { locale } = Astro.props;
const strings = uiStrings(locale);
const page = await getPageEntry(PAGE_SLUG, locale);
const { Content: Instructions } = await render(page);
const { steps, feature } = page.data;
const formulasPath = withSectionAnchor(
  localizedPath(STAGES_PAGE_SLUG, locale),
  COURSE_FORMULAS_SECTION_ID,
);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={PAGE_SLUG}
>
  <PageHero page={page.data} photoShape="landscape">
    <Instructions />
    {steps && (
      <div slot="details" class="gap-stack flex flex-col">
        <h2>
          <Eyebrow>{strings.stages.registrationStepsLabel}</Eyebrow>
        </h2>
        <StepList steps={steps} label={strings.stages.registrationStepsLabel} />
      </div>
    )}
    <LinkButton
      slot="actions"
      href={STAGES_REGISTRATION_URL}
      size="large"
      class="w-full md:w-auto"
    >
      {strings.stages.ticketOfficeButton}
    </LinkButton>
  </PageHero>

  <section class="py-section">
    <Container class="grid md:grid-cols-12">
      {feature && (
        <LinkCard
          href={formulasPath}
          title={feature.title}
          headingLevel="h2"
          class="md:col-span-7"
        >
          {feature.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </LinkCard>
      )}
    </Container>
  </section>
</BaseLayout>
