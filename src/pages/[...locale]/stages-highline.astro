---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import FaqSection from "../../components/sections/FaqSection.astro";
import CoursePicker from "../../components/sections/stages/CoursePicker.astro";
import StagesHero from "../../components/sections/stages/StagesHero.astro";
import StagesVideo from "../../components/sections/stages/StagesVideo.astro";
import TestimonialHighlights from "../../components/sections/TestimonialHighlights.astro";
import Container from "../../components/ui/Container.astro";
import SectionIntro from "../../components/ui/SectionIntro.astro";
import { getLocalizedCollection, getPageEntry } from "../../i18n/collections";
import { buildLocaleStaticPaths } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { COURSE_FORMULAS_SECTION_ID } from "../../lib/site";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const PAGE_SLUG = "stages-highline";
const FAQ_SECTION_ID = "faq";

const { locale } = Astro.props;
const strings = uiStrings(locale);
const page = await getPageEntry(PAGE_SLUG, locale);
const { Content: Intro } = await render(page);
const stages = await getLocalizedCollection("stages", locale);
const questions = await getLocalizedCollection("faq", locale);
const testimonials = await getLocalizedCollection("testimonials", locale);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={PAGE_SLUG}
>
  <StagesHero page={page.data} faqSectionId={FAQ_SECTION_ID} locale={locale}>
    <Intro />
  </StagesHero>

  <section id={COURSE_FORMULAS_SECTION_ID} class="scroll-mt-24 py-section">
    <Container class="gap-block flex flex-col">
      <div class="max-w-190">
        <SectionIntro
          title={strings.stages.formulasQuestion}
          eyebrow={strings.stages.formulasTitle}
        >
          <p class="text-graphite">{strings.stages.formulasIntro}</p>
        </SectionIntro>
      </div>
      <div class="gap-stack flex flex-col">
        <p class="text-graphite md:sr-only">{strings.stages.pickerHint}</p>
        <CoursePicker stages={stages} locale={locale} />
      </div>
    </Container>
  </section>

  {page.data.video && <StagesVideo video={page.data.video} locale={locale} />}

  <FaqSection
    id={FAQ_SECTION_ID}
    intro={strings.faq.stagesIntro}
    questions={questions}
    locale={locale}
  />

  <TestimonialHighlights testimonials={testimonials} locale={locale} />
</BaseLayout>
