---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import FaqSection from "../../components/sections/FaqSection.astro";
import StageDetails from "../../components/sections/StageDetails.astro";
import StageOverview from "../../components/sections/StageOverview.astro";
import TestimonialsSection from "../../components/sections/TestimonialsSection.astro";
import LinkButton from "../../components/ui/LinkButton.astro";
import Section from "../../components/ui/Section.astro";
import VideoEmbed from "../../components/ui/VideoEmbed.astro";
import { getLocalizedCollection, getPageEntry } from "../../i18n/collections";
import { buildLocaleStaticPaths, localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const PAGE_SLUG = "stages-highline";
const FAQ_SECTION_ID = "faq";

const { locale } = Astro.props;
const strings = uiStrings(locale);
const page = await getPageEntry(PAGE_SLUG, locale);
const { Content: Intro } = await render(page);
const stages = await getLocalizedCollection("stages", locale);
const questions = await getLocalizedCollection("faq", locale);
const testimonials = await getLocalizedCollection("testimonials", locale);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={PAGE_SLUG}
>
  <Section>
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div>
        <h1 class="page-title">{page.data.heading}</h1>
        <div class="rich-text mt-6 text-lg">
          <Intro />
        </div>
        <div class="mt-8">
          <LinkButton href={localizedPath("inscriptions", locale)}>
            {strings.stages.registrationsButton}
          </LinkButton>
        </div>
      </div>
      {page.data.video && (
        <VideoEmbed
          videoUrl={page.data.video}
          title={page.data.heading}
          locale={locale}
        />
      )}
    </div>
  </Section>

  <StageOverview stages={stages} locale={locale} />

  {stages.map((stage) => (
    <StageDetails stage={stage} locale={locale} />
  ))}

  <FaqSection
    id={FAQ_SECTION_ID}
    title={strings.faq.title}
    intro={strings.faq.stagesIntro}
    questions={questions}
  />

  <TestimonialsSection testimonials={testimonials} locale={locale} />
</BaseLayout>
