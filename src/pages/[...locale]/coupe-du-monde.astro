---
import "@fontsource-variable/inter";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import WorldCupAthletes from "../../components/sections/world-cup/WorldCupAthletes.astro";
import WorldCupEvent from "../../components/sections/world-cup/WorldCupEvent.astro";
import WorldCupFormat from "../../components/sections/world-cup/WorldCupFormat.astro";
import WorldCupHero from "../../components/sections/world-cup/WorldCupHero.astro";
import WorldCupOrganizers from "../../components/sections/world-cup/WorldCupOrganizers.astro";
import WorldCupPartners from "../../components/sections/world-cup/WorldCupPartners.astro";
import WorldCupPracticalInfo from "../../components/sections/world-cup/WorldCupPracticalInfo.astro";
import WorldCupProgramme from "../../components/sections/world-cup/WorldCupProgramme.astro";
import WorldCupQuestion from "../../components/sections/world-cup/WorldCupQuestion.astro";
import WorldCupResults from "../../components/sections/world-cup/WorldCupResults.astro";
import WorldCupSectionNav from "../../components/sections/world-cup/WorldCupSectionNav.astro";
import { getPageEntry, getSingleEntryContent } from "../../i18n/collections";
import { buildLocaleStaticPaths } from "../../i18n/routes";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const PAGE_SLUG = "coupe-du-monde";

const { locale } = Astro.props;
const page = await getPageEntry(PAGE_SLUG, locale);
const worldCup = (await getSingleEntryContent("worldCup", locale)).data;
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={PAGE_SLUG}
>
  <div class="font-cup text-cup-ink bg-cup-surface text-base leading-relaxed md:text-lg">
    <WorldCupSectionNav sectionNav={worldCup.sectionNav} />
    <WorldCupHero hero={worldCup.hero} />
    <WorldCupEvent event={worldCup.event} />
    <WorldCupPracticalInfo infos={worldCup.infos} />
    <WorldCupProgramme programme={worldCup.programme} />
    <WorldCupFormat format={worldCup.format} />
    <WorldCupAthletes athletes={worldCup.athletes} locale={locale} />
    <WorldCupResults results={worldCup.results} />
    <WorldCupOrganizers organizers={worldCup.organizers} locale={locale} />
    <WorldCupPartners partners={worldCup.partners} locale={locale} />
    <WorldCupQuestion question={worldCup.question} locale={locale} />
  </div>
</BaseLayout>
