---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import AssociationActivities from "../../components/sections/association/AssociationActivities.astro";
import AssociationDuo from "../../components/sections/association/AssociationDuo.astro";
import AssociationHero from "../../components/sections/association/AssociationHero.astro";
import AssociationTeam from "../../components/sections/association/AssociationTeam.astro";
import {
  getLocalizedCollection,
  getPageEntry,
  getSingleEntryContent,
} from "../../i18n/collections";
import { buildLocaleStaticPaths } from "../../i18n/routes";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const PAGE_SLUG = "association";

const { locale } = Astro.props;
const page = await getPageEntry(PAGE_SLUG, locale);
const { origin, activities, duo, team } = (
  await getSingleEntryContent("association", locale)
).data;
const teamMembers = await getLocalizedCollection("team", locale);
const duoMembers = teamMembers.filter((member) => member.data.group === "duo");
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={PAGE_SLUG}
  headerTone="dark"
>
  <AssociationHero heading={page.data.heading} origin={origin} />
  <AssociationActivities activities={activities} locale={locale} />
  <AssociationDuo duo={duo} members={duoMembers} locale={locale} />
  <AssociationTeam team={team} members={teamMembers} locale={locale} />
</BaseLayout>
