---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import LinkButton from "../../components/ui/LinkButton.astro";
import Section from "../../components/ui/Section.astro";
import { getPageEntry } from "../../i18n/collections";
import { buildLocaleStaticPaths, localizedPath } from "../../i18n/routes";
import { uiStrings } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  buildLocaleStaticPaths()) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const PAGE_SLUG = "merci";
const HOME_PAGE_SLUG = "";

const { locale } = Astro.props;
const strings = uiStrings(locale);
const page = await getPageEntry(PAGE_SLUG, locale);
const { Content } = await render(page);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  pageSlug={PAGE_SLUG}
>
  <Section>
    <h1 class="page-title">{page.data.heading}</h1>
    <div class="rich-text mt-6 max-w-2xl text-lg">
      <Content />
    </div>
    <div class="mt-8">
      <LinkButton href={localizedPath(HOME_PAGE_SLUG, locale)}>
        {strings.contactPage.backHomeButton}
      </LinkButton>
    </div>
  </Section>
</BaseLayout>
